      "settings": {
        "custom_liquid": "<style>\n  /* Nasconde il titolo pagina del template standard */\n  .main-page-title,\n  .main-page-title.page-title,\n  .title-wrapper-with-link,\n  .page-title {\n    display: none !important;\n  }\n\n  /* Full width breakout */\n  .dk-full-bleed{\n    width:100vw;\n    margin-left:calc(50% - 50vw);\n  }\n\n  .dk-garanzia-page{\n    --dk-bg:#f5f5f5;\n    --dk-surface:#f2eee7;\n    --dk-surface-2:#ffffff;\n    --dk-card-dark:#17171b;\n    --dk-gold:#c9a86a;\n    --dk-gold-2:#e2c58b;\n    --dk-border:rgba(201,168,106,.24);\n    --dk-text:#1a1a1a;\n    --dk-muted:#6f685d;\n    --dk-white:#ffffff;\n    --dk-shadow:0 18px 40px rgba(0,0,0,.10);\n    --dk-shadow-soft:0 8px 22px rgba(0,0,0,.08);\n    font-family:Arial, Helvetica, sans-serif;\n    color:var(--dk-text);\n    line-height:1.6;\n    padding:24px 24px 64px;\n    background:transparent;\n  }\n\n  .dk-garanzia-page *{\n    box-sizing:border-box;\n  }\n\n  .dk-garanzia-container{\n    max-width:1420px;\n    margin:0 auto;\n  }\n\n  .dk-garanzia-hero{\n    background:linear-gradient(135deg, #ebe8e1 0%, #f4f1ea 58%, #e8e3d8 100%);\n    border:1px solid rgba(201,168,106,.28);\n    border-radius:32px;\n    padding:52px 48px;\n    box-shadow:var(--dk-shadow);\n    position:relative;\n    overflow:hidden;\n    margin-bottom:24px;\n  }\n\n  .dk-garanzia-hero:before{\n    content:\"\";\n    position:absolute;\n    top:-120px;\n    right:-90px;\n    width:340px;\n    height:340px;\n    background:radial-gradient(circle, rgba(201,168,106,.18) 0%, rgba(201,168,106,0) 72%);\n    pointer-events:none;\n  }\n\n  .dk-eyebrow{\n    display:inline-block;\n    color:var(--dk-gold);\n    font-size:13px;\n    letter-spacing:.18em;\n    text-transform:uppercase;\n    font-weight:700;\n    margin-bottom:14px;\n  }\n\n  .dk-garanzia-hero h1{\n    margin:0 0 18px;\n    max-width:880px;\n    font-size:58px;\n    line-height:1.02;\n    color:#1d1d1f;\n    font-weight:800;\n    letter-spacing:-0.03em;\n  }\n\n  .dk-