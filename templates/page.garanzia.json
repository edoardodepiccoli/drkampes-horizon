 color:#f2eee7;\n    font-size:16px;\n    line-height:1.6;\n    display:block;\n  }\n\n  .dk-section-title{\n    margin:48px 0 14px;\n    font-size:36px;\n    line-height:1.12;\n    color:#1d1d1f;\n    font-weight:800;\n    letter-spacing:-0.02em;\n  }\n\n  .dk-section-text{\n    margin:0 0 10px;\n    color:#6f685d;\n    font-size:18px;\n  }\n\n  .dk-card{\n    background:#fff;\n    border:1px solid rgba(201,168,106,.18);\n    border-radius:24px;\n    padding:28px;\n    box-shadow:var(--dk-shadow-soft);\n  }\n\n  .dk-card h3{\n    margin:0 0 12px;\n    color:#1d1d1f;\n    font-size:24px;\n    line-height:1.15;\n  }\n\n  .dk-mini-title{\n    color:var(--dk-gold);\n    text-transform:uppercase;\n    letter-spacing:.10em;\n    font-size:12px;\n    font-weight:700;\n    margin-bottom:10px;\n  }\n\n  .dk-list{\n    margin:0;\n    padding-left:20px;\n    color:#5f594f;\n  }\n\n  .dk-list li{\n    margin:10px 0;\n  }\n\n  .dk-step-list{\n    display:grid;\n    gap:14px;\n    margin-top:16px;\n  }\n\n  .dk-step{\n    display:flex;\n    gap:14px;\n    align-items:flex-start;\n    padding:18px 20px;\n    background:#fff;\n    border:1px solid rgba(201,168,106,.18);\n    border-radius:18px;\n    box-shadow:var(--dk-shadow-soft);\n  }\n\n  .dk-step-num{\n    flex:0 0 42px;\n    width:42px;\n    height:42px;\n    border-radius:50%;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    background:linear-gradient(135deg, var(--dk-gold-2), var(--dk-gold));\n    color:#111;\n    font-weight:800;\n    font-size:15px;\n  }\n\n  .dk-step p{\n    margin:2px 0 0;\n    color:#6f685d;\n  }\n\n  .dk-note{\n    margin-top:28px;\n    padding:18px 20px;\n    border-radius:18px;\n    border:1px solid rgba(201,168,106,.22);\n    background:rgba(201,168,106,.10);\n    color:#6a6459;\n    font-size:15px;\n  }\n\n  .dk-faq{\n    display:grid;\n    gap:14px;\n    margin-top:18px;\n  }\n\n  .dk-faq details{\n    background:#fff;\n    border:1px solid rgba(201,168,106,.18);\n    border-radius:18px;\n    padding:18px 20px;\n    box-shadow:var(--dk-shadow-soft);\n  }\n\n  .dk-faq summary{\n    cursor:pointer;\n    list-style:none;\n    font-weight:700;\n    color:#1d1d1f;\n    position:relative;\n    padding-right:28px;\n  }\n\n  .dk-faq summary::-webkit-details-marker{\n    display:none;\n  }\n\n  .dk-faq summary:after{\n    content:\"+\";\n    position:absolute;\n    right:0;\n    top:0;\n    color:var(--dk-gold);\n    font-size:24px;\n    line-height:1;\n  }\n\n  .dk-faq details[open] summary:after{\n    content:\"−\";\n  }\n\n  .dk-faq p{\n    margin:12px 0 0;\n    color:#6f685d;\n  }\n\n  .dk-doc{\n    background:#fff;\n    border:1px solid rgba(201,168,106,.18);\n    border-radius:22px;\n    padding:26px;\n    display:flex;\n    flex-direction:column;\n    gap:14px;\n    box-shadow:var(--dk-shadow-soft);\n  }\n\n  .dk-doc h4{\n    margin:0;\n    font-size:21px;\n    line-height:1.15;\n    color:#1d1d1f;\n  }\n\n  .dk-doc p{\n    margin:0;\n    color:#6f685d;\n    font-size:15px;\n  }\n\n  @media (max-width: 1199px){\n    .dk-garanzia-container{\n      max-width:1180px;\n    }\n\n    .dk-garanzia-hero h1{\n      font-size:48px;\n    }\n\n    .dk-garanzia-hero p{\n      font-size:18px;\n    }\n  }\n\n  @media (max-width: 991px){\n    .dk-grid-4{\n      grid-template-columns:repeat(2, minmax(0, 1fr));\n    }\n\n    .dk-grid-2,\n    .dk-docs{\n      grid-template-columns:1fr 1fr;\n    }\n\n    .dk-garanzia-hero{\n      padding:38px 30px;\n    }\n\n    .dk-garanzia-hero h1{\n      font-size:40px;\n    }\n\n    .dk-section-title{\n      font-size:30px;\n    }\n\n    .dk-stat{\n      min-height:200px;\n    }\n  }\n\n  @media (max-width: 640px){\n    .dk-garanzia-page{\n      padding:18px 14px 42px;\n    }\n\n    .dk-garanzia-hero{\n      padding:28px 20px;\n      border-radius:24px;\n    }\n\n    .dk-garanzia-hero h1{\n      font-size:30px;\n      line-height:1.06;\n    }\n\n    .dk-garanzia-hero p{\n      font-size:16px;\n    }\n\n    .dk-grid-4,\n    .dk-grid-2,\n    .dk-docs{\n      grid-template-columns:1fr;\n    }\n\n    .dk-section-title{\n      font-size:26px;\n    }\n\n    .dk-card,\n    .dk-doc{\n      padding:20px;\n    }\n\n    .dk-hero-actions{\n      flex-direction:column;\n    }\n\n    .dk-btn{\n      width:100%;\n    }\n\n    .dk-stat{\n      min-height:auto;\n      padding:22px 18px;\n    }\n\n    .dk-stat strong{\n      font-size:24px;\n    }\n  }\n</style>\n\n<div class=\"dk-full-bleed\">\n  <section class=\"dk-garanzia-page\">\n    <div class=\"dk-garanzia-container\">\n\n      <div class=\"dk-garanzia-hero\">\n        <span class=\"dk-eyebrow\">Dr Kampes · Garanzia Ufficiale</span>\n        <h1>Garanzia 3 Anni Dr Kampes</h1>\n        <p>\n          Una copertura chiara, seria e documentata. Per i clienti consumatori:\n          <span class=\"dk-highlight\">24 mesi di garanzia legale + 12 mesi di garanzia commerciale aggiuntiva</span>.\n          Per aziende e professionisti si applicano condizioni dedicate. Tutti i dettagli sono indicati nella scheda ufficiale di garanzia.\n        </p>\n\n        <div class=\"dk-hero-actions\">\n          <a class=\"dk-btn dk-btn-primary\" href=\"https://cdn.shopify.com/s/files/1/0960/9527/3303/files/Scheda_Garanzia_3_Anni_Dr_Kampes_Unica_B2C_B2B.pdf?v=1774257878\" target=\"_blank\" rel=\"noopener noreferrer\">\n            Leggi la Scheda Garanzia\n          </a>\n          <a class=\"dk-btn dk-btn-secondary\" href=\"https://cdn.shopify.com/s/files/1/0960/9527/3303/files/Condizioni_di_Vendita_B2C_Dr_Kampes.pdf?v=1774257878\" target=\"_blank\" rel=\"noopener noreferrer\">\n            Condizioni B2C\n          </a>\n          <a class=\"dk-btn dk-btn-secondary\" href=\"https://cdn.shopify.com/s/files/1/0960/9527/3303/files/Condizioni_di_Fornitura_B2B_Campes_Srl.pdf?v=1774257878\" target=\"_blank\" rel=\"noopener noreferrer\">\n            Condizioni B2B\n          </a>\n        </div>\n      </div>\n\n      <div class=\"dk-grid-4\">\n        <div class=\"dk-stat\">\n          <strong>Fino a 36 mesi</strong>\n          <span>Copertura complessiva secondo le condizioni ufficiali Dr Kampes.</span>\n        </div>\n        <div class=\"dk-stat\">\n          <strong>B2C e B2B</strong>\n          <span>Una scheda unica con sezione dedicata per consumatori e professionisti.</span>\n        </div>\n        <div class=\"dk-stat\">\n          <strong>Prova d’acquisto</strong>\n          <span>Per aprire una pratica servono ordine, fattura o documento equivalente.</span>\n        </div>\n        <div class=\"dk-stat\">\n          <strong>Lotto prodotto</strong>\n          <span>Se presente, è richiesto per velocizzare la verifica tecnica.</span>\n        </div>\n      </div>\n\n      <h2 class=\"dk-section-title\">Chi è coperto</h2>\n      <p class=\"dk-section-text\">\n        La Garanzia 3 Anni Dr Kampes distingue in modo chiaro tra acquisti effettuati da <span class=\"dk-highlight\">clienti consumatori</span> e acquisti effettuati da <span class=\"dk-highlight\">aziende o professionisti</span>.\n        Questo permette di applicare il regime corretto in base al tipo di cliente e alla finalità dell’acquisto.\n      </p>\n\n      <div class=\"dk-grid-2\">\n        <div class=\"dk-card\">\n          <div class=\"dk-mini-title\">Sezione A</div>\n          <h3>Clienti consumatori (B2C)</h3>\n          <ul class=\"dk-list\">\n            <li><strong>24 mesi</strong> di garanzia legale di conformità.</li>\n            <li><strong>12 mesi aggiuntivi</strong> di garanzia commerciale Dr Kampes.</li>\n            <li>Copertura fino a <strong>36 mesi dalla consegna</strong>, alle condizioni della Scheda Garanzia.</li>\n            <li>Nel periodo commerciale, il rimedio principale è la <strong>riparazione</strong>; ove non praticabile, può essere previsto uno <strong>sconto del 20%</strong> sul nuovo acquisto.</li>\n          </ul>\n        </div>\n\n        <div class=\"dk-card\">\n          <div class=\"dk-mini-title\">Sezione B</div>\n          <h3>Aziende e professionisti (B2B)</h3>\n          <ul class=\"dk-list\">\n            <li><strong>12 mesi</strong> di garanzia per vizi secondo le condizioni B2B.</li>\n            <li><strong>24 mesi aggiuntivi</strong> di garanzia commerciale Dr Kampes.</li>\n            <li>Denuncia del vizio entro <strong>8 giorni dalla scoperta</strong>, come previsto dalle condizioni applicabili.</li>\n            <li>Nessun reso senza <strong>preventiva autorizzazione</strong> del venditore.</li>\n          </ul>\n        </div>\n      </div>\n\n      <h2 class=\"dk-section-title\">Cosa copre</h2>\n      <div class=\"dk-grid-2\">\n        <div class=\"dk-card\">\n          <h3>Casi coperti</h3>\n          <ul class=\"dk-list\">\n            <li>Difetti di conformità o vizi coperti dalle condizioni applicabili al cliente.</li>\n            <li>Cedimenti strutturali anomali non imputabili a uso improprio o usura normale.</li>\n            <li>Problemi verificabili tecnicamente tramite documentazione, foto e controllo prodotto.</li>\n            <li>Interventi di riparazione o altri rimedi nei limiti previsti dalla Scheda Garanzia.</li>\n          </ul>\n        </div>\n\n        <div class=\"dk-card\">\n          <h3>Principali esclusioni</h3>\n          <ul class=\"dk-list\">\n            <li>Usura fisiologica dovuta al normale utilizzo.</li>\n            <li>Uso improprio, non conforme o in ambienti/attività non previsti.</li>\n            <li>Mancata manutenzione, manomissioni o riparazioni non autorizzate.</li>\n            <li>Danni accidentali, urti, tagli, abrasioni, agenti esterni o trasporto non contestato correttamente.</li>\n          </ul>\n        </div>\n      </div>\n\n      <h2 class=\"dk-section-title\">Come aprire una pratica di garanzia</h2>\n      <p class=\"dk-section-text\">\n        Per permettere una verifica rapida e ordinata, Dr Kampes richiede sempre alcuni dati minimi e, se necessario, autorizza il rientro del prodotto con procedura dedicata.\n      </p>\n\n      <div class=\"dk-step-list\">\n        <div class=\"dk-step\">\n          <div class=\"dk-step-num\">1</div>\n          <div>\n            <strong>Prepara i riferimenti dell’acquisto</strong>\n            <p>Numero ordine, fattura oppure altro documento utile a dimostrare l’acquisto.</p>\n          </div>\n        </div>\n\n        <div class=\"dk-step\">\n          <div class=\"dk-step-num\">2</div>\n          <div>\n            <strong>Recupera il lotto del prodotto</strong>\n            <p>Se presente, il lotto aiuta a identificare il prodotto e a velocizzare la gestione della pratica.</p>\n          </div>\n        </div>\n\n        <div class=\"dk-step\">\n          <div class=\"dk-step-num\">3</div>\n          <div>\n            <strong>Documenta il problema</strong>\n            <p>Allega una descrizione chiara del difetto e fotografie dettagliate delle parti interessate.</p>\n          </div>\n        </div>\n\n        <div class=\"dk-step\">\n          <div class=\"dk-step-num\">4</div>\n          <div>\n            <strong>Attendi le istruzioni ufficiali</strong>\n            <p>Non inviare il prodotto senza autorizzazione: il reso deve essere prima approvato e gestito con le modalità indicate da Dr Kampes.</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"dk-note\">\n        <strong>Nota importante:</strong> se il prodotto presenta una sospetta perdita di idoneità rispetto alla sua funzione di sicurezza, interrompi immediatamente l’uso e contatta l’assistenza prima di continuare a utilizzarlo.\n      </div>\n\n      <h2 class=\"dk-section-title\">Domande frequenti</h2>\n      <div class=\"dk-faq\">\n        <details>\n          <summary>Le Dr Kampes hanno davvero 3 anni di garanzia?</summary>\n          <p>\n            Sì, Dr Kampes prevede una copertura fino a 3 anni secondo quanto indicato nella Scheda Garanzia ufficiale.\n            La struttura cambia in base al tipo di cliente: consumatore oppure azienda/professionista.\n          </p>\n        </details>\n\n        <details>\n          <summary>Nel terzo anno il prodotto viene sostituito automaticamente?</summary>\n          <p>\n            No. Nel periodo di garanzia commerciale il rimedio principale è la riparazione. Se la riparazione non è praticabile,\n            possono applicarsi gli altri rimedi previsti nella Scheda Garanzia, incluso in determinati casi uno sconto del 20% sul nuovo acquisto.\n          </p>\n        </details>\n\n        <details>\n          <summary>La garanzia vale anche per aziende e professionisti?</summary>\n          <p>\n            Sì, ma con condizioni specifiche B2B. Per i clienti professionali si applicano la Sezione B della Scheda Garanzia e le Condizioni di Fornitura B2B.\n          </p>\n        </details>\n\n        <details>\n          <summary>Posso spedire subito indietro il prodotto?</summary>\n          <p>\n            No. Nessun reso è accettato senza preventiva autorizzazione. Prima va aperta la pratica con la documentazione richiesta,\n            poi Dr Kampes comunica le istruzioni di rientro.\n          </p>\n        </details>\n\n        <details>\n          <summary>Quali documenti servono per aprire una pratica?</summary>\n          <p>\n            Servono prova d’acquisto, descrizione del problema, fotografie e, se presente, lotto del prodotto.\n            Questi elementi sono fondamentali per la corretta valutazione tecnica del caso.\n          </p>\n        </details>\n      </div>\n\n      <h2 class=\"dk-section-title\">Documenti ufficiali</h2>\n      <p class=\"dk-section-text\">\n        Qui trovi i documenti ufficiali di riferimento per garanzia e condizioni di vendita.\n      </p>\n\n      <div class=\"dk-docs\">\n        <div class=\"dk-doc\">\n          <h4>Scheda Garanzia 3 Anni</h4>\n          <p>Documento unico ufficiale con sezione dedicata B2C e sezione dedicata B2B.</p>\n          <a class=\"dk-btn dk-btn-primary\" href=\"https://cdn.shopify.com/s/files/1/0960/9527/3303/files/Scheda_Garanzia_3_Anni_Dr_Kampes_Unica_B2C_B2B.pdf?v=1774257878\" target=\"_blank\" rel=\"noopener noreferrer\">\n            Apri il documento\n          </a>\n        </div>\n\n        <div class=\"dk-doc\">\n          <h4>Condizioni di Vendita B2C</h4>\n          <p>Condizioni applicabili agli acquisti effettuati da clienti consumatori.</p>\n          <a class=\"dk-btn dk-btn-secondary\" href=\"https://cdn.shopify.com/s/files/1/0960/9527/3303/files/Condizioni_di_Vendita_B2C_Dr_Kampes.pdf?v=1774257878\" target=\"_blank\" rel=\"noopener noreferrer\">\n            Apri il PDF\n          </a>\n        </div>\n\n        <div class=\"dk-doc\">\n          <h4>Condizioni di Fornitura B2B</h4>\n          <p>Condizioni applicabili agli acquisti effettuati da aziende e professionisti.</p>\n          <a class=\"dk-btn dk-btn-secondary\" href=\"https://cdn.shopify.com/s/files/1/0960/9527/3303/files/Condizioni_di_Fornitura_B2B_Campes_Srl.pdf?v=1774257878\" target=\"_blank\" rel=\"noopener noreferrer\">\n            Apri il PDF\n          </a>\n        </div>\n      </div>\n\n    </div>\n  </section>\n</div>",
