{
  "sections": {
    "hero": {
      "type": "hero",
      "settings": {
        "color_scheme": "scheme-1",
        "content_position_desktop": "center center",
        "content_position_mobile": "center center",
        "content_max_width": 640,
        "full_width": true,
        "full_screen": true,
        "overlay_opacity": 30,
        "padding-block-start": 0,
        "padding-block-end": 0
      },
      "blocks": {
        "eyebrow": {
          "type": "text",
          "settings": {
            "text": "<p>Prodotto in evidenza</p>",
            "type_preset": "custom",
            "font": "var(--font-body--family)",
            "font_size": "0.875rem",
            "case": "uppercase",
            "letter_spacing": "0.1em",
            "alignment": "center",
            "color": "",
            "padding-block-start": 0,
            "padding-block-end": 8
          },
          "blocks": {}
        },
        "heading": {
          "type": "text",
          "settings": {
            "text": "<h1>Il titolo della tua offerta irresistibile</h1>",
            "type_preset": "h1",
            "font": "var(--font-primary--family)",
            "alignment": "center",
            "wrap": "pretty",
            "color": "",
            "padding-block-start": 0,
            "padding-block-end": 16
          },
          "blocks": {}
        },
        "subheading": {
          "type": "text",
          "settings": {
            "text": "<p>Una frase che spiega il beneficio principale del prodotto e convince il visitatore a continuare a leggere.</p>",
            "type_preset": "custom",
            "font": "var(--font-body--family)",
            "font_size": "1.125rem",
            "alignment": "center",
            "max_width": "narrow",
            "wrap": "pretty",
            "color": "",
            "padding-block-start": 0,
            "padding-block-end": 32
          },
          "blocks": {}
        },
        "cta": {
          "type": "button",
          "settings": {
            "label": "Scopri il prodotto",
            "link": "#product",
            "style_class": "button",
            "alignment": "center",
            "padding-block-start": 0,
            "padding-block-end": 0
          },
          "blocks": {}
        }
      },
      "block_order": ["eyebrow", "heading", "subheading", "cta"]
    },
    "product-main": {
      "type": "featured-product-information",
      "settings": {
        "content_width": "content-center-aligned",
        "desktop_media_position": "left",
        "equal_columns": false,
        "limit_details_width": false,
        "gap": 48,
        "enable_sticky_add_to_cart": true,
        "color_scheme": "",
        "padding-block-start": 60,
        "padding-block-end": 60
      },
      "blocks": {
        "media-gallery": {
          "type": "_featured-product-information-carousel",
          "static": true,
          "settings": {
            "media_presentation": "carousel",
            "media_columns": "one",
            "image_gap": 4,
            "large_first_image": true,
            "icons_style": "chevron_large",
            "slideshow_controls_style": "thumbnails",
            "slideshow_mobile_controls_style": "hint",
            "thumbnail_position": "right",
            "thumbnail_width": 72,
            "thumbnail_radius": 0,
            "aspect_ratio": "adapt",
            "constrain_to_viewport": true,
            "media_fit": "contain",
            "media_radius": 0,
            "zoom": true,
            "video_loop": true,
            "hide_variants": true,
            "padding-block-start": 24,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "product-details": {
          "type": "_product-details",
          "static": true,
          "settings": {
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "details_position": "flex-start",
            "gap": 28,
            "sticky_details_desktop": true,
            "inherit_color_scheme": true,
            "color_scheme": "scheme-1",
            "background_media": "none",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 24,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "title": {
              "type": "text",
              "name": "Titolo prodotto",
              "settings": {
                "text": "<h2>{{ closest.product.title }}</h2>",
                "type_preset": "h3",
                "font": "var(--font-primary--family)",
                "alignment": "left",
                "wrap": "pretty",
                "color": "",
                "padding-block-start": 0,
                "padding-block-end": 8
              },
              "blocks": {}
            },
            "price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": false,
                "type_preset": "",
                "alignment": "left",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "color": "var(--color-foreground)",
                "padding-block-start": 0,
                "padding-block-end": 0
              },
              "blocks": {}
            },
            "divider": {
              "type": "_divider",
              "settings": {
                "thickness": 1,
                "corner_radius": "square",
                "width_percent": 100,
                "padding-block-start": 4,
                "padding-block-end": 4
              },
              "blocks": {}
            },
            "variant-picker": {
              "type": "variant-picker",
              "settings": {
                "variant_style": "buttons",
                "show_swatches": false,
                "alignment": "left",
                "padding-block-start": 0,
                "padding-block-end": 0
              },
              "blocks": {}
            },
            "buy-buttons": {
              "type": "buy-buttons",
              "settings": {
                "stacking": true,
                "show_pickup_availability": false,
                "gift_card_form": false,
                "padding-block-start": 0,
                "padding-block-end": 0
              },
              "blocks": {
                "quantity": {
                  "type": "quantity",
                  "static": true,
                  "settings": {},
                  "blocks": {}
                },
                "add-to-cart": {
                  "type": "add-to-cart",
                  "static": true,
                  "settings": {
                    "style_class": "button"
                  },
                  "blocks": {}
                },
                "accelerated-checkout": {
                  "type": "accelerated-checkout",
                  "static": true,
                  "settings": {},
                  "blocks": {}
                }
              },
              "block_order": []
            },
            "description": {
              "type": "text",
              "name": "Descrizione prodotto",
              "settings": {
                "text": "{{ closest.product.description }}",
                "type_preset": "rte",
                "font": "var(--font-primary--family)",
                "alignment": "left",
                "wrap": "pretty",
                "color": "",
                "padding-block-start": 8,
                "padding-block-end": 0
              },
              "blocks": {}
            }
          },
          "block_order": ["title", "price", "divider", "variant-picker", "buy-buttons", "description"]
        }
      },
      "block_order": ["media-gallery", "product-details"]
    },
    "benefit-1": {
      "type": "media-with-content",
      "settings": {
        "color_scheme": "",
        "media_position": "left",
        "padding-block-start": 60,
        "padding-block-end": 60
      },
      "blocks": {
        "eyebrow-1": {
          "type": "text",
          "settings": {
            "text": "<p>Beneficio 01</p>",
            "type_preset": "custom",
            "font": "var(--font-body--family)",
            "font_size": "0.875rem",
            "case": "uppercase",
            "letter_spacing": "0.1em",
            "color": "",
            "padding-block-start": 0,
            "padding-block-end": 8
          },
          "blocks": {}
        },
        "heading-1": {
          "type": "text",
          "settings": {
            "text": "<h2>Il primo grande vantaggio del prodotto</h2>",
            "type_preset": "h3",
            "font": "var(--font-primary--family)",
            "wrap": "pretty",
            "color": "",
            "padding-block-start": 0,
            "padding-block-end": 16
          },
          "blocks": {}
        },
        "text-1": {
          "type": "text",
          "settings": {
            "text": "<p>Descrivi in modo chiaro e convincente questo beneficio. Parla al cliente in prima persona e focalizzati su come migliora la sua vita, non sulle caratteristiche tecniche.</p>",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
            "color": "",
            "padding-block-start": 0,
            "padding-block-end": 0
          },
          "blocks": {}
        }
      },
      "block_order": ["eyebrow-1", "heading-1", "text-1"]
    },
    "benefit-2": {
      "type": "media-with-content",
      "settings": {
        "color_scheme": "scheme-1",
        "media_position": "right",
        "padding-block-start": 60,
        "padding-block-end": 60
      },
      "blocks": {
        "eyebrow-2": {
          "type": "text",
          "settings": {
            "text": "<p>Beneficio 02</p>",
            "type_preset": "custom",
            "font": "var(--font-body--family)",
            "font_size": "0.875rem",
            "case": "uppercase",
            "letter_spacing": "0.1em",
            "color": "",
            "padding-block-start": 0,
            "padding-block-end": 8
          },
          "blocks": {}
        },
        "heading-2": {
          "type": "text",
          "settings": {
            "text": "<h2>Il secondo grande vantaggio del prodotto</h2>",
            "type_preset": "h3",
            "font": "var(--font-primary--family)",
            "wrap": "pretty",
            "color": "",
            "padding-block-start": 0,
            "padding-block-end": 16
          },
          "blocks": {}
        },
        "text-2": {
          "type": "text",
          "settings": {
            "text": "<p>Descrivi in modo chiaro e convincente questo beneficio. Parla al cliente in prima persona e focalizzati su come migliora la sua vita, non sulle caratteristiche tecniche.</p>",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
            "color": "",
            "padding-block-start": 0,
            "padding-block-end": 0
          },
          "blocks": {}
        }
      },
      "block_order": ["eyebrow-2", "heading-2", "text-2"]
    },
    "trust-bar": {
      "type": "marquee",
      "settings": {
        "color_scheme": "scheme-2",
        "speed": 40,
        "pause_on_hover": true,
        "padding-block-start": 20,
        "padding-block-end": 20
      },
      "blocks": {
        "trust-1": {
          "type": "text",
          "settings": {
            "text": "Spedizione gratuita"
          },
          "blocks": {}
        },
        "trust-2": {
          "type": "text",
          "settings": {
            "text": "Soddisfatti o rimborsati"
          },
          "blocks": {}
        },
        "trust-3": {
          "type": "text",
          "settings": {
            "text": "Made in Italy"
          },
          "blocks": {}
        },
        "trust-4": {
          "type": "text",
          "settings": {
            "text": "Pagamento sicuro"
          },
          "blocks": {}
        },
        "trust-5": {
          "type": "text",
          "settings": {
            "text": "Assistenza clienti"
          },
          "blocks": {}
        }
      },
      "block_order": ["trust-1", "trust-2", "trust-3", "trust-4", "trust-5"]
    },
    "cta-bottom": {
      "type": "section",
      "settings": {
        "content_direction": "column",
        "horizontal_alignment": "center",
        "horizontal_alignment_flex_direction_column": "center",
        "gap": 24,
        "color_scheme": "scheme-3",
        "padding-block-start": 80,
        "padding-block-end": 80
      },
      "blocks": {
        "cta-heading": {
          "type": "text",
          "settings": {
            "text": "<h2>Pronto a fare il passo decisivo?</h2>",
            "type_preset": "h2",
            "font": "var(--font-primary--family)",
            "alignment": "center",
            "wrap": "pretty",
            "color": "",
            "padding-block-start": 0,
            "padding-block-end": 0
          },
          "blocks": {}
        },
        "cta-text": {
          "type": "text",
          "settings": {
            "text": "<p>Unisciti a migliaia di clienti soddisfatti. Ordina oggi e ricevi in 48 ore.</p>",
            "type_preset": "custom",
            "font": "var(--font-body--family)",
            "font_size": "1.125rem",
            "alignment": "center",
            "max_width": "narrow",
            "wrap": "pretty",
            "color": "",
            "padding-block-start": 0,
            "padding-block-end": 0
          },
          "blocks": {}
        },
        "cta-button": {
          "type": "button",
          "settings": {
            "label": "Acquista ora",
            "link": "#product",
            "style_class": "button",
            "alignment": "center",
            "padding-block-start": 0,
            "padding-block-end": 0
          },
          "blocks": {}
        }
      },
      "block_order": ["cta-heading", "cta-text", "cta-button"]
    }
  },
  "order": [
    "hero",
    "product-main",
    "benefit-1",
    "benefit-2",
    "trust-bar",
    "cta-bottom"
  ]
}
