ground:#fbfaf7;\n    border:1px solid rgba(201,168,106,.18);\n    color:#2d2924;\n    font-size:16px;\n  }\n\n  .dk-hours-row strong{\n    color:#1d1d1f;\n  }\n\n  .dk-map-card{\n    background:#fff;\n    border:1px solid rgba(201,168,106,.18);\n    border-radius:24px;\n    padding:18px;\n    box-shadow:var(--dk-shadow-soft);\n    overflow:hidden;\n  }\n\n  .dk-map-frame{\n    width:100%;\n    height:100%;\n    min-height:420px;\n    border:0;\n    border-radius:18px;\n    display:block;\n  }\n\n  .dk-form-wrap{\n    background:#fff;\n    border:1px solid rgba(201,168,106,.18);\n    border-radius:24px;\n    padding:28px;\n    box-shadow:var(--dk-shadow-soft);\n  }\n\n  .dk-form-wrap h2{\n    margin:0 0 12px;\n    font-size:30px;\n    line-height:1.1;\n    color:#1d1d1f;\n  }\n\n  .dk-form-wrap p{\n    margin:0 0 20px;\n    color:#6f685d;\n    font-size:17px;\n  }\n\n  .dk-form-grid{\n    display:grid;\n    grid-template-columns:repeat(2, minmax(0, 1fr));\n    gap:16px;\n  }\n\n  .dk-field{\n    display:flex;\n    flex-direction:column;\n    gap:8px;\n  }\n\n  .dk-field-full{\n    grid-column:1 / -1;\n  }\n\n  .dk-field label{\n    font-size:14px;\n    font-weight:700;\n    color:#2f2a24;\n  }\n\n  .dk-field input,\n  .dk-field textarea{\n    width:100%;\n    border:1px solid rgba(201,168,106,.30);\n    background:#fcfbf8;\n    color:#1d1d1f;\n    border-radius:16px;\n    padding:15px 16px;\n    font-size:16px;\n    outline:none;\n    transition:border-color .2s ease, box-shadow .2s ease;\n  }\n\n  .dk-field input:focus,\n  .dk-field textarea:focus{\n    border-color:var(--dk-gold);\n    box-shadow:0 0 0 3px rgba(201,168,106,.14);\n  }\n\n  .dk-field textarea{\n    min-height:180px;\n    resize:vertical;\n  }\n\n  .dk-submit{\n    margin-top:18px;\n  }\n\n  .dk-alert{\n    padding:14px 16px;\n    border-radius:14px;\n    margin-bottom:16px;\n    font-size:15px;\n  }\n\n  .dk-alert-success{\n    background:rgba(92, 163, 99, 0.12);\n    border:1px solid rgba(92, 163, 9