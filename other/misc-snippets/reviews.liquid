  document.addEventListener('DOMContentLoaded', function () {
    var container = document.getElementById('gr-marquee-container');
    var isMobile  = window.innerWidth <= 768;
    var numRows   = isMobile ? 3 : 2;
    var chunkSize = Math.ceil(reviewsData.length / numRows);

    function buildChunk(arr) {
      var cardsHtml = arr.map(function(r) {
        return '<div class="gr-card">'
          + '<div class="gr-stars">★★★★★</div>'
          + '<div class="gr-name">' + r.name + '</div>'
          + '<div class="gr-text">' + r.text + '</div>'
          + '</div>';
      }).join('');
      return '<div class="gr-chunk">' + cardsHtml + '</div>';
    }

    for (var i = 0; i < numRows; i++) {
      var chunkData = reviewsData.slice(i * chunkSize, (i + 1) * chunkSize);
      var track = document.createElement('div');
      var isReverse = i % 2 !== 0;
      track.className = 'gr-track ' + (isReverse ? 'slide-right' : 'slide-left');
      var singleChunk = buildChunk(chunkData);
      track.innerHTML = singleChunk + singleChunk + singleChunk + singleChunk;
      container.appendChild(track);
    }
  });
</script>