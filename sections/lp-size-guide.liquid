{%- comment -%}
  lp-size-guide.liquid
  Light section: eyebrow → H2 → central illustration → 4 numbered step cards → optional CTA.
  CSS tokens: var(--lp-*) only. No hardcoded colors/sizes.
{%- endcomment -%}

<section class="lp-size-guide">
  <div class="lp-size-guide__inner">

    {%- if section.settings.eyebrow != blank -%}
      <span class="lp-size-guide__eyebrow lp-sec__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    <h2 class="lp-size-guide__heading lp-sec__h2">{{ section.settings.heading }}</h2>

    <figure class="lp-size-guide__illustration">
      {%- if section.settings.illustration_image != blank -%}
        {{ section.settings.illustration_image | image_url: width: 1200 | image_tag:
            class: 'lp-size-guide__illustration-img',
            loading: 'lazy',
            widths: '600,900,1200',
            sizes: '(min-width:750px) 720px, 100vw',
            alt: section.settings.illustration_image.alt | default: '' }}
      {%- else -%}
        <div class="lp-size-guide__illustration-placeholder">Carica illustrazione (scarpa + soletta + righello)</div>
      {%- endif -%}
      {%- if section.settings.illustration_caption != blank -%}
        <figcaption class="lp-size-guide__illustration-caption">{{ section.settings.illustration_caption }}</figcaption>
      {%- endif -%}
    </figure>

    {%- if section.blocks.size > 0 -%}
      <ol class="lp-size-guide__steps">
        {%- for block in section.blocks -%}
          <li class="lp-step" {{ block.shopify_attributes }}>
            <span class="lp-step__number" aria-hidden="true">{{ block.settings.number }}</span>
            <div class="lp-step__icon">
              {%- if block.settings.icon_image != blank -%}
                {{ block.settings.icon_image | image_url: width: 160 | image_tag:
                    class: 'lp-step__icon-img',
                    loading: 'lazy',
                    widths: '80,120,160',
                    alt: '' }}
              {%- else -%}
                <span class="lp-step__icon-placeholder">Icona step</span>
              {%- endif -%}
            </div>
            <h3 class="lp-step__title">{{ block.settings.title }}</h3>
            <p class="lp-step__text">{{ block.settings.text }}</p>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <a class="lp-cta lp-size-guide__cta" href="{{ section.settings.cta_url | default: '#acquista' }}">
        {{ section.settings.cta_label }}
      </a>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}

/* ============================================================================
   lp-size-guide — Size Guide Section (light surface)
   Tokens: var(--lp-*) only. No hardcoded values.
   ============================================================================ */

.lp-size-guide {
  background: var(--lp-color-surface-light);
  color: var(--lp-color-text-on-light);
  padding: var(--lp-section-pad-y) var(--lp-section-pad-x);
  font-family: var(--lp-font-body);
}

.lp-size-guide__inner {
  max-width: var(--lp-section-max-width);
  margin: 0 auto;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Eyebrow — outlined chip badge with gold border, overrides shared class green */
.lp-size-guide__eyebrow.lp-sec__eyebrow {
  display: inline-block;
  text-align: center;
  border: 2px solid var(--lp-color-gold);
  padding: var(--lp-space-1) var(--lp-space-4);
  margin-bottom: var(--lp-space-4);
  color: var(--lp-color-gold);
}

/* H2 — inherits shared .lp-sec__h2 styles */
.lp-size-guide__heading {
  text-align: center;
  margin-bottom: var(--lp-space-6);
  color: var(--lp-color-text-on-light);
}

/* ----------------------------------------------------------------------------
   Illustration
   ---------------------------------------------------------------------------- */
.lp-size-guide__illustration {
  margin: 0 0 var(--lp-space-7);
  padding: 0;
  text-align: center;
  width: 100%;
}

.lp-size-guide__illustration-img {
  display: block;
  width: 100%;
  max-width: 420px;
  margin: 0 auto;
  object-fit: contain;
}

.lp-size-guide__illustration-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: 420px;
  margin: 0 auto;
  aspect-ratio: 4 / 3;
  border: 2px dashed var(--lp-color-divider-light-strong);
  padding: var(--lp-space-9);
  font-size: var(--lp-fs-xs);
  color: var(--lp-color-text-on-light-faint);
  font-family: var(--lp-font-body);
  text-align: center;
}

.lp-size-guide__illustration-caption {
  display: block;
  font-family: var(--lp-font-display);
  font-size: var(--lp-fs-eyebrow);
  font-weight: var(--lp-fw-black);
  letter-spacing: var(--lp-ls-widest);
  text-transform: uppercase;
  color: var(--lp-color-gold);
  text-align: center;
  margin-top: var(--lp-space-3);
  padding-top: var(--lp-space-3);
  border-top: 2px solid var(--lp-color-gold);
  width: 40%;
  margin-left: auto;
  margin-right: auto;
}

/* ----------------------------------------------------------------------------
   Step cards grid — 2×2 mobile, 4-col desktop
   ---------------------------------------------------------------------------- */
.lp-size-guide__steps {
  list-style: none;
  margin: 0 0 0;
  padding: 0;
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--lp-space-4);
}

/* ----------------------------------------------------------------------------
   Individual step card — centered column layout
   ---------------------------------------------------------------------------- */
.lp-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: var(--lp-space-3);
  background: var(--lp-color-surface-card);
  padding: var(--lp-space-5) var(--lp-space-4);
  box-shadow: var(--lp-shadow-card);
  border-radius: var(--lp-radius-none);
}

/* Gold numbered circle — top of card */
.lp-step__number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  min-width: 36px;
  border-radius: var(--lp-radius-circle);
  background: var(--lp-color-gold);
  color: var(--lp-color-white);
  font-family: var(--lp-font-display);
  font-size: var(--lp-fs-md);
  font-weight: var(--lp-fw-black);
  line-height: 1;
  flex-shrink: 0;
}

/* Icon area — centered, taller */
.lp-step__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72px;
  height: 72px;
  flex-shrink: 0;
}

.lp-step__icon-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

.lp-step__icon-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: var(--lp-fs-micro);
  color: var(--lp-color-text-on-light-faint);
  border: 1px dashed var(--lp-color-divider-light-strong);
  text-align: center;
}

/* Step title */
.lp-step__title {
  font-family: var(--lp-font-display);
  font-size: var(--lp-fs-xs);
  font-weight: var(--lp-fw-black);
  letter-spacing: var(--lp-ls-wide);
  text-transform: uppercase;
  color: var(--lp-color-text-on-light);
  line-height: var(--lp-lh-snug);
  margin: 0;
}

/* Step body text */
.lp-step__text {
  font-family: var(--lp-font-body);
  font-size: var(--lp-fs-xs);
  color: var(--lp-color-text-on-light-mute);
  line-height: var(--lp-lh-base);
  margin: 0;
}

/* Optional CTA */
.lp-size-guide__cta {
  margin-top: var(--lp-space-7);
  width: 100%;
}

/* ============================================================================
   DESKTOP (≥750px)
   ============================================================================ */
@media (min-width: 750px) {

  .lp-size-guide__inner {
    max-width: var(--lp-section-max-width-md);
  }

  .lp-size-guide__illustration-img {
    max-width: 540px;
  }

  .lp-size-guide__illustration-placeholder {
    max-width: 540px;
  }

  /* 4-col grid on desktop */
  .lp-size-guide__steps {
    grid-template-columns: repeat(4, 1fr);
  }

  /* Larger number circle */
  .lp-step__number {
    width: 44px;
    height: 44px;
    min-width: 44px;
    font-size: var(--lp-fs-lg);
  }

  /* Larger icon on desktop */
  .lp-step__icon {
    width: 90px;
    height: 90px;
  }

  /* Slightly larger title on desktop */
  .lp-step__title {
    font-size: var(--lp-fs-sm);
  }

}

{% endstylesheet %}

