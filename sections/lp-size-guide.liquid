<section class="lp-sg">
  <div class="lp-sg__inner">

    {%- if section.settings.eyebrow != blank -%}
      <p class="lp-sg__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="lp-sg__h2">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.hero_image_url != blank -%}
      <figure class="lp-sg__hero">
        <div class="lp-sg__hero-img">
          <img src="{{ section.settings.hero_image_url }}" alt="{{ section.settings.hero_caption | escape }}" loading="lazy">
        </div>
        {%- if section.settings.hero_caption != blank -%}
          <figcaption class="lp-sg__hero-cap">{{ section.settings.hero_caption }}</figcaption>
        {%- endif -%}
      </figure>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ol class="lp-sg__steps">
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            <li class="lp-sg__step" {{ block.shopify_attributes }}>
              <div class="lp-sg__step-head">
                <span class="lp-sg__step-num" aria-hidden="true">{{ forloop.index }}</span>
                <h3 class="lp-sg__step-title">{{ block.settings.title }}</h3>
              </div>
              {%- if block.settings.text != blank -%}
                <p class="lp-sg__step-text">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- if block.settings.image_url != blank -%}
                <div class="lp-sg__step-img">
                  <img src="{{ block.settings.image_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
                </div>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}

.lp-sg {
  --sg-gold: #D4A017;
  --sg-gold-light: #F5C200;
  background: #fff;
  color: #111;
  padding: 32px 0 40px;
}

.lp-sg__inner {
  max-width: 720px;
  margin: 0 auto;
  padding: 0 18px;
}

.lp-sg__eyebrow {
  font-family: 'Inter', sans-serif;
  font-weight: 800;
  color: var(--sg-gold);
  font-size: 0.72rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  line-height: 1.2;
  margin: 0 0 10px;
}

.lp-sg__h2 {
  font-family: 'Archivo Black', 'Inter', sans-serif;
  font-size: 1.8rem;
  font-weight: 900;
  line-height: 1.05;
  letter-spacing: -0.005em;
  color: #111;
  text-transform: uppercase;
  margin: 0 0 22px;
}

.lp-sg__hero {
  margin: 0 0 28px;
  text-align: center;
}

.lp-sg__hero-img {
  position: relative;
  display: block;
  width: 100%;
  max-width: 520px;
  margin: 0 auto;
}
.lp-sg__hero-img img {
  display: block;
  width: 100%;
  height: auto;
  mix-blend-mode: multiply;
}

.lp-sg__hero-cap {
  display: block;
  margin-top: 8px;
  font-family: 'Inter', sans-serif;
  font-weight: 900;
  color: var(--sg-gold);
  font-size: 0.78rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.lp-sg__steps {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 18px;
  row-gap: 32px;
}

.lp-sg__step {
  display: flex;
  flex-direction: column;
  gap: 12px;
  text-align: center;
}

.lp-sg__step-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.lp-sg__step-num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--sg-gold);
  color: #1a1a1a;
  font-family: 'Archivo Black', 'Inter', sans-serif;
  font-size: 1rem;
  font-weight: 900;
  line-height: 1;
  box-shadow:
    inset 0 1px 0 rgba(255,220,130,0.55),
    inset 0 -1px 0 rgba(120,75,0,0.22),
    0 2px 6px rgba(0,0,0,0.12);
}

.lp-sg__step-title {
  font-family: 'Archivo Black', 'Inter', sans-serif;
  font-size: 0.95rem;
  font-weight: 900;
  line-height: 1.15;
  letter-spacing: 0;
  color: #111;
  text-transform: uppercase;
  margin: 0;
}

.lp-sg__step-text {
  font-family: 'Inter', sans-serif;
  font-size: 0.82rem;
  line-height: 1.45;
  color: #555;
  margin: 0;
}

.lp-sg__step-img {
  margin-top: 4px;
  background: #fafafa;
  border: 1px solid rgba(0,0,0,0.08);
  border-radius: 8px;
  padding: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 4 / 3;
}
.lp-sg__step-img img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  mix-blend-mode: multiply;
}

@media (min-width: 750px) {
  .lp-sg { padding: 64px 0 80px; }
  .lp-sg__inner { padding: 0 32px; }
  .lp-sg__eyebrow { font-size: 0.82rem; margin-bottom: 14px; }
  .lp-sg__h2 { font-size: 2.6rem; margin-bottom: 32px; }
  .lp-sg__hero { margin-bottom: 44px; }
  .lp-sg__hero-cap { font-size: 0.92rem; margin-top: 12px; }
  .lp-sg__steps { column-gap: 40px; row-gap: 48px; }
  .lp-sg__step-num { width: 38px; height: 38px; font-size: 1.15rem; }
  .lp-sg__step-title { font-size: 1.15rem; }
  .lp-sg__step-text { font-size: 0.95rem; }
  .lp-sg__step-img { padding: 22px; }
}

{% endstylesheet %}

{% schema %}
{
  "name": "LP — Size Guide",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "IL CONSIGLIO DEL DR. KAMPES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "TROVA LA TUA TAGLIA PERFETTA"
    },
    {
      "type": "text",
      "id": "hero_image_url",
      "label": "URL immagine soletta hero"
    },
    {
      "type": "text",
      "id": "hero_caption",
      "label": "Caption sotto immagine hero",
      "default": "LUNGHEZZA INTERNA"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Passo",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titolo passo"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Testo passo"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "URL immagine"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP — Size Guide",
      "blocks": [
        { "type": "step", "settings": { "title": "PRENDI UNA SOLETTA INTERNA", "text": "Rimuovi la soletta interna di una scarpa che usi abitualmente." }},
        { "type": "step", "settings": { "title": "MISURA LA LUNGHEZZA", "text": "Misura la lunghezza della soletta da punta a tallone come indicato." }},
        { "type": "step", "settings": { "title": "TROVA LA TUA TAGLIA IN TABELLA", "text": "Usa la lunghezza in cm per trovare la tua taglia nella tabella qui sotto." }},
        { "type": "step", "settings": { "title": "SCEGLI LA TUA TAGLIA PERFETTA", "text": "Scegli la taglia che corrisponde alla tua misura per il massimo comfort." }}
      ]
    }
  ]
}
{% endschema %}
