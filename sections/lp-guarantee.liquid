{%- assign craft_img = section.settings.craft_image -%}

<section class="lp-guarantee">
  <div class="lp-guarantee__inner">

    {%- if section.settings.eyebrow != blank -%}
      <div class="lp-sec__eyebrow lp-guarantee__eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}

    <h2 class="lp-sec__h2 lp-guarantee__h2">{{ section.settings.heading }}</h2>

    {%- if section.settings.intro != blank -%}
      <div class="lp-guarantee__intro">{{ section.settings.intro }}</div>
    {%- endif -%}

    <div class="lp-guarantee__badge">
      <div class="lp-guarantee__badge-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>
        </svg>
      </div>
      <div>
        <div class="lp-guarantee__badge-title">{{ section.settings.badge_title | default: 'Garanzia Ufficiale e Scritta di 3 Anni' }}</div>
        <div class="lp-guarantee__badge-sub">{{ section.settings.badge_sub | default: 'Valutazione, riparazione o sostituzione gratis. Zero asterischi.' }}</div>
      </div>
    </div>

    <h3 class="lp-guarantee__math-title">{{ section.settings.math_title | default: 'Fai la matematica.' }}</h3>

    <table class="lp-math-table">
      <thead>
        <tr>
          <th>Prodotto</th>
          <th>Costo</th>
          <th>Durata</th>
          <th>In 3 anni</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>{{ section.settings.row1_product | default: 'Scarpe generiche' }}</td>
          <td class="lp-math-lose">{{ section.settings.row1_cost | default: '€90' }}</td>
          <td>{{ section.settings.row1_duration | default: '~6 mesi' }}</td>
          <td class="lp-math-lose">{{ section.settings.row1_total | default: '€540 sprecati' }}</td>
        </tr>
        <tr>
          <td><strong>{{ section.settings.row2_product | default: 'Dr Kampes' }}</strong></td>
          <td class="lp-math-win">{{ section.settings.row2_cost | default: '€189' }}</td>
          <td>{{ section.settings.row2_duration | default: '3+ anni' }}</td>
          <td class="lp-math-win">{{ section.settings.row2_total | default: '€189 — punto.' }}</td>
        </tr>
      </tbody>
    </table>

    {%- if section.settings.math_callout != blank -%}
      <div class="lp-math-callout">{{ section.settings.math_callout }}</div>
    {%- endif -%}

    {%- if craft_img != blank -%}
      <div class="lp-guarantee__img-wrap">
        {{ craft_img | image_url: width: 800 | image_tag: class: 'lp-guarantee__img', loading: 'lazy', widths: '400,600,800', sizes: '(min-width:750px) 680px, 90vw', alt: craft_img.alt }}
      </div>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}

.lp-guarantee {
  padding: 56px 22px;
  background: #fff;
}

.lp-guarantee__inner {
  max-width: 680px;
}

.lp-guarantee__eyebrow {
  color: #2e7d32;
}

.lp-guarantee__h2 {
  margin-bottom: 18px;
}

.lp-guarantee__intro {
  font-size: 0.97rem;
  color: #444;
  line-height: 1.8;
  margin-bottom: 22px;
}

.lp-guarantee__intro p { margin: 0 0 14px; }
.lp-guarantee__intro p:last-child { margin-bottom: 0; }
.lp-guarantee__intro strong { color: #111; }

.lp-guarantee__badge {
  display: flex;
  align-items: center;
  gap: 14px;
  background: #e8f5e9;
  border: 2px solid #2e7d32;
  border-radius: 0;
  padding: 16px 18px;
  margin-bottom: 22px;
}

.lp-guarantee__badge-icon {
  width: 46px;
  height: 46px;
  flex-shrink: 0;
  background: #2e7d32;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lp-guarantee__badge-icon svg {
  width: 24px;
  height: 24px;
  stroke: #fff;
}

.lp-guarantee__badge-title {
  font-size: 0.85rem;
  font-weight: 900;
  color: #2e7d32;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  line-height: 1.3;
}

.lp-guarantee__badge-sub {
  font-size: 0.73rem;
  color: #2e7d32;
  opacity: 0.8;
  margin-top: 2px;
}

.lp-guarantee__math-title {
  font-size: 0.97rem;
  font-weight: 800;
  margin: 0 0 12px;
  color: #111;
}

.lp-math-table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 18px;
  font-size: 0.86rem;
}

.lp-math-table th {
  background: #0d0d0d;
  color: #fff;
  padding: 9px 11px;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  text-align: left;
}


.lp-math-table td {
  padding: 10px 11px;
  border-bottom: 1px solid #e0e0e0;
  color: #111;
}

.lp-math-table tr:last-child td { border-bottom: none; }

.lp-math-win  { font-weight: 800; color: #2e7d32; }
.lp-math-lose { color: #bbb; text-decoration: line-through; }

.lp-math-callout {
  background: #e8f5e9;
  border-radius: 0;
  padding: 15px 17px;
  font-size: 0.88rem;
  color: #111;
  line-height: 1.65;
  margin-bottom: 24px;
}

.lp-math-callout strong { color: #2e7d32; font-weight: 900; }

.lp-guarantee__img-wrap {
  border-radius: 0;
  overflow: hidden;
}

.lp-guarantee__img {
  width: 100%;
  height: auto;
  display: block;
  aspect-ratio: 3/2;
  object-fit: cover;
}

@media (min-width: 750px) {
  .lp-guarantee {
    padding: 80px 60px;
  }
}

{% endstylesheet %}

