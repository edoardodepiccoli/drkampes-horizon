{% assign product = section.settings.product %}
{% assign tshirt_product = section.settings.tshirt_product %}
{% assign discount_code = section.settings.discount_code %}
{% assign offer_headline = section.settings.offer_headline %}
{% assign first_variant = product.selected_or_first_available_variant %}
{% if product == blank %}
  <div style="padding:2rem;text-align:center;color:#888;">Nessun prodotto selezionato</div>
{% else %}

{%- assign hps_compare_cents = 21900 -%}
{%- assign hps_diff_cents = hps_compare_cents | minus: product.price -%}
{%- assign hps_pct = hps_diff_cents | times: 100 | divided_by: 21900.0 | round -%}
{%- assign hps_installment_cents = product.price | divided_by: 3 -%}

<div class="hps" id="acquista" data-hps-id="{{ section.id }}">

  <script type="application/json" id="hps-variants-{{ section.id }}">
    {{ product.variants | json }}
  </script>

  <script type="application/json" id="hps-vg-{{ section.id }}">
    {
      {%- for variant in product.variants -%}
        {%- unless forloop.first -%},{%- endunless -%}
        "{{ variant.id }}": [
          {%- assign vg_files = variant.metafields.custom.variant_gallery.value -%}
          {%- if vg_files != blank -%}
            {%- assign first_hit = true -%}
            {%- for vg_file in vg_files -%}
              {%- for media in product.media -%}
                {%- if vg_file.image.src == media.src -%}
                  {%- unless first_hit -%},{%- endunless -%}
                  {{ media.id }}
                  {%- assign first_hit = false -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          {%- endif -%}
        ]
      {%- endfor -%}
    }
  </script>

  {%- if tshirt_product != blank -%}
    <script type="application/json" id="hps-tshirt-variants-{{ section.id }}">
      {{ tshirt_product.variants | json }}
    </script>
  {%- endif -%}

  <header class="hps__head">
    <h2 class="hps__title">{{ product.title }}</h2>

    <div class="hps__rating">
      <span class="hps__stars" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      </span>
      <span class="hps__rating-text"><strong>4,9/5</strong> da oltre 1200 camionisti soddisfatti</span>
    </div>

    <div class="hps__price-row">
      <span class="hps__price-main">{{ product.price | money }}</span>
      <span class="hps__price-compare">{{ hps_compare_cents | money }}</span>
      {%- if hps_pct > 0 -%}
        <span class="hps__price-discount">-{{ hps_pct }}%</span>
      {%- endif -%}
    </div>
    <p class="hps__installment">Oppure <strong>3 rate da {{ hps_installment_cents | money }}</strong> con Klarna o PayPal</p>

    {%- if section.settings.review_quote != blank -%}
      <blockquote class="hps__review-quote">&#8220;{{ section.settings.review_quote }}&#8221;</blockquote>
    {%- endif -%}
  </header>

  <div class="hps__gallery">
    <div class="hps__main">
      <button type="button" class="hps__nav hps__nav--prev" id="hps-nav-prev-{{ section.id }}" aria-label="Immagine precedente">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button type="button" class="hps__nav hps__nav--next" id="hps-nav-next-{{ section.id }}" aria-label="Immagine successiva">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>

      {%- if section.settings.custom_first_image_url != blank -%}
        <div class="hps__slide" data-media-id="__custom__" style="display:none">
          <img src="{{ section.settings.custom_first_image_url }}" class="hps__img" loading="eager" alt="{{ product.title }}">
        </div>
      {%- endif -%}
      {%- if section.settings.custom_first_image_url_2 != blank -%}
        <div class="hps__slide" data-media-id="__custom2__" style="display:none">
          <img src="{{ section.settings.custom_first_image_url_2 }}" class="hps__img" loading="eager" alt="{{ product.title }}">
        </div>
      {%- endif -%}
      {%- for media in product.media -%}
        <div
          class="hps__slide{% if forloop.first %} hps__slide--active{% endif %}"
          data-media-id="{{ media.id }}"
        >
          {%- if forloop.first -%}
            {{ media | image_url: width: 1000 | image_tag: class: 'hps__img', loading: 'eager', widths: '500,750,1000', sizes: '(max-width:749px) 100vw, 50vw' }}
          {%- else -%}
            {{ media | image_url: width: 1000 | image_tag: class: 'hps__img', loading: 'lazy', widths: '500,750,1000', sizes: '(max-width:749px) 100vw, 50vw' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="hps__thumbs">
      {%- if section.settings.custom_first_image_url != blank -%}
        <button type="button" class="hps__thumb" data-media-id="__custom__" aria-label="Immagine principale" style="display:none"><img src="{{ section.settings.custom_first_image_url }}" class="hps__thumb-img" loading="lazy" alt="{{ product.title }}"></button>
      {%- endif -%}
      {%- if section.settings.custom_first_image_url_2 != blank -%}
        <button type="button" class="hps__thumb" data-media-id="__custom2__" aria-label="Immagine principale" style="display:none"><img src="{{ section.settings.custom_first_image_url_2 }}" class="hps__thumb-img" loading="lazy" alt="{{ product.title }}"></button>
      {%- endif -%}
      {%- for media in product.media -%}
        <button
          type="button"
          class="hps__thumb{% if forloop.first %} hps__thumb--active{% endif %}"
          data-index="{{ forloop.index0 }}"
          data-media-id="{{ media.id }}"
          aria-label="Immagine {{ forloop.index }}"
        >{{ media | image_url: width: 200 | image_tag: class: 'hps__thumb-img', loading: 'lazy' }}</button>
      {%- endfor -%}
    </div>
  </div>

  <div class="hps__details">

    {%- assign form_id = 'hps-form-' | append: section.id -%}
    {% form 'product', product, id: form_id, class: 'hps__form' %}
      <input type="hidden" name="id" id="hps-vid-{{ section.id }}" value="{{ first_variant.id }}">

      {%- assign color_option = nil -%}
      {%- assign color_pos = 0 -%}
      {%- for option in product.options_with_values -%}
        {%- assign n = option.name | downcase -%}
        {%- if n == 'colore' or n == 'color' or n == 'colour' -%}
          {%- assign color_option = option -%}
          {%- assign color_pos = option.position | minus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if color_option != nil -%}
        <div class="hps__opt">
          <p class="hps__opt-lbl">Colore: <span class="hps__opt-val" id="hps-cval-{{ section.id }}">{{ color_option.selected_value | upcase }}</span></p>
          <div class="hps__swatches">
            {%- for value in color_option.values -%}
              <button
                type="button"
                class="hps__swatch{% if color_option.selected_value == value %} hps__swatch--on{% endif %}"
                data-color="{{ value }}"
                data-pos="{{ color_pos }}"
                title="{{ value }}"
                aria-label="{{ value }}"
                {%- assign sw = value.swatch -%}
                {%- assign val_h = value | handleize -%}
                style="{% if sw.color %}background:rgb({{ sw.color.rgb }});{% elsif sw.image %}background:url('{{ sw.image | image_url: width: 80 }}') center/cover no-repeat;{% elsif val_h == 'nero' %}background:#1a1a1a;{% elsif val_h == 'testa-di-moro' or val_h == 'testa-moro' %}background:#3d1a0a;{% elsif val_h == 'marrone' or val_h == 'brown' %}background:#5c3317;{% else %}background:#888;{% endif %}"
              ></button>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- assign size_option = nil -%}
      {%- assign size_pos = 1 -%}
      {%- for option in product.options_with_values -%}
        {%- assign n = option.name | downcase -%}
        {%- if n == 'taglia' or n == 'size' or n == 'misura' -%}
          {%- assign size_option = option -%}
          {%- assign size_pos = option.position | minus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if size_option == nil -%}
        {%- for option in product.options_with_values -%}
          {%- if option.position != color_option.position -%}
            {%- assign size_option = option -%}
            {%- assign size_pos = option.position | minus: 1 -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- if size_option != nil -%}
        <div class="hps__opt">
          <div class="hps__size-row">
            <p class="hps__opt-lbl">Taglia: <span class="hps__opt-val" id="hps-sval-{{ section.id }}">{{ size_option.selected_value }}</span></p>
            <div class="hps__info-btns">
              <button type="button" class="hps__info-btn" id="hps-tech-{{ section.id }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                Schede tecniche
              </button>
              <button type="button" class="hps__info-btn" id="hps-size-{{ section.id }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 6H3a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h18a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1z"/><line x1="6" y1="6" x2="6" y2="10"/><line x1="10" y1="6" x2="10" y2="9"/><line x1="14" y1="6" x2="14" y2="10"/><line x1="18" y1="6" x2="18" y2="9"/></svg>
                Guida alle taglie
              </button>
            </div>
          </div>
          <div class="hps__pills" id="hps-ssel-{{ section.id }}" data-pos="{{ size_pos }}" role="group" aria-label="Taglia">
            {%- for value in size_option.values -%}
              {%- assign pill_avail = false -%}
              {%- for variant in product.variants -%}
                {%- if variant.options[size_pos] == value and variant.available -%}
                  {%- assign pill_avail = true -%}
                {%- endif -%}
              {%- endfor -%}
              <button
                type="button"
                class="hps__pill{% if size_option.selected_value == value %} hps__pill--on{% endif %}{% unless pill_avail %} hps__pill--unavail{% endunless %}"
                data-value="{{ value }}"
                data-pos="{{ size_pos }}"
                {% unless pill_avail %}aria-disabled="true"{% endunless %}
              >{{ value }}</button>
            {%- endfor -%}
          </div>
          <p class="hps__stock" id="hps-stock-{{ section.id }}" hidden>
            <svg class="hps__stock-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2"/><path d="M5 3 2 6"/><path d="m22 6-3-3"/><path d="M6.4 19.4 4 22"/><path d="M17.6 19.4 20 22"/></svg>
            <span>Meno di <span class="hps-stock-n">{{ section.settings.low_stock_number | default: 7 }}</span> paia rimaste</span>
          </p>
        </div>
      {%- endif -%}

      <button type="button" class="hps__cta" id="hps-bn-{{ section.id }}">
        <svg class="hps__cta-ico hps__cta-ico--lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span class="hps__cta-text">{{ section.settings.cta_label | default: 'PRENOTA ORA LA TUA TAGLIA' }}</span>
        <svg class="hps__cta-ico hps__cta-ico--arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </button>

    {% endform %}

    <ul class="hps__features">
      <li class="hps__feature">
        <svg class="hps__feature-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        <p class="hps__feature-ttl">3 ANNI DI GARANZIA</p>
        <p class="hps__feature-dsc">Acquistale oggi e indossale per anni.</p>
      </li>
      <li class="hps__feature">
        <svg class="hps__feature-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
        <p class="hps__feature-ttl">CAMBIO TAGLIA GRATUITO</p>
        <p class="hps__feature-dsc">Se non &egrave; la taglia giusta, la cambiamo noi.</p>
      </li>
      <li class="hps__feature">
        <svg class="hps__feature-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><path d="M16 8h4l3 5v4h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        <p class="hps__feature-ttl">SPEDIZIONE GRATIS 1-2 GIORNI</p>
        <p class="hps__feature-dsc">Ordina prima delle 19:00, spediamo il giorno dopo.</p>
      </li>
      <li class="hps__feature">
        <svg class="hps__feature-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
        <p class="hps__feature-ttl">PAGA IN 3 RATE SENZA INTERESSI</p>
        <p class="hps__feature-dsc">Scegli Klarna o PayPal al checkout.</p>
      </li>
    </ul>

  </div>
</div>

<div class="hps__viewer-toast" id="hps-viewers-{{ section.id }}"><span class="hps-viewers-dot"></span><span class="hps-viewers-n">0</span> persone stanno guardando</div>

<div class="hps-pop" id="hps-pop-tshirt-{{ section.id }}" role="dialog" aria-modal="true" aria-labelledby="hps-tshirt-title-{{ section.id }}" hidden>
  <div class="hps-pop__bg" data-pop-close></div>
  <div class="hps-pop__box hps-pop__box--offer">
    <button type="button" class="hps-pop__x" data-pop-close aria-label="Chiudi">&times;</button>
    <div class="hps-offer-badge">
      <span aria-hidden="true">🎁</span> T-shirt OMAGGIO
    </div>
    <h3 class="hps-pop__title" id="hps-tshirt-title-{{ section.id }}">Scegli la taglia della tua T-shirt</h3>
    {%- if tshirt_product != blank and tshirt_product.featured_image != blank -%}
      <div class="hps-tshirt-img-wrap">
        {{ tshirt_product.featured_image | image_url: width: 480 | image_tag: class: 'hps-tshirt-img', loading: 'lazy', alt: tshirt_product.title }}
      </div>
    {%- endif -%}
    <div class="hps-pop__body">
      {%- if tshirt_product != blank -%}
        <p class="hps-tshirt-product-name">{{ tshirt_product.title }}</p>
        <select id="hps-tshirt-sel-{{ section.id }}" class="hps__select hps-tshirt-sel" aria-label="Taglia T-shirt">
          {%- for variant in tshirt_product.variants -%}
            <option value="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}>
              {{ variant.title }}{% unless variant.available %} — Esaurito{% endunless %}
            </option>
          {%- endfor -%}
        </select>
      {%- else -%}
        <p style="color:#888;font-size:0.85rem;">Nessuna t-shirt configurata.</p>
      {%- endif -%}
    </div>
    <button type="button" id="hps-confirm-{{ section.id }}" class="hps__atc hps__atc--confirm">
      Conferma e Vai al Checkout
    </button>
    <p class="hps__micro hps-tshirt-disclaimer">
      Entrambi i prodotti vengono aggiunti al carrello. Il codice spedizione gratuita viene applicato automaticamente al checkout.
    </p>
  </div>
</div>

<div class="hps-pop" id="hps-pop-tech-{{ section.id }}" role="dialog" aria-modal="true" hidden>
  <div class="hps-pop__bg" data-pop-close></div>
  <div class="hps-pop__box">
    <button type="button" class="hps-pop__x" data-pop-close aria-label="Chiudi">&times;</button>
    <h3 class="hps-pop__title">Documentazione Tecnica</h3>
    <div class="hps-pop__body">
      <div class="hps-doc-section">
        <p class="hps-doc-section__label">Documenti comuni</p>
        <a class="hps-doc-row" href="https://cdn.shopify.com/s/files/1/0960/9527/3303/files/DPI-DRKAMPES-CERTIFICAZIONE-S3S.pdf?v=1776677825" target="_blank" rel="noopener">
          <span class="hps-doc-row__icon">&#8595;</span>
          <span class="hps-doc-row__name">Certificazione DPI S3S</span>
          <span class="hps-doc-row__type">PDF</span>
        </a>
        <a class="hps-doc-row" href="https://cdn.shopify.com/s/files/1/0960/9527/3303/files/NOTA-INFORMATIVA-DRKAMPES.pdf?v=1776677825" target="_blank" rel="noopener">
          <span class="hps-doc-row__icon">&#8595;</span>
          <span class="hps-doc-row__name">Nota informativa</span>
          <span class="hps-doc-row__type">PDF</span>
        </a>
      </div>
      <div class="hps-doc-section">
        <p class="hps-doc-section__label">Schede tecniche per modello</p>
        <a class="hps-doc-row" href="https://cdn.shopify.com/s/files/1/0960/9527/3303/files/DR_KAMPES_-_SCHEDA_TECNICA-20260420-BLACK.pdf?v=1776677825" target="_blank" rel="noopener">
          <span class="hps-doc-row__icon">&#8595;</span>
          <span class="hps-doc-row__name">Dr Kampes Nere</span>
          <span class="hps-doc-row__type">PDF</span>
        </a>
        <a class="hps-doc-row" href="https://cdn.shopify.com/s/files/1/0960/9527/3303/files/DR_KAMPES_-_SCHEDA_TECNICA-20260420-BLACK.pdf?v=1776677825" target="_blank" rel="noopener">
          <span class="hps-doc-row__icon">&#8595;</span>
          <span class="hps-doc-row__name">Dr Kampes Testa di Moro</span>
          <span class="hps-doc-row__type">PDF</span>
        </a>
      </div>
    </div>
  </div>
</div>

<div class="hps-pop" id="hps-pop-size-{{ section.id }}" role="dialog" aria-modal="true" hidden>
  <div class="hps-pop__bg" data-pop-close></div>
  <div class="hps-pop__box">
    <button type="button" class="hps-pop__x" data-pop-close aria-label="Chiudi">&times;</button>
    <h3 class="hps-pop__title">Guida alla Taglia</h3>
    <div class="hps-pop__body">
      <p>Misura la lunghezza interna della soletta e confronta con la tabella.</p>
      <table class="hps-stbl">
        <thead><tr><th>IT</th><th>Cm Soletta Interna</th></tr></thead>
        <tbody>
          <tr><td>37</td><td>24,5 cm</td></tr>
          <tr><td>38</td><td>25 cm</td></tr>
          <tr><td>39</td><td>25,5 cm</td></tr>
          <tr><td>40</td><td>26,5 cm</td></tr>
          <tr><td>41</td><td>27,5 cm</td></tr>
          <tr><td>42</td><td>28 cm</td></tr>
          <tr><td>43</td><td>28,5 cm</td></tr>
          <tr><td>44</td><td>29 cm</td></tr>
          <tr><td>45</td><td>30 cm</td></tr>
          <tr><td>46</td><td>30,5 cm</td></tr>
          <tr><td>47</td><td>31 cm</td></tr>
          <tr><td>48</td><td>32 cm</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="hps-cta-bar" id="hps-cta-bar-{{ section.id }}">
  <button type="button" class="hps-cta hps-cta--after" id="hps-cta-bn-{{ section.id }}">
    <span class="hps-cta-bar__label">{{ section.settings.cta_label | default: 'PRENOTA ORA LA TUA TAGLIA' }}</span>
  </button>
</div>

<script>
(function () {
  var sid = '{{ section.id }}';
  var discountCode = {{ section.settings.discount_code | json }};
  var bundleDiscountCode = {{ section.settings.bundle_discount_code | json }};
  var viewerMin = {{ section.settings.viewer_min | default: 12 }};
  var viewerMax = {{ section.settings.viewer_max | default: 37 }};
  var customHeroSlots = [
    { id: '__custom__',  url: {{ section.settings.custom_first_image_url | json }},   colorKey: {{ section.settings.custom_first_image_color | handleize | json }} },
    { id: '__custom2__', url: {{ section.settings.custom_first_image_url_2 | json }}, colorKey: {{ section.settings.custom_first_image_color_2 | handleize | json }} }
  ].filter(function (s) { return s.url && s.colorKey; });

  function buildCheckoutUrl() {
    var base = '/checkout?discount=' + encodeURIComponent(discountCode);
    if (bundleDiscountCode) {
      return '/discount/' + encodeURIComponent(bundleDiscountCode) + '?redirect=' + encodeURIComponent(base);
    }
    return base;
  }
  var root = document.querySelector('[data-hps-id="' + sid + '"]');
  if (!root) return;

  var allVariants = JSON.parse(document.getElementById('hps-variants-' + sid).textContent);
  var vgMap       = JSON.parse(document.getElementById('hps-vg-' + sid).textContent);

  var slides = Array.from(root.querySelectorAll('.hps__slide'));
  var thumbs = Array.from(root.querySelectorAll('.hps__thumb'));
  var vidInput   = document.getElementById('hps-vid-' + sid);
  var stockEl    = document.getElementById('hps-stock-' + sid);
  var ctaPriceEl = document.getElementById('hps-cta-price-' + sid);
  var viewersEl  = document.getElementById('hps-viewers-' + sid);

  function formatPrice(cents) {
    var n = cents / 100;
    return Number.isInteger(n) ? String(n) : n.toFixed(2).replace('.', ',');
  }

  var initV = allVariants.find(function (v) { return v.available; }) || allVariants[0];
  var selOpts = initV ? initV.options.slice() : [];

  var mainEl   = root.querySelector('.hps__main');
  var thumbsEl = root.querySelector('.hps__thumbs');

  function showByMediaId(mediaId) {
    slides.forEach(function (s) { s.classList.toggle('hps__slide--active', s.dataset.mediaId === mediaId); });
    thumbs.forEach(function (t) { t.classList.toggle('hps__thumb--active', t.dataset.mediaId === mediaId); });
  }

  function filterGallery(variantId) {
    var slotIds = customHeroSlots.map(function (s) { return s.id; });
    function isCustom(el) { return slotIds.indexOf(el.dataset.mediaId) !== -1; }

    var ids = vgMap[String(variantId)];

    if (!ids || ids.length === 0) {
      slides.forEach(function (s) { if (!isCustom(s)) s.style.display = ''; });
      thumbs.forEach(function (t) { if (!isCustom(t)) t.style.display = ''; });
    } else {
      slides.forEach(function (s) { if (!isCustom(s)) s.style.display = 'none'; });
      thumbs.forEach(function (t) { if (!isCustom(t)) t.style.display = 'none'; });

      ids.forEach(function (id) {
        var strId = String(id);
        var slide = mainEl.querySelector('.hps__slide[data-media-id="' + strId + '"]');
        var thumb = thumbsEl.querySelector('.hps__thumb[data-media-id="' + strId + '"]');
        if (slide) { slide.style.display = ''; mainEl.appendChild(slide); }
        if (thumb) { thumb.style.display = ''; thumbsEl.appendChild(thumb); }
      });
    }

    var v = allVariants.find(function (fv) { return fv.id === variantId; });
    var vc = '';
    if (v && swatches.length) {
      var cp = parseInt(swatches[0].dataset.pos, 10);
      vc = (v.options[cp] || '').toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
    }

    var activeSlot = null;
    customHeroSlots.forEach(function (slot) {
      var customSlide = mainEl.querySelector('.hps__slide[data-media-id="' + slot.id + '"]');
      var customThumb = thumbsEl.querySelector('.hps__thumb[data-media-id="' + slot.id + '"]');
      if (!customSlide) return;
      if (vc && vc === slot.colorKey) {
        activeSlot = slot;
        customSlide.style.display = '';
        mainEl.insertBefore(customSlide, mainEl.firstChild);
        if (customThumb) { customThumb.style.display = ''; thumbsEl.insertBefore(customThumb, thumbsEl.firstChild); }
      } else {
        customSlide.style.display = 'none';
        if (customThumb) customThumb.style.display = 'none';
      }
    });

    slides = Array.from(mainEl.querySelectorAll('.hps__slide'));
    thumbs = Array.from(thumbsEl.querySelectorAll('.hps__thumb'));

    if (activeSlot) {
      showByMediaId(activeSlot.id);
    } else if (ids && ids.length) {
      showByMediaId(String(ids[0]));
    } else {
      var first = slides.find(function (s) { return s.style.display !== 'none'; });
      if (first) showByMediaId(first.dataset.mediaId);
    }
  }

  thumbsEl.addEventListener('click', function (e) {
    var btn = e.target.closest('.hps__thumb');
    if (btn) showByMediaId(btn.dataset.mediaId);
  });

  var swipeStartX = 0;
  var swipeStartY = 0;
  var swipeLock   = null;
  mainEl.addEventListener('pointerdown', function (e) {
    if (e.target.closest('.hps__nav')) return;
    swipeStartX = e.clientX;
    swipeStartY = e.clientY;
    swipeLock   = null;
  });
  mainEl.addEventListener('pointermove', function (e) {
    if (swipeLock === null) {
      var dx = Math.abs(e.clientX - swipeStartX);
      var dy = Math.abs(e.clientY - swipeStartY);
      if (dx > 5 || dy > 5) swipeLock = dx > dy ? 'h' : 'v';
    }
    if (swipeLock === 'h') e.preventDefault();
  }, { passive: false });
  mainEl.addEventListener('pointerup', function (e) {
    if (swipeLock !== 'h') return;
    var delta = e.clientX - swipeStartX;
    if (Math.abs(delta) < 40) return;
    var visible = slides.filter(function (s) { return s.style.display !== 'none'; });
    var activeIdx = visible.findIndex(function (s) { return s.classList.contains('hps__slide--active'); });
    if (activeIdx < 0) return;
    var nextIdx = delta < 0
      ? Math.min(activeIdx + 1, visible.length - 1)
      : Math.max(activeIdx - 1, 0);
    if (nextIdx !== activeIdx) showByMediaId(visible[nextIdx].dataset.mediaId);
  });

  function navStep(dir) {
    var visible = slides.filter(function (s) { return s.style.display !== 'none'; });
    if (!visible.length) return;
    var idx = visible.findIndex(function (s) { return s.classList.contains('hps__slide--active'); });
    if (idx < 0) idx = 0;
    var nextIdx = (idx + dir + visible.length) % visible.length;
    showByMediaId(visible[nextIdx].dataset.mediaId);
  }
  var navPrev = document.getElementById('hps-nav-prev-' + sid);
  var navNext = document.getElementById('hps-nav-next-' + sid);
  if (navPrev) navPrev.addEventListener('click', function (e) { e.preventDefault(); e.stopPropagation(); navStep(-1); });
  if (navNext) navNext.addEventListener('click', function (e) { e.preventDefault(); e.stopPropagation(); navStep(1); });

  function syncVariant() {
    var match = allVariants.find(function (v) {
      return v.options.every(function (o, i) { return o === selOpts[i]; });
    }) || allVariants.find(function (v) { return v.options[0] === selOpts[0]; });
    if (!match) return;
    vidInput.value = match.id;
    if (ctaPriceEl) ctaPriceEl.textContent = '€' + formatPrice(match.price);
    if (sSel) {
      sSel.querySelectorAll('.hps__pill').forEach(function (pill) {
        var sizeVal = pill.dataset.value;
        var sPos    = parseInt(pill.dataset.pos, 10);
        var avail   = allVariants.some(function (v) {
          return v.options[sPos] === sizeVal &&
                 selOpts.every(function (opt, i) { return i === sPos || v.options[i] === opt; }) &&
                 v.available;
        });
        pill.classList.toggle('hps__pill--unavail', !avail);
        pill.setAttribute('aria-disabled', avail ? 'false' : 'true');
      });
    }
    filterGallery(match.id);
  }

  var swatches  = root.querySelectorAll('.hps__swatch');
  var cValEl    = document.getElementById('hps-cval-' + sid);

  swatches.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var pos = parseInt(btn.dataset.pos, 10);
      selOpts[pos] = btn.dataset.color;
      swatches.forEach(function (s) { s.classList.remove('hps__swatch--on'); });
      btn.classList.add('hps__swatch--on');
      if (cValEl) cValEl.textContent = btn.dataset.color.toUpperCase();
      syncVariant();
    });
  });

  var sSel       = document.getElementById('hps-ssel-' + sid);
  var sValEl     = document.getElementById('hps-sval-' + sid);
  var stockNumEl = stockEl ? stockEl.querySelector('.hps-stock-n') : null;
  var stockMap   = {};
  if (sSel) {
    sSel.querySelectorAll('.hps__pill').forEach(function (pill) {
      stockMap[pill.dataset.value] = 3 + Math.floor(Math.random() * 7);
    });
  }

  if (sSel) {
    sSel.addEventListener('click', function (e) {
      var btn = e.target.closest('.hps__pill');
      if (!btn || btn.getAttribute('aria-disabled') === 'true') return;
      var pos = parseInt(btn.dataset.pos, 10);
      selOpts[pos] = btn.dataset.value;
      sSel.querySelectorAll('.hps__pill').forEach(function (p) { p.classList.remove('hps__pill--on'); });
      btn.classList.add('hps__pill--on');
      if (sValEl) sValEl.textContent = btn.dataset.value;
      if (stockEl) {
        if (stockNumEl) stockNumEl.textContent = stockMap[btn.dataset.value] || 7;
        stockEl.hidden = false;
      }
      syncVariant();
    });
  }

  var qtyEl = document.getElementById('hps-qty-' + sid);

  var bnBtn = document.getElementById('hps-bn-' + sid);
  if (bnBtn) {
    bnBtn.addEventListener('click', function () { openPop('hps-pop-tshirt-' + sid); });
  }

  function openPop(id) {
    var el = document.getElementById(id);
    if (el) { el.hidden = false; document.body.style.overflow = 'hidden'; }
  }
  function closePops() {
    document.querySelectorAll('.hps-pop:not([hidden])').forEach(function (p) { p.hidden = true; });
    document.body.style.overflow = '';
  }

  var techBtn = document.getElementById('hps-tech-' + sid);
  var sizeBtn = document.getElementById('hps-size-' + sid);
  if (techBtn) techBtn.addEventListener('click', function () { openPop('hps-pop-tech-' + sid); });
  if (sizeBtn) sizeBtn.addEventListener('click', function () { openPop('hps-pop-size-' + sid); });

  document.querySelectorAll('[data-pop-close]').forEach(function (el) {
    el.addEventListener('click', closePops);
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closePops(); });

  var tshirtSel  = document.getElementById('hps-tshirt-sel-' + sid);
  var confirmBtn = document.getElementById('hps-confirm-' + sid);

  if (confirmBtn) {
    confirmBtn.addEventListener('click', function () {
      var shoeId   = parseInt(vidInput.value, 10);
      var tshirtId = parseInt(tshirtSel ? tshirtSel.value : '0', 10);
      var qty      = parseInt(qtyEl ? qtyEl.value : '1', 10) || 1;

      if (!shoeId || !tshirtId) {
        window.location.href = buildCheckoutUrl();
        return;
      }

      confirmBtn.disabled = true;
      confirmBtn.textContent = 'Aggiunta in corso...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: [
            { id: shoeId,   quantity: qty },
            { id: tshirtId, quantity: 1   }
          ]
        })
      }).then(function () {
        window.location.href = buildCheckoutUrl();
      }).catch(function () {
        window.location.href = buildCheckoutUrl();
      });
    });
  }

  var ctaBar = document.getElementById('hps-cta-bar-{{ section.id }}');
  var ctaBnBtn = document.getElementById('hps-cta-bn-{{ section.id }}');

  if (ctaBar) {
    var ctaState = 'hidden';

    function updateCta() {
      var bnRect = bnBtn ? bnBtn.getBoundingClientRect() : null;
      var bnOffScreen = bnRect && bnRect.bottom < 0;
      var newState = bnOffScreen ? 'after' : 'hidden';
      if (newState === ctaState) return;
      ctaState = newState;

      ctaBar.style.transition = 'none';
      ctaBar.classList.remove('hps-cta-bar--visible');
      ctaBar.classList.toggle('hps-cta-bar--past', newState === 'after');
      ctaBar.offsetHeight;
      ctaBar.style.transition = '';
      if (newState !== 'hidden') ctaBar.classList.add('hps-cta-bar--visible');
    }

    window.addEventListener('scroll', updateCta, { passive: true });
  }

  if (ctaBnBtn) {
    ctaBnBtn.addEventListener('click', function () {
      root.scrollIntoView({ behavior: 'smooth' });
    });
  }

  if (initV) filterGallery(initV.id);

  if (viewersEl && viewerMin > 0 && viewerMax >= viewerMin) {
    var viewerCount = viewerMin + Math.floor(Math.random() * (viewerMax - viewerMin + 1));
    var viewerNumEl = viewersEl.querySelector('.hps-viewers-n');
    function updateViewers() {
      var drift = Math.floor(Math.random() * 5) - 2;
      viewerCount = Math.max(viewerMin, Math.min(viewerMax, viewerCount + drift));
      if (viewerNumEl) viewerNumEl.textContent = viewerCount;
    }
    var viewerTriggered = false;
    function updateViewerToast() {
      if (!viewerTriggered) return;
      var sSelRect = sSel ? sSel.getBoundingClientRect() : null;
      var show = sSelRect ? (sSelRect.top < window.innerHeight && sSelRect.bottom > 0) : false;
      viewersEl.classList.toggle('hps__viewer-toast--visible', show);
    }
    function startViewers() {
      if (viewerTriggered) return;
      viewerTriggered = true;
      if (viewerNumEl) viewerNumEl.textContent = viewerCount;
      updateViewerToast();
      (function scheduleUpdate() {
        setTimeout(function () { updateViewers(); scheduleUpdate(); }, 4000 + Math.random() * 2000);
      })();
    }
    var triggerEl = sSel || root.querySelector('.hps__price-row') || root.querySelector('.hps__details');
    if (triggerEl) {
      new IntersectionObserver(function (entries, obs) {
        if (entries[0].isIntersecting) { setTimeout(startViewers, 2000); obs.disconnect(); }
      }, { threshold: 0.5 }).observe(triggerEl);
    } else {
      setTimeout(startViewers, 3500);
    }
    window.addEventListener('scroll', updateViewerToast, { passive: true });
  }
})();
</script>

{% endif %}

{% stylesheet %}

/* =============================================================================
   hps-offerta — PDP redesign
   Light surface, gold pulse CTA, red savings chip, square size pills,
   4-card features grid. All tokens from lp-design-system.css.
   ============================================================================= */

.hps {
  display: flex;
  flex-direction: column;
  gap: var(--lp-space-5);
  background: var(--lp-color-surface-light);
  font-family: var(--lp-font-body);
  color: var(--lp-color-text-on-light);
  padding: var(--lp-space-5) var(--lp-section-pad-x) var(--lp-space-7);
  scroll-margin-top: var(--lp-space-5);
}

/* ---------------------------------------------------------------------------
   Head: title + rating + price + installment
   --------------------------------------------------------------------------- */
.hps__head {
  display: flex;
  flex-direction: column;
  gap: var(--lp-space-3);
}

.hps__title {
  font-family: var(--lp-font-display);
  font-size: var(--lp-fs-h2);
  font-weight: var(--lp-fw-black);
  margin: 0;
  line-height: var(--lp-lh-snug);
  letter-spacing: var(--lp-ls-tight);
  color: var(--lp-color-text-on-light);
  text-transform: uppercase;
}

.hps__rating {
  display: flex;
  align-items: center;
  gap: var(--lp-space-2);
  flex-wrap: wrap;
}

.hps__stars {
  display: inline-flex;
  align-items: center;
  gap: 1px;
  color: var(--lp-color-gold);
  flex-shrink: 0;
}

.hps__stars svg {
  width: 18px;
  height: 18px;
  display: block;
}

.hps__rating-text {
  font-size: var(--lp-fs-sm);
  color: var(--lp-color-text-on-light-mute);
  line-height: var(--lp-lh-snug);
}
.hps__rating-text strong {
  color: var(--lp-color-text-on-light);
  font-weight: var(--lp-fw-bold);
}

.hps__price-row {
  display: flex;
  align-items: baseline;
  gap: var(--lp-space-2);
  flex-wrap: wrap;
  margin: var(--lp-space-1) 0 0;
}

.hps__price-main {
  font-family: var(--lp-font-display);
  font-size: var(--lp-fs-h1);
  font-weight: var(--lp-fw-black);
  color: var(--lp-color-text-on-light);
  line-height: 1;
  letter-spacing: var(--lp-ls-tight);
}

.hps__price-compare {
  font-size: var(--lp-fs-md);
  color: var(--lp-color-text-on-light-faint);
  text-decoration: line-through;
  font-weight: var(--lp-fw-regular);
}

.hps__price-discount {
  display: inline-flex;
  align-items: center;
  background: var(--lp-color-danger);
  color: var(--lp-color-white);
  font-family: var(--lp-font-display);
  font-size: var(--lp-fs-xs);
  font-weight: var(--lp-fw-black);
  padding: 4px var(--lp-space-2);
  border-radius: var(--lp-radius-none);
  letter-spacing: var(--lp-ls-wide);
  white-space: nowrap;
  align-self: center;
  line-height: 1;
}

.hps__installment {
  font-size: var(--lp-fs-sm);
  color: var(--lp-color-text-on-light-mute);
  margin: 0;
  line-height: var(--lp-lh-base);
}
.hps__installment strong {
  color: var(--lp-color-text-on-light);
  font-weight: var(--lp-fw-bold);
}

.hps__review-quote {
  font-size: var(--lp-fs-xs);
  color: var(--lp-color-text-on-light-mute);
  font-style: italic;
  margin: 0;
  padding: var(--lp-space-2) var(--lp-space-3);
  border-left: 3px solid var(--lp-color-gold);
  background: var(--lp-color-gold-faint);
  border-radius: var(--lp-radius-none);
  line-height: var(--lp-lh-base);
}

/* ---------------------------------------------------------------------------
   Gallery
   --------------------------------------------------------------------------- */
.hps__gallery {
  display: flex;
  flex-direction: column;
  gap: var(--lp-space-3);
  min-width: 0;
}

.hps__main {
  position: relative;
  background: var(--lp-color-white);
  aspect-ratio: 4 / 3;
  overflow: hidden;
  touch-action: pan-y;
}

.hps__slide {
  display: none;
  position: absolute;
  inset: 0;
}
.hps__slide--active { display: block; }

.hps__img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
  padding: var(--lp-space-4);
  box-sizing: border-box;
}

.hps__nav {
  position: absolute;
  top: 50%;
  z-index: 2;
  width: 40px;
  height: 40px;
  border-radius: var(--lp-radius-circle);
  background: var(--lp-color-white);
  border: 1px solid var(--lp-color-divider-light);
  color: var(--lp-color-text-on-light);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.10);
  transition: background var(--lp-transition-base), transform var(--lp-transition-fast);
  transform: translateY(-50%);
}
.hps__nav:hover { background: var(--lp-color-surface-card); }
.hps__nav:active { transform: translateY(-50%) scale(0.95); }
.hps__nav svg { width: 18px; height: 18px; }
.hps__nav--prev { left: var(--lp-space-3); }
.hps__nav--next { right: var(--lp-space-3); }

.hps__thumbs {
  display: flex;
  gap: var(--lp-space-2);
  overflow-x: auto;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
  padding-bottom: var(--lp-space-1);
}
.hps__thumbs::-webkit-scrollbar { display: none; }

.hps__thumb {
  flex: 0 0 64px;
  height: 64px;
  padding: var(--lp-space-1);
  border: 1.5px solid var(--lp-color-divider-light-strong);
  border-radius: var(--lp-radius-none);
  background: var(--lp-color-white);
  cursor: pointer;
  transition: border-color var(--lp-transition-base);
}
.hps__thumb--active {
  border-color: var(--lp-color-text-on-light);
  border-width: 2px;
}
.hps__thumb-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

/* ---------------------------------------------------------------------------
   Details: form + features
   --------------------------------------------------------------------------- */
.hps__details {
  display: flex;
  flex-direction: column;
  gap: var(--lp-space-5);
  min-width: 0;
}

.hps__form {
  display: flex;
  flex-direction: column;
  gap: var(--lp-space-4);
}

.hps__opt {
  display: flex;
  flex-direction: column;
  gap: var(--lp-space-3);
}

.hps__opt-lbl {
  font-family: var(--lp-font-display);
  font-size: var(--lp-fs-sm);
  font-weight: var(--lp-fw-black);
  color: var(--lp-color-text-on-light);
  text-transform: uppercase;
  letter-spacing: var(--lp-ls-wide);
  margin: 0;
}
.hps__opt-val { font-weight: var(--lp-fw-black); }

/* Color swatches: 36px circles, dark ring when selected */
.hps__swatches { display: flex; gap: var(--lp-space-3); }

.hps__swatch {
  width: 36px;
  height: 36px;
  border-radius: var(--lp-radius-circle);
  border: 2px solid var(--lp-color-white);
  padding: 0;
  cursor: pointer;
  outline: 1.5px solid var(--lp-color-divider-light-strong);
  outline-offset: 0;
  transition: outline-color var(--lp-transition-base), outline-width var(--lp-transition-base);
}
.hps__swatch--on {
  outline: 2px solid var(--lp-color-text-on-light);
}

/* Size row + info buttons */
.hps__size-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--lp-space-2);
  flex-wrap: wrap;
}

.hps__info-btns {
  display: flex;
  gap: var(--lp-space-3);
  flex-shrink: 0;
}

.hps__info-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--lp-space-1);
  font-size: var(--lp-fs-eyebrow);
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--lp-color-text-on-light);
  cursor: pointer;
  white-space: nowrap;
  font-family: inherit;
  font-weight: var(--lp-fw-medium);
  text-decoration: underline;
  text-underline-offset: 3px;
  letter-spacing: var(--lp-ls-normal);
  line-height: var(--lp-lh-snug);
  transition: color var(--lp-transition-base);
}
.hps__info-btn:hover { color: var(--lp-color-text-on-light-mute); }
.hps__info-btn svg { width: 14px; height: 14px; flex-shrink: 0; }

/* Size pills: white square, black solid when selected */
.hps__pills {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(56px, 1fr));
  gap: var(--lp-space-2);
}

.hps__pill {
  min-width: 0;
  height: 48px;
  padding: 0 var(--lp-space-2);
  border: 1.5px solid var(--lp-color-divider-light-strong);
  border-radius: var(--lp-radius-none);
  background: var(--lp-color-white);
  color: var(--lp-color-text-on-light);
  font-family: inherit;
  font-size: var(--lp-fs-base);
  font-weight: var(--lp-fw-medium);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color var(--lp-transition-base),
              background var(--lp-transition-base),
              color var(--lp-transition-base);
}
.hps__pill:not(.hps__pill--unavail):hover {
  border-color: var(--lp-color-text-on-light);
}
.hps__pill--on {
  background: var(--lp-color-text-on-light);
  border-color: var(--lp-color-text-on-light);
  color: var(--lp-color-white);
  font-weight: var(--lp-fw-bold);
}
.hps__pill--unavail {
  color: var(--lp-color-text-on-light-dim);
  border-color: var(--lp-color-divider-light);
  text-decoration: line-through;
  cursor: not-allowed;
}

/* Low-stock pill: light pink bg + red text + alarm icon */
.hps__stock {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--lp-space-2);
  font-size: var(--lp-fs-sm);
  font-weight: var(--lp-fw-black);
  color: var(--lp-color-danger);
  background: var(--lp-color-danger-soft);
  padding: var(--lp-space-3) var(--lp-space-4);
  margin: 0;
  border-radius: var(--lp-radius-none);
  letter-spacing: var(--lp-ls-wide);
  text-transform: uppercase;
  align-self: stretch;
  text-align: center;
  line-height: var(--lp-lh-snug);
}
.hps__stock-ico {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
}

/* ---------------------------------------------------------------------------
   CTA — gold, full-width, lock + text + arrow
   --------------------------------------------------------------------------- */
.hps__cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--lp-space-3);
  width: 100%;
  padding: var(--lp-space-4) var(--lp-space-5);
  background: var(--lp-color-gold);
  color: var(--lp-color-black);
  font-family: var(--lp-font-display);
  font-size: var(--lp-fs-md);
  font-weight: var(--lp-fw-black);
  letter-spacing: var(--lp-ls-wider);
  text-transform: uppercase;
  text-align: center;
  text-decoration: none;
  line-height: var(--lp-lh-snug);
  border: 0;
  border-radius: var(--lp-radius-none);
  cursor: pointer;
  transition: background var(--lp-transition-base), transform var(--lp-transition-fast);
  box-shadow: 0 0 0 0 var(--lp-color-gold-soft);
  animation: lp-cta-pulse var(--lp-cta-pulse-duration) ease-in-out infinite;
  position: relative;
  margin-top: var(--lp-space-1);
}
.hps__cta:hover { background: var(--lp-color-gold-hover); color: var(--lp-color-black); }
.hps__cta:active { transform: scale(0.99); }
.hps__cta:focus-visible {
  outline: 2px solid var(--lp-color-text-on-light);
  outline-offset: 2px;
}
.hps__cta-text {
  flex: 1;
  text-align: center;
  min-width: 0;
}
.hps__cta-ico {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
}
@media (prefers-reduced-motion: reduce) {
  .hps__cta { animation: none; }
}

/* ---------------------------------------------------------------------------
   Features (4-card trust grid)
   --------------------------------------------------------------------------- */
.hps__features {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1px;
  list-style: none;
  margin: 0;
  padding: 0;
  background: var(--lp-color-divider-light-strong);
  border: 1px solid var(--lp-color-divider-light-strong);
  border-radius: var(--lp-radius-none);
  overflow: hidden;
}

.hps__feature {
  display: flex;
  flex-direction: column;
  gap: var(--lp-space-2);
  padding: var(--lp-space-3);
  background: var(--lp-color-surface-card);
}

.hps__feature-ico {
  width: 22px;
  height: 22px;
  color: var(--lp-color-text-on-light);
  flex-shrink: 0;
}

.hps__feature-ttl {
  font-family: var(--lp-font-display);
  font-size: var(--lp-fs-eyebrow);
  font-weight: var(--lp-fw-black);
  color: var(--lp-color-text-on-light);
  margin: 0;
  letter-spacing: var(--lp-ls-wide);
  line-height: var(--lp-lh-snug);
  text-transform: uppercase;
}

.hps__feature-dsc {
  font-size: var(--lp-fs-xs);
  color: var(--lp-color-text-on-light-mute);
  margin: 0;
  line-height: var(--lp-lh-base);
}

@media (min-width: 480px) {
  .hps__features {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .hps__feature { padding: var(--lp-space-4); }
}

/* ---------------------------------------------------------------------------
   Popups / modals
   --------------------------------------------------------------------------- */
.hps-pop {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.hps-pop[hidden] { display: none; }

.hps-pop__bg {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  cursor: pointer;
}

.hps-pop__box {
  position: relative;
  background: var(--lp-color-white);
  border-radius: var(--lp-radius-none);
  width: 100%;
  max-height: calc(100svh - 40px);
  overflow-y: auto;
  padding: var(--lp-space-4) var(--lp-space-5) var(--lp-space-6);
  box-shadow: var(--lp-shadow-card-strong);
}

.hps-pop__x {
  position: absolute;
  top: var(--lp-space-4);
  right: var(--lp-space-4);
  background: none;
  border: none;
  font-size: var(--lp-fs-xl);
  cursor: pointer;
  color: var(--lp-color-text-on-light-mute);
  padding: 0 var(--lp-space-1);
  line-height: 1;
  font-family: inherit;
  transition: color var(--lp-transition-base);
}
.hps-pop__x:hover { color: var(--lp-color-text-on-light); }

.hps-pop__title {
  font-family: var(--lp-font-display);
  font-size: var(--lp-fs-lg);
  font-weight: var(--lp-fw-black);
  margin: 0 0 var(--lp-space-3);
  padding-right: 28px;
  color: var(--lp-color-text-on-light);
}

.hps-pop__body p {
  font-size: var(--lp-fs-sm);
  margin: 0 0 var(--lp-space-3);
  color: var(--lp-color-text-on-light-mute);
}

.hps-offer-badge {
  display: inline-flex;
  align-items: center;
  gap: var(--lp-space-2);
  background: var(--lp-color-gold-faint);
  border: 1.5px solid var(--lp-color-gold);
  border-radius: var(--lp-radius-none);
  padding: var(--lp-space-1) var(--lp-space-3);
  font-size: var(--lp-fs-xs);
  font-weight: var(--lp-fw-black);
  color: var(--lp-color-gold-hover);
  letter-spacing: var(--lp-ls-wide);
  margin-bottom: var(--lp-space-2);
}

.hps-pop__box--offer { padding-bottom: 28px; }

.hps-tshirt-img-wrap {
  margin: 0 calc(var(--lp-space-5) * -1) var(--lp-space-3);
  overflow: hidden;
  height: 180px;
}
.hps-tshirt-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}
.hps-tshirt-product-name {
  font-size: var(--lp-fs-sm);
  color: var(--lp-color-text-on-light-mute);
  margin: 0 0 var(--lp-space-2);
}
.hps-tshirt-sel { margin-bottom: var(--lp-space-4); }

.hps__select {
  width: 100%;
  padding: var(--lp-space-2) var(--lp-space-3);
  font-size: var(--lp-fs-base);
  border: 1px solid var(--lp-color-divider-light-strong);
  border-radius: var(--lp-radius-none);
  background: var(--lp-color-white);
  cursor: pointer;
  font-family: inherit;
  color: var(--lp-color-text-on-light);
  appearance: auto;
}

.hps__atc {
  width: 100%;
  padding: var(--lp-space-4) var(--lp-space-6);
  background: var(--lp-color-success-dark);
  color: var(--lp-color-white);
  border: none;
  border-radius: var(--lp-radius-none);
  font-size: var(--lp-fs-md);
  font-weight: var(--lp-fw-black);
  letter-spacing: var(--lp-ls-wider);
  cursor: pointer;
  text-transform: uppercase;
  font-family: var(--lp-font-display);
  line-height: var(--lp-lh-snug);
  transition: background var(--lp-transition-base);
}
.hps__atc:active { background: var(--lp-color-success-bg); }
.hps__atc--confirm { width: 100%; margin-bottom: var(--lp-space-3); }
.hps__atc--confirm:disabled { opacity: 0.6; cursor: not-allowed; }

.hps__micro {
  font-size: var(--lp-fs-xs);
  color: var(--lp-color-text-on-light-mute);
  margin: 0;
  text-align: center;
  line-height: var(--lp-lh-relaxed);
}
.hps-tshirt-disclaimer {
  font-size: var(--lp-fs-eyebrow);
  color: var(--lp-color-text-on-light-faint);
  margin: 0;
  text-align: center;
  line-height: var(--lp-lh-base);
}

.hps-doc-section { display: flex; flex-direction: column; gap: var(--lp-space-2); margin-bottom: var(--lp-space-5); }
.hps-doc-section:last-child { margin-bottom: 0; }
.hps-doc-section__label {
  font-size: var(--lp-fs-eyebrow);
  font-weight: var(--lp-fw-bold);
  text-transform: uppercase;
  letter-spacing: var(--lp-ls-wider);
  color: var(--lp-color-text-on-light-faint);
  margin: 0 0 var(--lp-space-1);
}
.hps-doc-row {
  display: flex;
  align-items: center;
  gap: var(--lp-space-3);
  padding: var(--lp-space-3);
  background: var(--lp-color-surface-card);
  border-radius: var(--lp-radius-none);
  text-decoration: none;
  color: var(--lp-color-text-on-light);
  transition: background var(--lp-transition-base);
}
.hps-doc-row:hover { background: var(--lp-color-divider-light); color: var(--lp-color-text-on-light); text-decoration: none; }
.hps-doc-row__icon {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--lp-color-black);
  color: var(--lp-color-white);
  border-radius: var(--lp-radius-circle);
  font-size: var(--lp-fs-sm);
  flex-shrink: 0;
}
.hps-doc-row__name {
  flex: 1;
  font-size: var(--lp-fs-sm);
  font-weight: var(--lp-fw-medium);
}
.hps-doc-row__type {
  font-size: var(--lp-fs-eyebrow);
  font-weight: var(--lp-fw-bold);
  color: var(--lp-color-text-on-light-faint);
  letter-spacing: var(--lp-ls-wide);
}

.hps-stbl { width: 100%; border-collapse: collapse; font-size: var(--lp-fs-sm); }
.hps-stbl th,
.hps-stbl td { border-bottom: 1px solid var(--lp-color-divider-light); padding: var(--lp-space-2); text-align: left; }
.hps-stbl th { font-weight: var(--lp-fw-bold); color: var(--lp-color-text-on-light); padding-top: var(--lp-space-1); }

/* ---------------------------------------------------------------------------
   Viewer toast
   --------------------------------------------------------------------------- */
@keyframes hps-toast-glow {
  0%, 100% { box-shadow: 0 2px 12px rgba(201, 162, 39, 0.25); }
  50%      { box-shadow: 0 2px 24px 4px rgba(201, 162, 39, 0.50); }
}
@keyframes hps-dot-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%      { opacity: 0.4; transform: scale(0.65); }
}

.hps__viewer-toast {
  position: fixed;
  top: var(--lp-space-4);
  left: 50%;
  transform: translateX(-50%) translateY(calc(-100% - 20px));
  background: var(--lp-color-surface-dark);
  color: var(--lp-color-text-on-dark);
  font-size: var(--lp-fs-xs);
  font-weight: var(--lp-fw-bold);
  padding: var(--lp-space-3) var(--lp-space-5);
  border-radius: var(--lp-radius-none);
  border: 1.5px solid var(--lp-color-gold);
  white-space: nowrap;
  z-index: 8500;
  pointer-events: none;
  transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  display: flex;
  align-items: center;
  gap: var(--lp-space-2);
  letter-spacing: var(--lp-ls-normal);
}
.hps__viewer-toast--visible {
  transform: translateX(-50%) translateY(0);
  animation: hps-toast-glow 1.8s ease-in-out infinite;
}

.hps-viewers-dot {
  width: 8px;
  height: 8px;
  border-radius: var(--lp-radius-circle);
  background: var(--lp-color-gold);
  flex-shrink: 0;
  animation: hps-dot-pulse 1.2s ease-in-out infinite;
}

.hps__viewer-toast .hps-viewers-n {
  color: var(--lp-color-gold);
  font-size: var(--lp-fs-md);
  font-weight: var(--lp-fw-black);
}

/* ---------------------------------------------------------------------------
   Sticky CTA bar
   --------------------------------------------------------------------------- */
.hps-cta-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 9000;
  display: flex;
  align-items: stretch;
  padding: var(--lp-space-3) var(--lp-space-4) calc(var(--lp-space-3) + env(safe-area-inset-bottom, 0px));
  background: var(--lp-color-black);
  opacity: 0;
  transform: translateY(100%);
  pointer-events: none;
  transition: opacity 0.25s, transform 0.25s;
}
.hps-cta-bar--visible {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.hps-cta-bar .hps-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 52px;
  text-decoration: none;
  border-radius: var(--lp-radius-none);
  border: none;
  cursor: pointer;
  background: var(--lp-color-gold);
  color: var(--lp-color-black) !important;
  font-family: var(--lp-font-display);
  font-size: var(--lp-fs-md);
  font-weight: var(--lp-fw-black);
  letter-spacing: var(--lp-ls-wider);
  text-transform: uppercase;
  transition: background var(--lp-transition-base);
}
.hps-cta-bar .hps-cta:hover { background: var(--lp-color-gold-hover); color: var(--lp-color-black) !important; text-decoration: none; }
.hps-cta-bar .hps-cta:active { background: var(--lp-color-gold-hover); }

.hps-cta-bar__label {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: var(--lp-fs-md);
  font-weight: var(--lp-fw-black);
  letter-spacing: var(--lp-ls-wider);
  text-transform: uppercase;
  line-height: 1;
}

/* ---------------------------------------------------------------------------
   Desktop layout (≥750px) — gallery left, head + details right
   --------------------------------------------------------------------------- */
@media (min-width: 750px) {
  .hps {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      "gallery head"
      "gallery details";
    grid-template-rows: auto 1fr;
    gap: var(--lp-space-5) var(--lp-space-9);
    padding: var(--lp-space-8) max(var(--lp-space-6), calc((100% - 1200px) / 2));
    align-items: start;
  }
  .hps__head    { grid-area: head; }
  .hps__details { grid-area: details; }
  .hps__gallery {
    grid-area: gallery;
    position: sticky;
    top: var(--sticky-header-offset, 24px);
  }

  .hps__title       { font-size: var(--lp-fs-h1); }
  .hps__price-main  { font-size: var(--lp-fs-price); }
  .hps__price-compare { font-size: var(--lp-fs-lg); }

  .hps__main { aspect-ratio: 1 / 1; }
  .hps__nav  { width: 44px; height: 44px; }
  .hps__nav--prev { left: var(--lp-space-4); }
  .hps__nav--next { right: var(--lp-space-4); }

  .hps__thumb { flex: 0 0 80px; height: 80px; }

  .hps__cta {
    padding: var(--lp-space-5) var(--lp-space-6);
    font-size: var(--lp-fs-lg);
  }

  .hps-pop      { align-items: center; }
  .hps-pop__box { width: 480px; max-height: calc(100vh - 40px); }
  .hps-tshirt-img-wrap { height: 200px; }
}

{% endstylesheet %}

