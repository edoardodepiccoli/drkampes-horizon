{%- assign img1 = section.settings.image_1 -%}
{%- assign img2 = section.settings.image_2 -%}

<section class="lp-benefits">
  {%- if section.settings.eyebrow != blank -%}
    <div class="lp-sec__eyebrow lp-benefits__eyebrow">{{ section.settings.eyebrow }}</div>
  {%- endif -%}

  <h2 class="lp-sec__h2 lp-benefits__h2">{{ section.settings.heading }}</h2>

  {%- if section.blocks.size > 0 -%}
    <div class="lp-benefits__grid">
      {%- for block in section.blocks -%}
        <div class="lp-benefit" {{ block.shopify_attributes }}>
          <div class="lp-benefit__icon" aria-hidden="true">
            {%- assign icon_key = block.settings.icon | downcase | strip -%}
            {%- case icon_key -%}
              {%- when '⚡', 'fastwear', 'zap', 'lightning' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              {%- when '☁️', 'comfort', 'cloud', 'soft' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              {%- when '🛡️', 'sicurezza', 'safety', 'shield' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
              {%- when '✨', 'eleganza', 'elegance', 'star' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            {%- endcase -%}
          </div>
          <div>
            <div class="lp-benefit__title">{{ block.settings.title }}</div>
            <div class="lp-benefit__text">{{ block.settings.text }}</div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if img1 != blank or img2 != blank -%}
    <div class="lp-benefits__photos">
      {%- if img1 != blank -%}
        <div class="lp-benefits__photo-wrap">
          {{ img1 | image_url: width: 600 | image_tag: class: 'lp-benefits__photo', loading: 'lazy', widths: '300,400,600', sizes: '45vw', alt: img1.alt }}
        </div>
      {%- endif -%}
      {%- if img2 != blank -%}
        <div class="lp-benefits__photo-wrap">
          {{ img2 | image_url: width: 600 | image_tag: class: 'lp-benefits__photo', loading: 'lazy', widths: '300,400,600', sizes: '45vw', alt: img2.alt }}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}

.lp-benefits {
  padding: 56px 22px;
  background: #000;
  color: #fff;
}

.lp-benefits__eyebrow {
  color: #F5C200;
}

.lp-benefits__h2 {
  color: #fff;
}

.lp-benefits__grid {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 32px;
}

.lp-benefit {
  display: flex;
  gap: 16px;
  align-items: flex-start;
  padding: 18px 16px;
  border: 1px solid rgba(255,255,255,0.08);
  border-left: 3px solid #F5C200;
  border-radius: 10px;
  background: rgba(255,255,255,0.03);
}

.lp-benefit__icon {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  border-radius: 9px;
  background: rgba(245,194,0,0.1);
  border: 1px solid rgba(245,194,0,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #F5C200;
}

.lp-benefit__icon svg {
  width: 20px;
  height: 20px;
  stroke: #F5C200;
}

.lp-benefit__title {
  font-size: 0.88rem;
  font-weight: 800;
  color: #fff;
  letter-spacing: 0.03em;
  margin-bottom: 4px;
  text-transform: uppercase;
  font-family: var(--font-heading--family, inherit);
}

.lp-benefit__text {
  font-size: 0.8rem;
  color: rgba(255,255,255,0.6);
  line-height: 1.55;
}

.lp-benefits__photos {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.lp-benefits__photo-wrap {
  border-radius: 8px;
  overflow: hidden;
}

.lp-benefits__photo {
  width: 100%;
  height: auto;
  display: block;
  aspect-ratio: 4/5;
  object-fit: cover;
}

@media (min-width: 750px) {
  .lp-benefits {
    padding: 80px 60px;
  }

  .lp-benefits__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "LP — Benefits",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Dr Kampes Trucker Shoes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo sezione",
      "default": "Quattro vantaggi che cambiano il tuo modo di lavorare."
    },
    {
      "type": "header",
      "content": "Foto prodotto"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Foto scarpa (variante 1)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Foto scarpa (variante 2)"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji icona",
          "default": "⚡"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titolo benefit"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Descrizione benefit"
        }
      ]
    }
  ],
  "presets": [{ "name": "LP — Benefits" }]
}
{% endschema %}
