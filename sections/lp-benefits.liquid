<section class="lp-benefits">
  <div class="lp-benefits__inner">

    <div class="lp-benefits__top">
      <div class="lp-benefits__head">
        {%- if section.settings.eyebrow != blank -%}
          <div class="lp-benefits__eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}

        {%- if section.settings.heading_white != blank or section.settings.heading_gold != blank -%}
          <h2 class="lp-benefits__h2">
            {%- if section.settings.heading_white != blank -%}
              <span class="lp-benefits__h2-line">{{ section.settings.heading_white | newline_to_br }}</span>
            {%- endif -%}
            {%- if section.settings.heading_gold != blank -%}
              <span class="lp-benefits__h2-line lp-benefits__h2-line--gold">{{ section.settings.heading_gold | newline_to_br }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}

        {%- if section.settings.sub_text != blank -%}
          <div class="lp-benefits__sub">{{ section.settings.sub_text }}</div>
        {%- endif -%}
      </div>

      {%- if section.settings.shoe_image_url != blank -%}
        <div class="lp-benefits__shoe">
          <img src="{{ section.settings.shoe_image_url }}" alt="Scarpa Dr.Kampes" loading="lazy" decoding="async">
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="lp-benefits__list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'feature' -%}
            <li class="lp-benefit-row" {{ block.shopify_attributes }}>
              <span class="lp-benefit-row__icon" aria-hidden="true">
                {%- if block.settings.icon_url != blank -%}
                  <img src="{{ block.settings.icon_url }}" alt="" loading="lazy" decoding="async">
                {%- endif -%}
              </span>
              <div class="lp-benefit-row__body">
                <div class="lp-benefit-row__title-line">
                  <strong class="lp-benefit-row__title">{{ block.settings.title }}</strong>
                  {%- if block.settings.title_suffix != blank -%}
                    <span class="lp-benefit-row__sep" aria-hidden="true"> &mdash; </span>
                    <span class="lp-benefit-row__suffix">{{ block.settings.title_suffix }}</span>
                  {%- endif -%}
                </div>
                {%- if block.settings.text != blank -%}
                  <p class="lp-benefit-row__text">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- assign has_cabin = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'cabin' -%}
        {%- assign has_cabin = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_cabin -%}
      <div class="lp-benefits__cabin">
        {%- if section.settings.cabin_heading != blank -%}
          <h3 class="lp-benefits__cabin-heading">{{ section.settings.cabin_heading }}</h3>
        {%- endif -%}
        <div class="lp-benefits__cabin-grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'cabin' -%}
              <div class="lp-cabin-card" {{ block.shopify_attributes }}>
                {%- if block.settings.icon_url != blank -%}
                  <div class="lp-cabin-card__icon">
                    <img src="{{ block.settings.icon_url }}" alt="" loading="lazy" decoding="async">
                  </div>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <h4 class="lp-cabin-card__title">{{ block.settings.title | newline_to_br }}</h4>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="lp-cabin-card__text">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}

.lp-benefits {
  --lp-gold: #D4A017;
  --lp-gold-soft: rgba(212, 160, 23, 0.5);
  background: #000;
  color: #fff;
  padding: 36px 18px 40px;
  overflow: hidden;
}

.lp-benefits__inner {
  max-width: 1100px;
  margin: 0 auto;
}

/* ── Top: heading + shoe image ── */
.lp-benefits__top {
  position: relative;
  display: grid;
  grid-template-columns: 1fr;
  gap: 0;
  padding-bottom: 22px;
  border-bottom: 2px solid var(--lp-gold);
  margin-bottom: 18px;
  overflow: hidden;
}

.lp-benefits__shoe {
  position: absolute;
  top: -8px;
  right: -56px;
  width: 88%;
  max-width: 460px;
  pointer-events: none;
  z-index: 0;
  -webkit-mask-image:
    linear-gradient(to bottom, rgba(0,0,0,0) 0%, #000 22%, #000 60%, rgba(0,0,0,0) 100%),
    linear-gradient(to right, #000 0%, #000 60%, rgba(0,0,0,0) 100%);
  mask-image:
    linear-gradient(to bottom, rgba(0,0,0,0) 0%, #000 22%, #000 60%, rgba(0,0,0,0) 100%),
    linear-gradient(to right, #000 0%, #000 60%, rgba(0,0,0,0) 100%);
  -webkit-mask-composite: source-in;
  mask-composite: intersect;
}

.lp-benefits__shoe img {
  display: block;
  width: 100%;
  height: auto;
  object-fit: contain;
}

.lp-benefits__head {
  position: relative;
  z-index: 1;
}

.lp-benefits__eyebrow {
  font-family: 'Inter', sans-serif;
  font-weight: 800;
  color: var(--lp-gold);
  font-size: 0.74rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  line-height: 1.2;
  margin: 0 0 12px;
}

.lp-benefits__h2 {
  font-family: 'Archivo Black', 'Inter', sans-serif;
  font-size: 1.85rem;
  line-height: 1.0;
  letter-spacing: -0.005em;
  color: #fff;
  margin: 0 0 14px;
  text-transform: uppercase;
  display: flex;
  flex-direction: column;
}

.lp-benefits__h2-line { display: block; max-width: 12ch; }
.lp-benefits__h2-line--gold { color: var(--lp-gold); }

.lp-benefits__sub {
  font-size: 0.92rem;
  line-height: 1.45;
  color: rgba(255,255,255,0.85);
  max-width: 38ch;
  margin: 0;
}
.lp-benefits__sub p { margin: 0 0 4px; }
.lp-benefits__sub p:last-child { margin: 0; }
.lp-benefits__sub strong { color: #fff; font-weight: 700; }

/* ── Feature list (6 rows) ── */
.lp-benefits__list {
  list-style: none;
  margin: 0 0 22px;
  padding: 0;
  display: flex;
  flex-direction: column;
}

.lp-benefit-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 0;
  border-bottom: 1px solid rgba(255,255,255,0.12);
}

.lp-benefit-row:last-child {
  border-bottom: none;
}

.lp-benefit-row__icon {
  position: relative;
  width: 52px;
  height: 52px;
  flex-shrink: 0;
  border-radius: 50%;
  background: transparent;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4px;
  box-sizing: border-box;
}

.lp-benefit-row__icon::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.45);
  pointer-events: none;
  z-index: 2;
}

.lp-benefit-row__icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
  position: relative;
  z-index: 1;
}

.lp-benefit-row__body {
  flex: 1;
  min-width: 0;
}

.lp-benefit-row__title-line {
  font-size: 0.92rem;
  line-height: 1.2;
  margin: 0 0 1px;
}

.lp-benefit-row__title {
  font-family: 'Inter', sans-serif;
  font-weight: 900;
  color: #fff;
  letter-spacing: 0.02em;
  text-transform: uppercase;
}

.lp-benefit-row__sep {
  color: rgba(255,255,255,0.5);
  font-weight: 400;
}

.lp-benefit-row__suffix {
  color: rgba(255,255,255,0.85);
  font-weight: 500;
}

.lp-benefit-row__text {
  margin: 0;
  font-size: 0.82rem;
  line-height: 1.35;
  color: rgba(255,255,255,0.65);
}

/* ── Cabin white card ── */
.lp-benefits__cabin {
  position: relative;
  background:
    radial-gradient(120% 70% at 50% 0%, rgba(212,160,23,0.06) 0%, rgba(212,160,23,0) 60%),
    linear-gradient(180deg, #ffffff 0%, #faf6ec 100%);
  border-radius: 14px;
  padding: 22px 14px 18px;
  color: #1a1a1a;
  box-shadow:
    0 1px 0 rgba(255,255,255,0.6) inset,
    0 12px 32px rgba(0,0,0,0.18),
    0 2px 6px rgba(0,0,0,0.08);
  overflow: hidden;
}

.lp-benefits__cabin::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 64%;
  max-width: 220px;
  height: 3px;
  background: var(--lp-gold);
  border-radius: 0 0 4px 4px;
}

.lp-benefits__cabin-heading {
  font-family: 'Archivo Black', 'Inter', sans-serif;
  font-weight: 900;
  font-size: 1rem;
  line-height: 1.15;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  text-align: center;
  color: #000;
  margin: 0 auto 4px;
  max-width: 22ch;
  text-wrap: balance;
}

.lp-benefits__cabin-heading::after {
  content: '';
  display: block;
  width: 36px;
  height: 2px;
  background: var(--lp-gold);
  margin: 8px auto 0;
}

.lp-benefits__cabin-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 0;
  row-gap: 0;
  margin-top: 10px;
}

.lp-cabin-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 4px;
  padding: 12px 8px;
  position: relative;
}

.lp-cabin-card:nth-child(odd) {
  border-right: 1px solid rgba(0,0,0,0.08);
}

.lp-cabin-card:nth-child(-n+2) {
  border-bottom: 1px solid rgba(0,0,0,0.08);
}

.lp-cabin-card__icon {
  position: relative;
  width: 64px;
  height: 64px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4px;
}

.lp-cabin-card__icon::before {
  content: '';
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(212,160,23,0.18) 0%, rgba(212,160,23,0) 70%);
  z-index: 0;
}

.lp-cabin-card__icon img {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
  mix-blend-mode: multiply;
}

.lp-cabin-card__title {
  font-family: 'Archivo Black', 'Inter', sans-serif;
  font-weight: 900;
  font-size: 0.85rem;
  letter-spacing: 0.04em;
  line-height: 1.2;
  text-transform: uppercase;
  color: #000;
  margin: 0;
}

.lp-cabin-card__text {
  font-family: 'Inter', sans-serif;
  font-size: 0.78rem;
  line-height: 1.4;
  color: #4a4a4a;
  margin: 0;
}

/* ── Tablet ≥ 750px ── */
@media (min-width: 750px) {
  .lp-benefits {
    padding: 64px 40px 72px;
  }

  .lp-benefits__top {
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 32px;
    padding-bottom: 32px;
    margin-bottom: 28px;
  }

  .lp-benefits__shoe {
    position: relative;
    top: auto;
    right: auto;
    width: 460px;
    max-width: 100%;
    justify-self: end;
  }

  .lp-benefits__eyebrow { font-size: 0.92rem; margin-bottom: 14px; }
  .lp-benefits__h2 { font-size: 3rem; line-height: 0.98; margin-bottom: 18px; }
  .lp-benefits__h2-line { max-width: 18ch; }
  .lp-benefits__sub { font-size: 1.02rem; max-width: 46ch; }

  .lp-benefits__list { margin-bottom: 40px; }

  .lp-benefit-row {
    gap: 14px;
    padding: 12px 0;
  }

  .lp-benefit-row__icon {
    width: 64px;
    height: 64px;
    padding: 5px;
  }
  .lp-benefit-row__icon img {
    width: 100%;
    height: 100%;
  }

  .lp-benefit-row__title-line { font-size: 1.12rem; margin-bottom: 2px; }
  .lp-benefit-row__text { font-size: 0.95rem; }

  .lp-benefits__cabin {
    padding: 18px 18px;
    border-radius: 18px;
  }

  .lp-benefits__cabin-heading {
    font-size: 1.2rem;
    margin-bottom: 14px;
    max-width: 22ch;
  }

  .lp-benefits__cabin-grid {
    grid-template-columns: repeat(4, 1fr);
    column-gap: 0;
    row-gap: 0;
  }

  .lp-cabin-card {
    gap: 6px;
    padding: 4px 12px;
  }

  .lp-cabin-card:nth-child(odd) { border-right: none; }
  .lp-cabin-card:nth-child(-n+2) { border-bottom: none; }
  .lp-cabin-card:not(:last-child) {
    border-right: 1px solid rgba(0,0,0,0.12);
  }

  .lp-cabin-card__icon { width: 88px; height: 88px; }
  .lp-cabin-card__title { font-size: 0.95rem; }
  .lp-cabin-card__text { font-size: 0.88rem; }
}

/* ── Desktop ≥ 1100px ── */
@media (min-width: 1100px) {
  .lp-benefits { padding: 88px 56px 104px; }
  .lp-benefits__inner { max-width: 1280px; }

  .lp-benefits__top {
    grid-template-columns: 1.1fr auto;
    gap: 56px;
    padding-bottom: 40px;
    margin-bottom: 40px;
  }
  .lp-benefits__h2 { font-size: 3.6rem; margin-bottom: 22px; }
  .lp-benefits__sub { font-size: 1.08rem; max-width: 52ch; }
  .lp-benefits__shoe { width: 460px; }

  .lp-benefits__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 64px;
    row-gap: 0;
    margin-bottom: 56px;
  }
  .lp-benefit-row { padding: 18px 0; }
  .lp-benefit-row:nth-last-child(-n+2) { border-bottom: none; }
  .lp-benefit-row__icon { width: 72px; height: 72px; }
  .lp-benefit-row__title-line { font-size: 1.2rem; }
  .lp-benefit-row__text { font-size: 1rem; }

  .lp-benefits__cabin { padding: 28px 28px; }
  .lp-benefits__cabin-heading { font-size: 1.35rem; margin-bottom: 18px; }
  .lp-cabin-card { padding: 8px 20px; }
  .lp-cabin-card__icon { width: 100px; height: 100px; }
  .lp-cabin-card__title { font-size: 1.05rem; }
  .lp-cabin-card__text { font-size: 0.95rem; }
}

{% endstylesheet %}

{% schema %}
