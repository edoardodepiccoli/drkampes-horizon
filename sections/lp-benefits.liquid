<section class="lp-benefits">
  <div class="lp-benefits__inner">

    {%- if section.settings.eyebrow != blank -%}
      <div class="lp-sec__eyebrow lp-benefits__eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}

    <h2 class="lp-sec__h2 lp-benefits__h2">{{ section.settings.heading }}</h2>

    {%- if section.settings.uvp != blank -%}
      <p class="lp-benefits__uvp">{{ section.settings.uvp }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="lp-benefits__list">
        {%- for block in section.blocks -%}
          <li class="lp-benefit" {{ block.shopify_attributes }}>
            <svg class="lp-benefit__check" viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="lp-benefit__body">
              <strong class="lp-benefit__title">{{ block.settings.title }}</strong>
              {%- if block.settings.text != blank -%}
                <span class="lp-benefit__sep" aria-hidden="true"> — </span>
                <span class="lp-benefit__text">{{ block.settings.text }}</span>
              {%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}

.lp-benefits {
  padding: 32px 16px 36px;
  background: #000;
  color: #fff;
}

.lp-benefits__inner {
  max-width: 580px;
  margin: 0 auto;
}

.lp-benefits .lp-sec__eyebrow {
  color: #F5C200;
  margin-bottom: 8px;
}

.lp-benefits .lp-sec__h2 {
  color: #fff;
  font-size: 1.4rem;
  margin: 0 0 8px;
}

.lp-benefits__uvp {
  font-size: 0.88rem;
  color: rgba(255,255,255,0.7);
  line-height: 1.45;
  margin: 0 0 18px;
  max-width: 540px;
}

.lp-benefits__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.lp-benefit {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 0;
  font-size: 0.88rem;
  color: rgba(255,255,255,0.85);
  line-height: 1.4;
}

.lp-benefit__check {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  stroke: #F5C200;
  margin-top: 2px;
}

.lp-benefit__body {
  display: inline;
}

.lp-benefit__title {
  color: #fff;
  font-weight: 800;
  letter-spacing: 0.01em;
}

.lp-benefit__sep {
  color: rgba(255,255,255,0.4);
}

.lp-benefit__text {
  color: rgba(255,255,255,0.65);
}

@media (min-width: 750px) {
  .lp-benefits {
    padding: 56px 40px 64px;
  }
  .lp-benefits__inner {
    max-width: 1100px;
  }
  .lp-benefits .lp-sec__h2 {
    font-size: 1.8rem;
  }
  .lp-benefits__uvp {
    font-size: 1rem;
    margin-bottom: 24px;
  }
  .lp-benefits__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 32px;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "LP — Benefits",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Perché Dr Kampes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo sezione",
      "default": "Le scarpe per chi guida un mezzo, sul serio."
    },
    {
      "type": "textarea",
      "id": "uvp",
      "label": "UVP (frase di valore breve)",
      "default": "L'unica antinfortunistica progettata dagli autisti, per gli autisti. FASTWEAR®, 3 anni di garanzia, 100% Made in Italy."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titolo benefit"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Descrizione breve (1 riga ideale)"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "(deprecato — non più usato)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP — Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "title": "FASTWEAR®",                 "text": "on/off in 1 secondo, senza lacci" } },
        { "type": "benefit", "settings": { "title": "3 anni di garanzia scritta", "text": "1.095 giorni coperti, €0,17 al giorno" } },
        { "type": "benefit", "settings": { "title": "100% Made in Italy",         "text": "Montebelluna, Treviso" } },
        { "type": "benefit", "settings": { "title": "Idrorepellenti certificate", "text": "pioggia, fango, sale stradale" } },
        { "type": "benefit", "settings": { "title": "Plantare anti-vibrazione",   "text": "10h di guida senza dolore" } },
        { "type": "benefit", "settings": { "title": "S3S grado massimo UE",       "text": "antiscivolo gasolio, lamiera, ghiaccio" } }
      ]
    }
  ]
}
{% endschema %}
