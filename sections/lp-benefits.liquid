{%- assign img1 = section.settings.image_1 -%}
{%- assign img2 = section.settings.image_2 -%}

<section class="lp-benefits">
  {%- if section.settings.eyebrow != blank -%}
    <div class="lp-sec__eyebrow lp-benefits__eyebrow">{{ section.settings.eyebrow }}</div>
  {%- endif -%}

  <h2 class="lp-sec__h2 lp-benefits__h2">{{ section.settings.heading }}</h2>

  {%- if section.blocks.size > 0 -%}
    <div class="lp-benefits__grid">
      {%- for block in section.blocks -%}
        <div class="lp-benefit" {{ block.shopify_attributes }}>
          <div class="lp-benefit__icon" aria-hidden="true">{{ block.settings.icon }}</div>
          <div>
            <div class="lp-benefit__title">{{ block.settings.title }}</div>
            <div class="lp-benefit__text">{{ block.settings.text }}</div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if img1 != blank or img2 != blank -%}
    <div class="lp-benefits__photos">
      {%- if img1 != blank -%}
        <div class="lp-benefits__photo-wrap">
          {{ img1 | image_url: width: 600 | image_tag: class: 'lp-benefits__photo', loading: 'lazy', widths: '300,400,600', sizes: '45vw', alt: img1.alt }}
        </div>
      {%- endif -%}
      {%- if img2 != blank -%}
        <div class="lp-benefits__photo-wrap">
          {{ img2 | image_url: width: 600 | image_tag: class: 'lp-benefits__photo', loading: 'lazy', widths: '300,400,600', sizes: '45vw', alt: img2.alt }}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}

.lp-benefits {
  padding: 56px 22px;
  background: #0d0d0d;
  color: #fff;
}

.lp-benefits__eyebrow {
  color: #F5C200;
}

.lp-benefits__h2 {
  color: #fff;
}

.lp-benefits__grid {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 32px;
}

.lp-benefit {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  padding: 16px;
  border: 1px solid rgba(255,255,255,0.09);
  border-radius: 10px;
  background: rgba(255,255,255,0.04);
}

.lp-benefit__icon {
  width: 42px;
  height: 42px;
  flex-shrink: 0;
  border-radius: 9px;
  background: rgba(245,194,0,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
}

.lp-benefit__title {
  font-size: 0.88rem;
  font-weight: 800;
  color: #fff;
  letter-spacing: 0.03em;
  margin-bottom: 4px;
  text-transform: uppercase;
  font-family: var(--font-heading--family, inherit);
}

.lp-benefit__text {
  font-size: 0.8rem;
  color: rgba(255,255,255,0.6);
  line-height: 1.55;
}

.lp-benefits__photos {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.lp-benefits__photo-wrap {
  border-radius: 8px;
  overflow: hidden;
}

.lp-benefits__photo {
  width: 100%;
  height: auto;
  display: block;
  aspect-ratio: 4/5;
  object-fit: cover;
}

@media (min-width: 750px) {
  .lp-benefits {
    padding: 80px 60px;
  }

  .lp-benefits__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "LP — Benefits",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Dr Kampes Trucker Shoes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo sezione",
      "default": "Quattro vantaggi che cambiano il tuo modo di lavorare."
    },
    {
      "type": "header",
      "content": "Foto prodotto"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Foto scarpa (variante 1)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Foto scarpa (variante 2)"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji icona",
          "default": "⚡"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titolo benefit"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Descrizione benefit"
        }
      ]
    }
  ],
  "presets": [{ "name": "LP — Benefits" }]
}
{% endschema %}
