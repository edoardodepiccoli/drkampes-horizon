    {
      "type": "textarea",
      "id": "heading",
      "label": "Titolo",
      "default": "LA LIVREA CONTINUA AI PIEDI DEI TUOI AUTISTI."
    }
  ],
  "blocks": [
    {
      "type": "livery",
      "name": "Livrea",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Numero badge",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titolo livrea"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Descrizione"
        },
        {
          "type": "color",
          "id": "color_1",
          "label": "Colore 1",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "color_2",
          "label": "Colore 2",
          "default": "#E8B82E"
        },
        {
          "type": "color",
          "id": "badge_bg",
          "label": "Sfondo badge numero",
          "default": "#E8B82E"
        },
        {
          "type": "color",
          "id": "badge_text",
          "label": "Testo badge numero",
          "default": "#111111"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Immagine camion + scarpa"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link CTA (freccia)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP B2B — Livrea",
      "blocks": [
        { "type": "livery", "settings": { "number": "01", "title": "NERO + GIALLO",  "text": "Aggressiva, visibile, stile racing.", "color_1": "#000000", "color_2": "#E8B82E", "badge_bg": "#E8B82E", "badge_text": "#111111" }},
        { "type": "livery", "settings": { "number": "02", "title": "BIANCO + ROSSO", "text": "Classica, pulita, ad alta visibilità.", "color_1": "#FFFFFF", "color_2": "#C0192A", "badge_bg": "#C0192A", "badge_text": "#FFFFFF" }},
        { "type": "livery", "settings": { "number": "03", "title": "BLU + BIANCO",   "text": "Professionale, affidabile, istituzionale.", "color_1": "#1B3D8C", "color_2": "#FFFFFF", "badge_bg": "#1B3D8C", "badge_text": "#FFFFFF" }},
        { "type": "livery", "settings": { "number": "04", "title": "VERDE + ORO",    "text": "Distintiva, ricercata, premium.", "color_1": "#2D5C3E", "color_2": "#C9A227", "badge_bg": "#2D5C3E", "badge_text": "#FFFFFF" }}
      ]
    }
  ]
}
{% endschema %}
