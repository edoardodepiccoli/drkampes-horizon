{%- assign hero_bg = section.settings.bg_image -%}

<section class="lp-b2b-livery">

  <div class="lp-b2b-livery__hero">
    {%- if hero_bg != blank -%}
      {{ hero_bg | image_url: width: 2000 | image_tag:
         class: 'lp-b2b-livery__bg',
         loading: 'lazy',
         widths: '800,1200,1600,2000',
         sizes: '100vw',
         alt: hero_bg.alt | default: section.settings.heading }}
    {%- endif -%}
    <div class="lp-b2b-livery__hero-overlay">
      {%- if section.settings.heading != blank -%}
        <h2 class="lp-b2b-livery__heading">{{ section.settings.heading | newline_to_br }}</h2>
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="lp-b2b-livery__cards">
      {%- for block in section.blocks -%}
        {%- if block.type == 'livery' -%}
          {%- assign card_link = block.settings.link -%}
          <article class="lp-b2b-livery__card" {{ block.shopify_attributes }}>

            <div class="lp-b2b-livery__card-text">
              {%- if block.settings.number != blank -%}
                <span
                  class="lp-b2b-livery__badge"
                  style="background-color: {{ block.settings.badge_bg | default: '#E8B82E' }}; color: {{ block.settings.badge_text | default: '#111111' }};"
                >{{ block.settings.number }}</span>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="lp-b2b-livery__title">{{ block.settings.title | newline_to_br }}</h3>
              {%- endif -%}
              <span class="lp-b2b-livery__rule" aria-hidden="true"></span>
              {%- if block.settings.text != blank -%}
                <p class="lp-b2b-livery__text">{{ block.settings.text | newline_to_br }}</p>
              {%- endif -%}
              {%- if block.settings.color_1 != blank or block.settings.color_2 != blank -%}
                <div class="lp-b2b-livery__swatches" aria-hidden="true">
                  {%- if block.settings.color_1 != blank -%}
                    <span class="lp-b2b-livery__swatch" style="background-color: {{ block.settings.color_1 }};"></span>
                  {%- endif -%}
                  {%- if block.settings.color_2 != blank -%}
                    <span class="lp-b2b-livery__swatch" style="background-color: {{ block.settings.color_2 }};"></span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>

            {%- if block.settings.image != blank -%}
              <div class="lp-b2b-livery__media">
                {{ block.settings.image | image_url: width: 1400 | image_tag:
                   class: 'lp-b2b-livery__img',
                   loading: 'lazy',
                   widths: '600,900,1200,1400',
                   sizes: '(min-width:1100px) 55vw, 100vw',
                   alt: block.settings.image.alt | default: block.settings.title }}
              </div>
            {%- endif -%}

            {%- if card_link != blank -%}
              <a class="lp-b2b-livery__arrow" href="{{ card_link }}" aria-label="{{ block.settings.title | default: 'Vedi livrea' }}">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m9 6 6 6-6 6"/>
                </svg>
              </a>
            {%- else -%}
              <span class="lp-b2b-livery__arrow lp-b2b-livery__arrow--static" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m9 6 6 6-6 6"/>
                </svg>
              </span>
            {%- endif -%}

          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

</section>

{% stylesheet %}

.lp-b2b-livery {
  --b2b-gold:        #E8B82E;
  --b2b-gold-light:  #FFD84D;
  --b2b-gold-dark:   #B8881A;
  --b2b-gold-faint:  rgba(232, 184, 46, 0.25);
  background: #000;
  color: #fff;
}

/* ── Hero band (bg + headline) ── */
.lp-b2b-livery__hero {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  min-height: 260px;
  overflow: hidden;
  background: #0a0a0a;
}

.lp-b2b-livery__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  z-index: 0;
}

.lp-b2b-livery__hero::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:
    linear-gradient(to bottom,
      rgba(0,0,0,0.5) 0%,
      rgba(0,0,0,0.15) 25%,
      rgba(0,0,0,0) 45%,
      rgba(0,0,0,0.4) 70%,
      rgba(0,0,0,0.85) 88%,
      #000 100%);
}

.lp-b2b-livery__hero-overlay {
  position: relative;
  z-index: 2;
  height: 100%;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  padding: 24px 20px;
}

.lp-b2b-livery__heading {
  font-family: 'Archivo Black', 'Inter', sans-serif;
  font-size: 1.7rem;
  line-height: 0.95;
  letter-spacing: -0.01em;
  color: #fff;
  margin: 0;
  text-transform: uppercase;
  max-width: 14ch;
  text-align: right;
}

/* ── Cards stack ── */
.lp-b2b-livery__cards {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 0 12px;
  margin-top: -56px;
}

.lp-b2b-livery__card {
  position: relative;
  display: grid;
  grid-template-columns: 1fr;
  grid-template-areas:
    "text"
    "media";
  padding: 14px 16px 16px;
  border: 1px solid var(--b2b-gold-faint);
  border-radius: 12px;
  background: #000;
  gap: 8px;
}

.lp-b2b-livery__card-text {
  grid-area: text;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
}

.lp-b2b-livery__badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-family: 'Archivo Black', 'Inter', sans-serif;
  font-size: 0.78rem;
  font-weight: 900;
  letter-spacing: 0.04em;
  padding: 4px 10px;
  border-radius: 4px;
  line-height: 1;
}

.lp-b2b-livery__title {
  font-family: 'Archivo Black', 'Inter', sans-serif;
  font-size: 1.2rem;
  line-height: 1;
  color: #fff;
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0;
}

.lp-b2b-livery__rule {
  display: block;
  width: 56px;
  height: 1.5px;
  background: var(--b2b-gold);
  margin: 1px 0 2px;
}

.lp-b2b-livery__text {
  font-family: 'Inter', sans-serif;
  font-size: 0.85rem;
  font-weight: 500;
  line-height: 1.3;
  color: #fff;
  margin: 0;
  max-width: 38ch;
}

.lp-b2b-livery__swatches {
  display: flex;
  gap: 5px;
  margin-top: 2px;
}

.lp-b2b-livery__swatch {
  display: block;
  width: 38px;
  height: 14px;
  border-radius: 3px;
  border: 1px solid rgba(255,255,255,0.35);
}

/* ── Media (truck + shoe combo image) — zoomed ── */
.lp-b2b-livery__media {
  grid-area: media;
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 6;
  overflow: hidden;
}

.lp-b2b-livery__img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  display: block;
}

/* ── Arrow button ── */
.lp-b2b-livery__arrow {
  position: absolute;
  top: 18px;
  right: 18px;
  width: 44px;
  height: 44px;
  border: 1.5px solid var(--b2b-gold);
  border-radius: 50%;
  background: rgba(0,0,0,0.4);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  flex-shrink: 0;
  transition: background 0.15s, transform 0.15s;
}
.lp-b2b-livery__arrow:hover {
  background: rgba(232, 184, 46, 0.15);
  text-decoration: none;
}
.lp-b2b-livery__arrow:active {
  transform: scale(0.96);
}
.lp-b2b-livery__arrow svg {
  width: 20px;
  height: 20px;
  stroke: var(--b2b-gold);
}
.lp-b2b-livery__arrow--static { pointer-events: none; }

/* ── Tablet ≥ 750px ── */
@media (min-width: 750px) {
  .lp-b2b-livery__hero {
    aspect-ratio: 21 / 9;
    min-height: 340px;
  }
  .lp-b2b-livery__hero-overlay { padding: 40px 48px; }
  .lp-b2b-livery__heading {
    font-size: 2.6rem;
    max-width: 18ch;
  }

  .lp-b2b-livery__cards {
    margin-top: -72px;
    padding: 0 32px;
    gap: 16px;
  }

  .lp-b2b-livery__card {
    grid-template-columns: minmax(200px, 1fr) 1.8fr;
    grid-template-areas: "text media";
    align-items: center;
    padding: 18px 32px;
    gap: 20px;
    border-radius: 14px;
  }

  .lp-b2b-livery__title { font-size: 1.5rem; }
  .lp-b2b-livery__text { font-size: 0.95rem; }
  .lp-b2b-livery__rule { width: 72px; }
  .lp-b2b-livery__swatch { width: 46px; height: 18px; }

  .lp-b2b-livery__media {
    aspect-ratio: 16 / 6;
  }

  .lp-b2b-livery__arrow {
    position: absolute;
    top: 50%;
    right: 24px;
    transform: translateY(-50%);
    width: 46px;
    height: 46px;
  }
  .lp-b2b-livery__arrow svg { width: 22px; height: 22px; }
}

/* ── Desktop ≥ 1100px ── */
@media (min-width: 1100px) {
  .lp-b2b-livery__hero {
    aspect-ratio: 21 / 7;
    min-height: 420px;
  }
  .lp-b2b-livery__hero-overlay { padding: 56px 64px; }
  .lp-b2b-livery__heading {
    font-size: 3.8rem;
    max-width: 22ch;
  }

  .lp-b2b-livery__cards {
    margin-top: -96px;
    padding: 0 48px;
    gap: 20px;
  }

  .lp-b2b-livery__card {
    grid-template-columns: minmax(260px, 1fr) 2fr 72px;
    grid-template-areas: "text media arrow";
    padding: 24px 40px;
    gap: 32px;
    border-radius: 16px;
  }

  .lp-b2b-livery__title { font-size: 1.8rem; }
  .lp-b2b-livery__text { font-size: 1rem; }
  .lp-b2b-livery__rule { width: 84px; height: 2px; }
  .lp-b2b-livery__badge { font-size: 0.82rem; padding: 4px 11px; }
  .lp-b2b-livery__swatch { width: 54px; height: 20px; }

  .lp-b2b-livery__media {
    aspect-ratio: 16 / 6;
  }

  .lp-b2b-livery__arrow {
    position: static;
    transform: none;
    grid-area: arrow;
    justify-self: center;
    align-self: center;
    width: 56px;
    height: 56px;
  }
  .lp-b2b-livery__arrow svg { width: 24px; height: 24px; }
}

{% endstylesheet %}

{% schema %}
{
  "name": "LP B2B — Livrea",
  "settings": [
    {
      "type": "header",
      "content": "Hero band"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Immagine di sfondo (scarpa + ambiente)"
