{% assign product = section.settings.product %}
{% assign first_variant = product.selected_or_first_available_variant %}
{% if product == blank %}
  <div style="padding:2rem;text-align:center;color:#888;">Nessun prodotto selezionato</div>
{% else %}

<div class="hbs" id="acquista" data-hbs-id="{{ section.id }}">

  <script type="application/json" id="hbs-variants-{{ section.id }}">
    {{ product.variants | json }}
  </script>

  <script type="application/json" id="hbs-vg-{{ section.id }}">
    {
      {%- for variant in product.variants -%}
        {%- unless forloop.first -%},{%- endunless -%}
        "{{ variant.id }}": [
          {%- assign vg_files = variant.metafields.custom.variant_gallery.value -%}
          {%- if vg_files != blank -%}
            {%- assign first_hit = true -%}
            {%- for vg_file in vg_files -%}
              {%- for media in product.media -%}
                {%- if vg_file.image.src == media.src -%}
                  {%- unless first_hit -%},{%- endunless -%}
                  {{ media.id }}
                  {%- assign first_hit = false -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          {%- endif -%}
        ]
      {%- endfor -%}
    }
  </script>

  <div class="hbs__gallery">
    <div class="hbs__main">
      {%- for media in product.media -%}
        <div
          class="hbs__slide{% if forloop.first %} hbs__slide--active{% endif %}"
          data-media-id="{{ media.id }}"
        >
          {%- if forloop.first -%}
            {{ media | image_url: width: 800 | image_tag: class: 'hbs__img', loading: 'eager', widths: '400,600,800', sizes: '(max-width:749px) 100vw, 50vw' }}
          {%- else -%}
            {{ media | image_url: width: 800 | image_tag: class: 'hbs__img', loading: 'lazy', widths: '400,600,800', sizes: '(max-width:749px) 100vw, 50vw' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="hbs__thumbs">
      {%- for media in product.media -%}
        <button
          type="button"
          class="hbs__thumb{% if forloop.first %} hbs__thumb--active{% endif %}"
          data-index="{{ forloop.index0 }}"
          data-media-id="{{ media.id }}"
          aria-label="Immagine {{ forloop.index }}"
        >{{ media | image_url: width: 120 | image_tag: class: 'hbs__thumb-img', loading: 'lazy' }}</button>
      {%- endfor -%}
    </div>
  </div>

  <div class="hbs__details">

    <div class="hbs__head">
      <h2 class="hbs__title">{{ product.title }}</h2>
      <p class="hbs__sub">Antinfortunistiche S3S</p>
    </div>

    <div class="hbs__social">
      <span class="hbs__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
      <span class="hbs__review-lbl">4.9 &bull; <strong>127 clienti soddisfatti</strong></span>
    </div>

    <div class="hbs__price-wrap">
      <p class="hbs__price">
        <span class="hbs__price-main">&euro; {{ product.price | money_without_currency }}</span>
        <span class="hbs__price-tax">IVA INCLUSA</span>
      </p>
      <p class="hbs__installment">oppure <strong>&euro;63&times;3</strong> a Rate con Klarna e PayPal</p>
    </div>

    <div class="hbs__trust">
      <div class="hbs__trust-item">
        <svg class="hbs__trust-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        <span>3 anni di<br>garanzia</span>
      </div>
      <div class="hbs__trust-item">
        <svg class="hbs__trust-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="1 4 1 10 7 10"/><polyline points="23 20 23 14 17 14"/><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4-4.64 4.36A9 9 0 0 1 3.51 15"/></svg>
        <span>Reso e Cambio<br>taglia Gratis</span>
      </div>
      <div class="hbs__trust-item">
        <svg class="hbs__trust-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v4h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        <span>Spedizione<br>48/72 ore</span>
      </div>
    </div>

    {%- assign form_id = 'hbs-form-' | append: section.id -%}
    {% form 'product', product, id: form_id, class: 'hbs__form' %}
      <input type="hidden" name="id" id="hbs-vid-{{ section.id }}" value="{{ first_variant.id }}">

      {%- assign color_option = nil -%}
      {%- assign color_pos = 0 -%}
      {%- for option in product.options_with_values -%}
        {%- assign n = option.name | downcase -%}
        {%- if n == 'colore' or n == 'color' or n == 'colour' -%}
          {%- assign color_option = option -%}
          {%- assign color_pos = option.position | minus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if color_option != nil -%}
        <div class="hbs__opt">
          <p class="hbs__opt-lbl">Colore: <span id="hbs-cval-{{ section.id }}">{{ color_option.selected_value }}</span></p>
          <div class="hbs__swatches">
            {%- for value in color_option.values -%}
              <button
                type="button"
                class="hbs__swatch{% if color_option.selected_value == value %} hbs__swatch--on{% endif %}"
                data-color="{{ value }}"
                data-pos="{{ color_pos }}"
                title="{{ value }}"
                aria-label="{{ value }}"
                {%- assign sw = value.swatch -%}
                {%- assign val_h = value | handleize -%}
                style="{% if sw.color %}background:rgb({{ sw.color.rgb }});{% elsif sw.image %}background:url('{{ sw.image | image_url: width: 80 }}') center/cover no-repeat;{% elsif val_h == 'nero' %}background:#1a1a1a;{% elsif val_h == 'testa-di-moro' or val_h == 'testa-moro' %}background:#3d1a0a;{% elsif val_h == 'marrone' or val_h == 'brown' %}background:#5c3317;{% else %}background:#888;{% endif %}"
              ></button>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- assign size_option = nil -%}
      {%- assign size_pos = 1 -%}
      {%- for option in product.options_with_values -%}
        {%- assign n = option.name | downcase -%}
        {%- if n == 'taglia' or n == 'size' or n == 'misura' -%}
          {%- assign size_option = option -%}
          {%- assign size_pos = option.position | minus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if size_option == nil -%}
        {%- for option in product.options_with_values -%}
          {%- if option.position != color_option.position -%}
            {%- assign size_option = option -%}
            {%- assign size_pos = option.position | minus: 1 -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- if size_option != nil -%}
        <div class="hbs__opt">
          <div class="hbs__size-row">
            <p class="hbs__opt-lbl">Taglia: <span id="hbs-sval-{{ section.id }}">{{ size_option.selected_value }}</span></p>
            <div class="hbs__info-btns">
              <button type="button" class="hbs__info-btn" id="hbs-tech-{{ section.id }}">Schede tecniche</button>
              <button type="button" class="hbs__info-btn" id="hbs-size-{{ section.id }}">Guida taglie</button>
            </div>
          </div>
          <select class="hbs__select" id="hbs-ssel-{{ section.id }}" data-pos="{{ size_pos }}" aria-label="Taglia">
            {%- for value in size_option.values -%}
              <option value="{{ value }}"{% if size_option.selected_value == value %} selected{% endif %}>{{ value }}</option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}

<div class="hbs__qty-row">
        <span class="hbs__qty-lbl">Quantit&agrave;</span>
        <div class="hbs__qty">
          <button type="button" class="hbs__qty-btn" data-d="-1">&#8722;</button>
          <input type="number" name="quantity" value="1" min="1" id="hbs-qty-{{ section.id }}" class="hbs__qty-n" aria-label="Quantità">
          <button type="button" class="hbs__qty-btn" data-d="1">&#43;</button>
        </div>
      </div>

      <div class="hbs__cta-group">
        <button type="submit" name="add" class="hbs__atc">AGGIUNGI AL CARRELLO</button>
        <button type="button" class="hbs__bn" id="hbs-bn-{{ section.id }}">ACQUISTA ORA</button>
      </div>

    {% endform %}

    <div class="hbs-usp" id="hbs-usp-wrap-{{ section.id }}">
      <ul class="hbs-usp__list" id="hbs-usp-list-{{ section.id }}">

        <li class="hbs-usp__item" style="--i:0">
          <div class="hbs-usp__icon-wrap" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <div class="hbs-usp__body">
            <p class="hbs-usp__ttl">3 ANNI DI GARANZIA</p>
            <p class="hbs-usp__dsc">Aggiungiamo un anno in pi&ugrave; ai 2 anni previsti dalla legge. Valutazione, riparazione o sostituzione gratis.</p>
          </div>
        </li>

        <li class="hbs-usp__item" style="--i:1">
          <div class="hbs-usp__icon-wrap" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <div class="hbs-usp__body">
            <p class="hbs-usp__ttl">&ldquo;CAMBIO GOMME&rdquo; GRATIS</p>
            <p class="hbs-usp__dsc">Hai la suola consumata? Possiamo sostituirla mantenendo il DPI. Valutazione e manutenzione gratis.</p>
          </div>
        </li>

        <li class="hbs-usp__item" style="--i:2">
          <div class="hbs-usp__icon-wrap" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
          </div>
          <div class="hbs-usp__body">
            <p class="hbs-usp__ttl">CAMBIO TAGLIA GRATIS</p>
            <p class="hbs-usp__dsc">Sbagli numero? Nessun problema: ti mando il corriere a ritirare la prima e ti spedisco la seconda, gratis.</p>
          </div>
        </li>

        <li class="hbs-usp__item" style="--i:3">
          <div class="hbs-usp__icon-wrap" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 14 4 9 9 4"/><path d="M20 20v-7a4 4 0 0 0-4-4H4"/></svg>
          </div>
          <div class="hbs-usp__body">
            <p class="hbs-usp__ttl">14 GIORNI PER RIPENSARCI</p>
            <p class="hbs-usp__dsc">Le provi, le cammini per 14 giorni. Non ti convincono? Rimandamele e ti restituisco tutto.</p>
          </div>
        </li>

        <li class="hbs-usp__item" style="--i:4">
          <div class="hbs-usp__icon-wrap" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v4h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </div>
          <div class="hbs-usp__body">
            <p class="hbs-usp__ttl">SPEDIZIONE 48/72 ORE</p>
            <p class="hbs-usp__dsc">Ordini prima delle 18:00, spedisco il giorno dopo. Corriere tracciato con conferma via SMS.</p>
          </div>
        </li>

        <li class="hbs-usp__item" style="--i:5">
          <div class="hbs-usp__icon-wrap" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
          </div>
          <div class="hbs-usp__body">
            <p class="hbs-usp__ttl">PAGA IN 3 RATE DA &euro;63</p>
            <p class="hbs-usp__dsc">Dividi il pagamento con Klarna o PayPal. Zero interessi, zero sorprese.</p>
          </div>
        </li>

      </ul>
    </div>

  </div>
</div>

<div class="hbs-pop" id="hbs-pop-tech-{{ section.id }}" role="dialog" aria-modal="true" hidden>
  <div class="hbs-pop__bg" data-pop-close></div>
  <div class="hbs-pop__box">
    <button type="button" class="hbs-pop__x" data-pop-close aria-label="Chiudi">&times;</button>
    <h3 class="hbs-pop__title">Documentazione Tecnica</h3>
    <div class="hbs-pop__body">
      <div class="hbs-doc-section">
        <p class="hbs-doc-section__label">Documenti comuni</p>
        <a class="hbs-doc-row" href="https://cdn.shopify.com/s/files/1/0960/9527/3303/files/DPI-DRKAMPES-CERTIFICAZIONE-S3S.pdf?v=1776677825" target="_blank" rel="noopener">
          <span class="hbs-doc-row__icon">&#8595;</span>
          <span class="hbs-doc-row__name">Certificazione DPI S3S</span>
          <span class="hbs-doc-row__type">PDF</span>
        </a>
        <a class="hbs-doc-row" href="https://cdn.shopify.com/s/files/1/0960/9527/3303/files/NOTA-INFORMATIVA-DRKAMPES.pdf?v=1776677825" target="_blank" rel="noopener">
          <span class="hbs-doc-row__icon">&#8595;</span>
          <span class="hbs-doc-row__name">Nota informativa</span>
          <span class="hbs-doc-row__type">PDF</span>
        </a>
      </div>
      <div class="hbs-doc-section">
        <p class="hbs-doc-section__label">Schede tecniche per modello</p>
        <a class="hbs-doc-row" href="https://cdn.shopify.com/s/files/1/0960/9527/3303/files/DR_KAMPES_-_SCHEDA_TECNICA-20260420-BLACK.pdf?v=1776677825" target="_blank" rel="noopener">
          <span class="hbs-doc-row__icon">&#8595;</span>
          <span class="hbs-doc-row__name">Dr Kampes Nere</span>
          <span class="hbs-doc-row__type">PDF</span>
        </a>
        <a class="hbs-doc-row" href="https://cdn.shopify.com/s/files/1/0960/9527/3303/files/DR_KAMPES_-_SCHEDA_TECNICA-20260420-BLACK.pdf?v=1776677825" target="_blank" rel="noopener">
          <span class="hbs-doc-row__icon">&#8595;</span>
          <span class="hbs-doc-row__name">Dr Kampes Testa di Moro</span>
          <span class="hbs-doc-row__type">PDF</span>
        </a>
      </div>
    </div>
  </div>
</div>

<div class="hbs-pop" id="hbs-pop-size-{{ section.id }}" role="dialog" aria-modal="true" hidden>
  <div class="hbs-pop__bg" data-pop-close></div>
  <div class="hbs-pop__box">
    <button type="button" class="hbs-pop__x" data-pop-close aria-label="Chiudi">&times;</button>
    <h3 class="hbs-pop__title">Guida alla Taglia</h3>
    <div class="hbs-pop__body">
      <p>Misura la lunghezza interna della soletta e confronta con la tabella.</p>
      <table class="hbs-stbl">
        <thead><tr><th>IT</th><th>Cm Soletta Interna</th></tr></thead>
        <tbody>
          <tr><td>37</td><td>24,5 cm</td></tr>
          <tr><td>38</td><td>25 cm</td></tr>
          <tr><td>39</td><td>25,5 cm</td></tr>
          <tr><td>40</td><td>26,5 cm</td></tr>
          <tr><td>41</td><td>27,5 cm</td></tr>
          <tr><td>42</td><td>28 cm</td></tr>
          <tr><td>43</td><td>28,5 cm</td></tr>
          <tr><td>44</td><td>29 cm</td></tr>
          <tr><td>45</td><td>30 cm</td></tr>
          <tr><td>46</td><td>30,5 cm</td></tr>
          <tr><td>47</td><td>31 cm</td></tr>
          <tr><td>48</td><td>32 cm</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="hbs-cta-bar" id="hbs-cta-bar-{{ section.id }}">
  <a class="hbs-cta hbs-cta--before" href="#acquista" aria-label="SÌ, LE VOGLIO.">S&Igrave;, LE VOGLIO.</a>
  <button type="button" class="hbs-cta hbs-cta--after" id="hbs-cta-bn-{{ section.id }}">ACQUISTA ORA</button>
</div>

<script>
(function () {
  var sid = '{{ section.id }}';
  var root = document.querySelector('[data-hbs-id="' + sid + '"]');
  if (!root) return;

  var allVariants = JSON.parse(document.getElementById('hbs-variants-' + sid).textContent);
  var vgMap       = JSON.parse(document.getElementById('hbs-vg-' + sid).textContent);

  var slides = Array.from(root.querySelectorAll('.hbs__slide'));
  var thumbs = Array.from(root.querySelectorAll('.hbs__thumb'));
  var vidInput = document.getElementById('hbs-vid-' + sid);

  var initV = allVariants.find(function (v) { return v.available; }) || allVariants[0];
  var selOpts = initV ? initV.options.slice() : [];

  var mainEl   = root.querySelector('.hbs__main');
  var thumbsEl = root.querySelector('.hbs__thumbs');

  function showByMediaId(mediaId) {
    slides.forEach(function (s) { s.classList.toggle('hbs__slide--active', s.dataset.mediaId === mediaId); });
    thumbs.forEach(function (t) { t.classList.toggle('hbs__thumb--active', t.dataset.mediaId === mediaId); });
  }

  function filterGallery(variantId) {
    var ids = vgMap[String(variantId)];

    if (!ids || ids.length === 0) {
      slides.forEach(function (s) { s.style.display = ''; });
      thumbs.forEach(function (t) { t.style.display = ''; });
      slides = Array.from(mainEl.querySelectorAll('.hbs__slide'));
      thumbs = Array.from(thumbsEl.querySelectorAll('.hbs__thumb'));
      if (slides.length) showByMediaId(slides[0].dataset.mediaId);
      return;
    }

    slides.forEach(function (s) { s.style.display = 'none'; });
    thumbs.forEach(function (t) { t.style.display = 'none'; });

    ids.forEach(function (id) {
      var strId = String(id);
      var slide = mainEl.querySelector('.hbs__slide[data-media-id="' + strId + '"]');
      var thumb = thumbsEl.querySelector('.hbs__thumb[data-media-id="' + strId + '"]');
      if (slide) { slide.style.display = ''; mainEl.appendChild(slide); }
      if (thumb) { thumb.style.display = ''; thumbsEl.appendChild(thumb); }
    });

    slides = Array.from(mainEl.querySelectorAll('.hbs__slide'));
    thumbs = Array.from(thumbsEl.querySelectorAll('.hbs__thumb'));

    if (ids.length) showByMediaId(String(ids[0]));
  }

  thumbs.forEach(function (btn) {
    btn.addEventListener('click', function () { showByMediaId(btn.dataset.mediaId); });
  });

  function syncVariant() {
    var match = allVariants.find(function (v) {
      return v.options.every(function (o, i) { return o === selOpts[i]; });
    }) || allVariants.find(function (v) { return v.options[0] === selOpts[0]; });
    if (!match) return;
    vidInput.value = match.id;
    filterGallery(match.id);
  }

  var swatches  = root.querySelectorAll('.hbs__swatch');
  var cValEl    = document.getElementById('hbs-cval-' + sid);

  swatches.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var pos = parseInt(btn.dataset.pos, 10);
      selOpts[pos] = btn.dataset.color;
      swatches.forEach(function (s) { s.classList.remove('hbs__swatch--on'); });
      btn.classList.add('hbs__swatch--on');
      if (cValEl) cValEl.textContent = btn.dataset.color;
      syncVariant();
    });
  });

  var sSel  = document.getElementById('hbs-ssel-' + sid);
  var sValEl = document.getElementById('hbs-sval-' + sid);

  if (sSel) {
    sSel.addEventListener('change', function () {
      var pos = parseInt(sSel.dataset.pos, 10);
      selOpts[pos] = sSel.value;
      if (sValEl) sValEl.textContent = sSel.value;
      syncVariant();
    });
  }

  var qtyEl = document.getElementById('hbs-qty-' + sid);
  root.querySelectorAll('.hbs__qty-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      qtyEl.value = Math.max(1, (parseInt(qtyEl.value, 10) || 1) + parseInt(btn.dataset.d, 10));
    });
  });

  var form = document.getElementById('hbs-form-' + sid);
  var atcBtn = form ? form.querySelector('.hbs__atc') : null;
  var atcLabel = atcBtn ? atcBtn.textContent : '';

  function setReturnTo(value) {
    if (!form) return;
    var rt = form.querySelector('input[name="return_to"]');
    if (!rt) {
      rt = document.createElement('input');
      rt.type = 'hidden';
      rt.name = 'return_to';
      form.appendChild(rt);
    }
    rt.value = value;
  }

  function nativeCheckout(btn, fallbackLabel) {
    if (!form) return;
    if (btn) {
      btn.disabled = true;
      btn.classList.add('hbs__btn--loading');
      if (fallbackLabel != null) btn.dataset.origLabel = btn.textContent;
    }
    setReturnTo('/checkout');
    form.submit();
  }

  if (form && atcBtn) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (atcBtn.disabled) return;

      atcBtn.disabled = true;
      atcBtn.classList.add('hbs__btn--loading');
      atcBtn.textContent = 'AGGIUNTA...';

      var fd = new FormData(form);
      fd.delete('return_to');

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: fd
      })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }); })
        .then(function (res) {
          var data = res.body || {};
          if (!res.ok || data.status) {
            atcBtn.classList.remove('hbs__btn--loading');
            atcBtn.classList.add('hbs__btn--error');
            atcBtn.textContent = (data.description || data.message || 'Errore').toString().slice(0, 40);
            setTimeout(function () {
              atcBtn.classList.remove('hbs__btn--error');
              atcBtn.textContent = atcLabel;
              atcBtn.disabled = false;
            }, 2400);
            return;
          }
          atcBtn.classList.remove('hbs__btn--loading');
          atcBtn.classList.add('hbs__btn--done');
          atcBtn.textContent = 'AGGIUNTO AL CARRELLO';

          var evt = new CustomEvent('cart:update', { bubbles: true });
          evt.detail = {
            resource: data,
            sourceId: 'hbs-' + sid,
            data: {
              source: 'product-form-component',
              itemCount: data.quantity || 1,
              productId: data.product_id,
              variantId: data.variant_id
            }
          };
          document.dispatchEvent(evt);

          setTimeout(function () {
            atcBtn.classList.remove('hbs__btn--done');
            atcBtn.textContent = atcLabel;
            atcBtn.disabled = false;
          }, 1800);
        })
        .catch(function () {
          atcBtn.classList.remove('hbs__btn--loading');
          atcBtn.textContent = atcLabel;
          atcBtn.disabled = false;
        });
    });
  }

  var bnBtn = document.getElementById('hbs-bn-' + sid);
  if (bnBtn) {
    bnBtn.addEventListener('click', function (e) {
      e.preventDefault();
      bnBtn.textContent = 'ATTENDI...';
      nativeCheckout(bnBtn, 'ACQUISTA ORA');
    });
  }

  function openPop(id) {
    var el = document.getElementById(id);
    if (el) { el.hidden = false; document.body.style.overflow = 'hidden'; }
  }
  function closePops() {
    document.querySelectorAll('.hbs-pop:not([hidden])').forEach(function (p) { p.hidden = true; });
    document.body.style.overflow = '';
  }

  var techBtn = document.getElementById('hbs-tech-' + sid);
  var sizeBtn = document.getElementById('hbs-size-' + sid);
  if (techBtn) techBtn.addEventListener('click', function () { openPop('hbs-pop-tech-' + sid); });
  if (sizeBtn) sizeBtn.addEventListener('click', function () { openPop('hbs-pop-size-' + sid); });

  document.querySelectorAll('[data-pop-close]').forEach(function (el) {
    el.addEventListener('click', closePops);
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closePops(); });

  var ctaBar = document.getElementById('hbs-cta-bar-{{ section.id }}');
  var stickyCta = ctaBar ? ctaBar.querySelector('.hbs-cta--before') : null;
  var ctaBnBtn = document.getElementById('hbs-cta-bn-{{ section.id }}');
  var fastWear = document.getElementById('fast-wear');

  if (ctaBar) {
    var ctaState = 'hidden';

    function updateCta() {
      var bnRect = bnBtn ? bnBtn.getBoundingClientRect() : null;
      var bnOffScreen = bnRect && bnRect.bottom < 0;
      var bnVisible = bnRect && bnRect.top < window.innerHeight && bnRect.bottom > 0;
      var newState = bnVisible ? 'hidden' : (window.scrollY > 80 ? 'before' : 'hidden');
      if (newState === ctaState) return;
      ctaState = newState;

      ctaBar.style.transition = 'none';
      ctaBar.classList.remove('hbs-cta-bar--visible');
      ctaBar.classList.toggle('hbs-cta-bar--past', newState === 'after');
      ctaBar.offsetHeight;
      ctaBar.style.transition = '';
      if (newState !== 'hidden') ctaBar.classList.add('hbs-cta-bar--visible');
    }

    window.addEventListener('scroll', updateCta, { passive: true });

    if (stickyCta) {
      stickyCta.addEventListener('click', function (e) {
        e.preventDefault();
        root.scrollIntoView({ behavior: 'smooth' });
      });
    }
  }

  if (ctaBnBtn) {
    ctaBnBtn.addEventListener('click', function (e) {
      e.preventDefault();
      ctaBnBtn.textContent = 'ATTENDI...';
      nativeCheckout(ctaBnBtn, 'ACQUISTA ORA');
    });
  }

  if (initV) filterGallery(initV.id);

  var uspWrap = document.getElementById('hbs-usp-wrap-' + sid);
  if (uspWrap) {
    new IntersectionObserver(function (entries, obs) {
      if (entries[0].isIntersecting) {
        uspWrap.classList.add('hbs-usp--in');
        obs.disconnect();
      }
    }, { threshold: 0.15 }).observe(uspWrap);
  }
})();
</script>

{% endif %}

{% stylesheet %}

.hbs {
  display: flex;
  flex-direction: column;
  background: #fff;
}

/* Gallery */
.hbs__gallery {
  flex: 0 0 50svh;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.hbs__main {
  flex: 1 1 auto;
  min-height: 0;
  overflow: hidden;
  background: #fff;
}

.hbs__slide {
  display: none;
  width: 100%;
  height: 100%;
}
.hbs__slide--active { display: block; }

.hbs__img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

.hbs__thumbs {
  flex: 0 0 auto;
  display: flex;
  gap: 6px;
  overflow-x: auto;
  padding: 8px 16px;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}
.hbs__thumbs::-webkit-scrollbar { display: none; }

.hbs__thumb {
  flex: 0 0 56px;
  height: 56px;
  padding: 0;
  border: 2px solid #e0e0e0;
  border-radius: 4px;
  overflow: hidden;
  background: #fff;
  cursor: pointer;
  transition: border-color 0.15s;
}
.hbs__thumb--active { border-color: #111; }

.hbs__thumb-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Details */
.hbs__details {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 14px 16px 24px;
}

.hbs__head { display: flex; flex-direction: column; gap: 2px; }

.hbs__title {
  font-size: 1.05rem;
  font-weight: 700;
  margin: 0;
  line-height: 1.3;
  color: #111;
}

.hbs__sub {
  font-size: 0.8rem;
  color: #888;
  margin: 0;
}

/* Social proof */
.hbs__social {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: -10px 0 0;
}

.hbs__stars {
  color: #f5a623;
  font-size: 0.88rem;
  letter-spacing: 1px;
  line-height: 1;
}

.hbs__review-lbl {
  font-size: 0.74rem;
  color: #666;
  margin: 0;
}

/* Price block */
.hbs__price-wrap {
  display: flex;
  flex-direction: column;
  gap: 3px;
  margin: 0;
}

.hbs__price {
  margin: 0;
  display: flex;
  align-items: baseline;
  gap: 8px;
}
.hbs__price-main {
  font-size: 1.65rem;
  font-weight: 700;
  color: #111;
  line-height: 1;
}
.hbs__price-tax {
  font-size: 0.68rem;
  color: #888;
  text-transform: uppercase;
  letter-spacing: 0.07em;
}

.hbs__installment {
  font-size: 0.74rem;
  color: #666;
  margin: 0;
}
.hbs__installment strong { color: #111; }

/* Trust strip */
.hbs__trust {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6px;
  padding: 10px 0;
  border-top: 1px solid #ebebeb;
  border-bottom: 1px solid #ebebeb;
}

.hbs__trust-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
  text-align: center;
  font-size: 0.62rem;
  font-weight: 600;
  color: #333;
  letter-spacing: 0.01em;
  line-height: 1.35;
}

.hbs__trust-ico {
  width: 22px;
  height: 22px;
  color: #2e7d32;
  flex-shrink: 0;
}

/* Form */
.hbs__form { display: flex; flex-direction: column; gap: 10px; }

.hbs__opt { display: flex; flex-direction: column; gap: 6px; }

.hbs__opt-lbl {
  font-size: 0.82rem;
  font-weight: 500;
  color: #111;
  margin: 0;
}

.hbs__swatches { display: flex; gap: 10px; }

.hbs__swatch {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 2px solid transparent;
  padding: 0;
  cursor: pointer;
  outline: 2px solid transparent;
  outline-offset: 2px;
  transition: outline-color 0.15s;
}
.hbs__swatch--on { outline-color: #111; }

.hbs__size-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  flex-wrap: nowrap;
}

.hbs__info-btns { display: flex; gap: 6px; flex-shrink: 0; }

.hbs__info-btn {
  font-size: 0.68rem;
  padding: 5px 8px;
  border-radius: 4px;
  border: 1px solid #ccc;
  background: #f2f2f2;
  color: #333;
  cursor: pointer;
  white-space: nowrap;
  font-family: inherit;
  line-height: 1.3;
}
.hbs__info-btn:active { background: #e0e0e0; }

.hbs__select {
  width: 100%;
  padding: 9px 12px;
  font-size: 0.9rem;
  border: 1px solid #ccc;
  border-radius: 4px;
  background: #fff;
  cursor: pointer;
  font-family: inherit;
  color: #111;
  appearance: auto;
}

/* Qty row */
.hbs__qty-row {
  display: flex;
  align-items: center;
  gap: 12px;
}

.hbs__qty-lbl {
  font-size: 0.82rem;
  font-weight: 500;
  color: #111;
}

.hbs__qty {
  display: flex;
  align-items: center;
  border: 1px solid #ccc;
  border-radius: 4px;
  overflow: hidden;
  flex-shrink: 0;
}

.hbs__qty-btn {
  width: 34px;
  min-height: 40px;
  background: none;
  border: none;
  font-size: 1.1rem;
  cursor: pointer;
  padding: 0;
  font-family: inherit;
  color: #111;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hbs__qty-btn:active { background: #f0f0f0; }

.hbs__qty-n {
  width: 38px;
  text-align: center;
  border: none;
  border-left: 1px solid #ccc;
  border-right: 1px solid #ccc;
  font-size: 0.9rem;
  padding: 0;
  height: 40px;
  -moz-appearance: textfield;
  font-family: inherit;
  color: #111;
}
.hbs__qty-n::-webkit-inner-spin-button,
.hbs__qty-n::-webkit-outer-spin-button { -webkit-appearance: none; }

/* CTA group */
.hbs__cta-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.hbs__atc {
  width: 100%;
  height: 52px;
  padding: 0 16px;
  background: #2e7d32;
  color: #fff;
  border: none;
  border-radius: 6px;
  font-size: 0.82rem;
  font-weight: 800;
  letter-spacing: 0.07em;
  cursor: pointer;
  text-transform: uppercase;
  font-family: inherit;
  line-height: 1;
  transition: background 0.15s;
}
.hbs__atc:active { background: #1b5e20; }

.hbs__bn {
  width: 100%;
  height: 52px;
  background: #F5C200;
  color: #111;
  border: none;
  border-radius: 6px;
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  cursor: pointer;
  text-transform: uppercase;
  font-family: inherit;
  transition: background 0.15s;
}
.hbs__bn:active { background: #d9ac00; }

.hbs__atc[disabled], .hbs__bn[disabled] { cursor: wait; opacity: 0.92; }
.hbs__btn--loading { position: relative; }
.hbs__btn--loading::after {
  content: '';
  display: inline-block;
  width: 14px;
  height: 14px;
  margin-left: 8px;
  border: 2px solid currentColor;
  border-top-color: transparent;
  border-radius: 50%;
  animation: hbs-spin 0.7s linear infinite;
  vertical-align: -3px;
}
.hbs__atc.hbs__btn--done { background: #1b5e20; }
.hbs__atc.hbs__btn--error { background: #c4382f; color: #fff; }
@keyframes hbs-spin { to { transform: rotate(360deg); } }

.hbs__micro {
  font-size: 0.75rem;
  color: #333;
  margin: 0;
  text-align: center;
  line-height: 1.6;
}

/* USP list */
.hbs-usp {
  border: 1px solid #e0e0e0;
  border-radius: 12px;
  overflow: hidden;
}

.hbs-usp__list {
  display: flex;
  flex-direction: column;
  list-style: none;
  margin: 0;
  padding: 0;
}

.hbs-usp__item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 15px 18px;
  border-bottom: 1px solid #e0e0e0;
  opacity: 0;
  transform: translateY(10px);
  transition: opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1),
              transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  transition-delay: calc(var(--i, 0) * 0.07s);
}
.hbs-usp__item:last-child { border-bottom: none; }
.hbs-usp--in .hbs-usp__item {
  opacity: 1;
  transform: none;
}

.hbs-usp__icon-wrap {
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  border-radius: 9px;
  background: #e8f5e9;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 1px;
}
.hbs-usp__icon-wrap svg {
  width: 18px;
  height: 18px;
  stroke: #2e7d32;
}

.hbs-usp__body { flex: 1; min-width: 0; }

.hbs-usp__ttl {
  font-family: var(--font-heading--family, inherit);
  font-size: 0.84rem;
  font-weight: 900;
  color: #111;
  margin: 0 0 4px;
  letter-spacing: 0.04em;
  line-height: 1.2;
}

.hbs-usp__dsc {
  font-size: 0.8rem;
  color: #555;
  margin: 0;
  line-height: 1.55;
}

/* Popups */
.hbs-pop {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.hbs-pop[hidden] { display: none; }

.hbs-pop__bg {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.45);
  cursor: pointer;
}

.hbs-pop__box {
  position: relative;
  background: #fff;
  border-radius: 14px 14px 0 0;
  width: 100%;
  max-height: 74svh;
  overflow-y: auto;
  padding: 22px 20px 36px;
}

.hbs-pop__x {
  position: absolute;
  top: 14px;
  right: 16px;
  background: none;
  border: none;
  font-size: 1.5rem;
  cursor: pointer;
  color: #555;
  padding: 0 4px;
  line-height: 1;
  font-family: inherit;
}

.hbs-pop__title {
  font-size: 1rem;
  font-weight: 700;
  margin: 0 0 16px;
  padding-right: 28px;
  color: #111;
}

.hbs-pop__body p { font-size: 0.85rem; margin: 0 0 12px; color: #444; }

.hbs-doc-section { display: flex; flex-direction: column; gap: 6px; margin-bottom: 20px; }
.hbs-doc-section:last-child { margin-bottom: 0; }

.hbs-doc-section__label {
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #999;
  margin: 0 0 2px;
}

.hbs-doc-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  background: #f7f7f7;
  border-radius: 8px;
  text-decoration: none;
  color: #111;
  transition: background 0.15s;
}
.hbs-doc-row:hover { background: #eee; color: #111; text-decoration: none; }

.hbs-doc-row__icon {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #111;
  color: #fff;
  border-radius: 50%;
  font-size: 0.85rem;
  flex-shrink: 0;
}

.hbs-doc-row__name {
  flex: 1;
  font-size: 0.875rem;
  font-weight: 500;
}

.hbs-doc-row__type {
  font-size: 0.68rem;
  font-weight: 700;
  color: #999;
  letter-spacing: 0.05em;
}

.hbs-stbl { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
.hbs-stbl th, .hbs-stbl td { border-bottom: 1px solid #eee; padding: 8px 6px; text-align: left; }
.hbs-stbl th { font-weight: 700; color: #111; padding-top: 2px; }

/* Desktop */
@media screen and (min-width: 750px) {
  .hbs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: auto;
    overflow: visible;
    padding: 40px max(24px, calc((100% - 1200px) / 2));
    gap: 48px;
    align-items: start;
  }
  .hbs__gallery {
    flex-direction: column;
    height: auto;
    position: sticky;
    top: var(--sticky-header-offset, 0px);
    min-width: 0;
  }
  .hbs__main {
    flex: 1 1 auto;
    height: min(640px, 74svh);
  }
  .hbs__thumbs {
    flex-direction: row;
    overflow-x: auto;
    overflow-y: visible;
    max-height: none;
    padding: 8px 0 0;
  }
  .hbs__details {
    overflow-y: visible;
    padding: 0;
    gap: 14px;
    min-height: unset;
    min-width: 0;
  }
  .hbs__title { font-size: 1.2rem; }
  .hbs__price-main { font-size: 2rem; }
  .hbs-pop { align-items: center; }
  .hbs-pop__box { border-radius: 12px; width: 480px; max-height: 80vh; }
  .hbs-usp { margin: 0; }
}

/* Sticky CTA bar */
.hbs-cta-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 9000;
  display: flex;
  align-items: stretch;
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px));
  background: #111;
  opacity: 0;
  transform: translateY(100%);
  pointer-events: none;
  transition: opacity 0.25s, transform 0.25s;
}
.hbs-cta-bar--visible {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.hbs-cta-bar .hbs-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 50px;
  text-decoration: none;
  border-radius: 0;
  border: none;
  cursor: pointer;
  transition: background 0.15s;
}

.hbs-cta-bar .hbs-cta--before {
  background: var(--color-primary-button-background);
  color: var(--color-primary-button-text, #fff) !important;
  font-size: var(--font-paragraph--size);
  font-weight: var(--font-accent--weight, 400);
  text-transform: var(--button-text-case-primary, uppercase);
  font-family: var(--button-font-family-primary);
}
.hbs-cta-bar .hbs-cta--before:hover { background: var(--color-primary-button-hover-background); color: var(--color-primary-button-hover-text, #fff) !important; text-decoration: none; }
.hbs-cta-bar .hbs-cta--before:active { background: var(--color-primary-button-hover-background); }

.hbs-cta-bar .hbs-cta--after {
  display: none;
  background: #F5C200;
  color: #111 !important;
  font-size: 0.82rem;
  font-weight: 800;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  font-family: inherit;
}
.hbs-cta-bar .hbs-cta--after:hover { background: #d9ac00; color: #111 !important; text-decoration: none; }
.hbs-cta-bar .hbs-cta--after:active { background: #d9ac00; }

.hbs-cta-bar--past .hbs-cta--before { display: none; }
.hbs-cta-bar--past .hbs-cta--after { display: flex; }

{% endstylesheet %}

