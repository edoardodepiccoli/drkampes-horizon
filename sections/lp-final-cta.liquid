<section class="lp-final-cta">
  <div class="lp-final-cta__inner">

    {%- if section.settings.eyebrow != blank -%}
      <div class="lp-sec__eyebrow lp-final-cta__eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}

    <h2 class="lp-sec__h2 lp-final-cta__h2">{{ section.settings.heading | newline_to_br }}</h2>

    {%- if section.settings.price != blank -%}
      <p class="lp-final-cta__price">{{ section.settings.price }}</p>
    {%- endif -%}

    {%- if section.settings.compare_price != blank -%}
      <p class="lp-final-cta__compare"><s>{{ section.settings.compare_price }}</s></p>
    {%- endif -%}

    {%- if section.settings.price_note != blank -%}
      <p class="lp-final-cta__price-note">{{ section.settings.price_note }}</p>
    {%- endif -%}

    <a href="{{ section.settings.cta_url | default: '#acquista' }}" class="lp-final-cta__btn">
      <span class="lp-final-cta__btn-label">{{ section.settings.cta_label | default: 'SÌ, LE VOGLIO' }}</span>
    </a>

    <div class="lp-final-cta__ssl">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
      {{ section.settings.ssl_note | default: 'Transazione crittografata al 100% · SSL' }}
    </div>

  </div>
</section>

{% stylesheet %}

.lp-final-cta {
  padding: 56px 22px;
  background: #000;
  text-align: center;
}

.lp-final-cta__inner {
  max-width: 540px;
  margin: 0 auto;
}

.lp-final-cta .lp-sec__eyebrow {
  color: #F5C200;
  display: block;
}

.lp-final-cta .lp-sec__h2 {
  color: #fff;
  margin-bottom: 10px;
}

.lp-final-cta__price {
  font-size: 1.9rem;
  font-weight: 900;
  color: #fff;
  line-height: 1;
  margin: 0 0 4px;
}

.lp-final-cta__compare {
  font-size: 1rem;
  color: rgba(255,255,255,0.45);
  text-decoration: line-through;
  margin: 0 0 4px;
}

.lp-final-cta__price-note {
  font-size: 0.78rem;
  color: rgba(255,255,255,0.45);
  margin: 0 0 28px;
}

.lp-final-cta__btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  max-width: 380px;
  margin: 0 auto 24px;
  padding: 17px 24px;
  background: #F5C200;
  color: #0d0d0d;
  font-weight: 900;
  font-family: 'Archivo Black', sans-serif;
  text-align: center;
  border-radius: 0;
  text-decoration: none;
  transition: background 0.15s;
}
.lp-final-cta__btn:hover { background: #d9ac00; text-decoration: none; }

.lp-final-cta__btn-price {
  font-size: 1.4rem;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -0.01em;
}

.lp-final-cta__btn-label {
  font-size: 1rem;
  font-weight: 900;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  line-height: 1;
}

.lp-final-cta__ssl {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  font-size: 0.7rem;
  color: rgba(255,255,255,0.35);
}

.lp-final-cta__ssl svg {
  width: 12px;
  height: 12px;
  stroke: currentColor;
  flex-shrink: 0;
}

@media (min-width: 750px) {
  .lp-final-cta {
    padding: 80px 60px;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "LP — CTA Finale",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Pronto a smettere di soffrire?"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Titolo",
      "default": "Dr Kampes Trucker Shoes.\nT-shirt Esclusiva GRATIS.\nSpedizione Express GRATIS."
    },
    {
      "type": "text",
      "id": "price",
      "label": "Prezzo",
      "default": "€189,00"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Prezzo barrato (valore offerta)",
      "default": "€219"
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "Nota prezzo",
      "default": "IVA inclusa"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Testo bottone CTA",
      "default": "Acquista Ora — T-shirt GRATIS"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "URL bottone CTA"
    },
    {
      "type": "richtext",
      "id": "installment_text",
      "label": "Testo rate",
      "default": "<p>Oppure paga in <strong>3 comode rate da €63 a tasso zero</strong> con Klarna e PayPal.</p>"
    },
    {
      "type": "text",
      "id": "ssl_note",
      "label": "Nota sicurezza SSL",
      "default": "Transazione crittografata al 100% · SSL"
    }
  ],
  "blocks": [
    {
      "type": "payment_badge",
      "name": "Badge pagamento",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Nome metodo di pagamento"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP — CTA Finale",
      "blocks": [
        { "type": "payment_badge", "settings": { "label": "Klarna" } },
        { "type": "payment_badge", "settings": { "label": "PayPal" } },
        { "type": "payment_badge", "settings": { "label": "Apple Pay" } },
        { "type": "payment_badge", "settings": { "label": "Google Pay" } },
        { "type": "payment_badge", "settings": { "label": "Carta di Credito" } }
      ]
    }
  ]
}
{% endschema %}
