{%- assign img = section.settings.image -%}

<section class="lp-story">
  {%- if section.settings.eyebrow != blank -%}
    <div class="lp-sec__eyebrow lp-story__eyebrow">{{ section.settings.eyebrow }}</div>
  {%- endif -%}

  <h2 class="lp-sec__h2 lp-story__h2">{{ section.settings.heading }}</h2>

  <div class="lp-story__body">
    {%- if img != blank -%}
      <div class="lp-story__photo">
        {{ img | image_url: width: 600 | image_tag: class: 'lp-story__img', loading: 'lazy', widths: '300,400,600', sizes: '(min-width:750px) 260px, 80vw', alt: img.alt }}
      </div>
    {%- endif -%}

    <div class="lp-story__copy">
      {%- if section.settings.copy_1 != blank -%}
        <div class="lp-story__text">{{ section.settings.copy_1 }}</div>
      {%- endif -%}

      {%- if section.settings.blockquote != blank -%}
        <blockquote class="lp-story__quote">
          &#8220;{{ section.settings.blockquote }}&#8221;
        </blockquote>
      {%- endif -%}

      {%- if section.settings.copy_2 != blank -%}
        <div class="lp-story__text">{{ section.settings.copy_2 }}</div>
      {%- endif -%}

      {%- if section.settings.badge_text != blank -%}
        <div class="lp-story__badge">
          🇮🇹 &nbsp; {{ section.settings.badge_text }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}

.lp-story {
  padding: 56px 22px;
  background: #fff;
}

.lp-story__eyebrow {
  color: #2e7d32;
}

.lp-story__h2 {
  margin-bottom: 24px;
}

.lp-story__body {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.lp-story__photo {
  border-radius: 10px;
  overflow: hidden;
}

.lp-story__img {
  width: 100%;
  height: auto;
  display: block;
  aspect-ratio: 3/4;
  object-fit: cover;
}

.lp-story__copy {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.lp-story__text {
  font-size: 0.97rem;
  color: #444;
  line-height: 1.85;
}

.lp-story__text p { margin: 0 0 14px; }
.lp-story__text p:last-child { margin-bottom: 0; }
.lp-story__text strong { color: #111; }

.lp-story__quote {
  font-size: 1rem;
  color: #111;
  line-height: 1.8;
  font-style: italic;
  border-left: 3px solid #F5C200;
  padding-left: 16px;
  margin: 0;
}

.lp-story__badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #fff8e1;
  border: 1.5px solid #F5C200;
  border-radius: 8px;
  padding: 10px 16px;
  font-size: 0.8rem;
  font-weight: 700;
  color: #7a5800;
}

@media (min-width: 750px) {
  .lp-story {
    padding: 80px 60px;
  }

  .lp-story__body {
    flex-direction: row;
    gap: 48px;
    align-items: flex-start;
  }

  .lp-story__photo {
    flex: 0 0 260px;
  }

  .lp-story__copy {
    flex: 1;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "LP — Storia",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "La svolta"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo sezione",
      "default": "Un giorno, stanco di queste bugie, ho deciso di cambiare le regole del gioco."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto founder"
    },
    {
      "type": "richtext",
      "id": "copy_1",
      "label": "Testo (prima del blockquote)",
      "default": "<p>Ho preso i <strong>100 anni di esperienza artigianale</strong> del prestigioso distretto calzaturiero di Montebelluna e l'ho letteralmente fuso con l'asfalto, il gasolio e la vita in cabina.</p>"
    },
    {
      "type": "textarea",
      "id": "blockquote",
      "label": "Citazione (blockquote)",
      "default": "Volevo creare la scarpa che ogni camionista merita. Non una scarpa \"da lavoro\". Una scarpa fatta con rispetto."
    },
    {
      "type": "richtext",
      "id": "copy_2",
      "label": "Testo (dopo il blockquote)",
      "default": "<p>Il risultato? <strong>Dr Kampes — Trucker Shoes</strong>. La calzatura che sta riscrivendo le regole del gioco.</p>"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Testo badge Made in Italy",
      "default": "100% Made in Italy · Distretto di Montebelluna · Artigianato d'eccellenza"
    }
  ],
  "presets": [{ "name": "LP — Storia" }]
}
{% endschema %}
