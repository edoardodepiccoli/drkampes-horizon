{%- assign sec_id = section.id -%}

<section class="lp-b2b-system" id="lp-b2b-system-{{ sec_id }}">

  <div class="lp-b2b-system__inner">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <header class="lp-b2b-system__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="lp-b2b-system__heading">{{ section.settings.heading | newline_to_br }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="lp-b2b-system__sub">{{ section.settings.subheading | newline_to_br }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="lp-b2b-system__carousel">
        <ul class="lp-b2b-system__track">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <li class="lp-b2b-system__card" {{ block.shopify_attributes }}>
                <span class="lp-b2b-system__card-icon" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'palette' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 0 0 0 18c1 0 2-1 2-2 0-1-1-2-1-3s1-2 2-2h3a4 4 0 0 0 4-4 9 9 0 0 0-10-7z"/><circle cx="7.5" cy="11" r="1.2"/><circle cx="11" cy="7" r="1.2"/><circle cx="16" cy="8.5" r="1.2"/></svg>
                    {%- when 'bolt' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>
                    {%- when 'ruler' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="9" width="20" height="6"/><line x1="6" y1="9" x2="6" y2="12"/><line x1="10" y1="9" x2="10" y2="13"/><line x1="14" y1="9" x2="14" y2="12"/><line x1="18" y1="9" x2="18" y2="13"/></svg>
                    {%- when 'recycle' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7 4 10l3 3"/><path d="M4 10h11a4 4 0 0 1 4 4"/><path d="M17 17l3-3-3-3"/><path d="M20 14H9a4 4 0 0 1-4-4"/></svg>
                    {%- when 'user-card' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="0"/><circle cx="9" cy="11" r="2.5"/><path d="M5 18a4 4 0 0 1 8 0"/><line x1="14" y1="9" x2="19" y2="9"/><line x1="14" y1="12" x2="19" y2="12"/><line x1="14" y1="15" x2="17" y2="15"/></svg>
                    {%- when 'headset' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13a8 8 0 0 1 16 0"/><rect x="3" y="13" width="4" height="7" rx="1"/><rect x="17" y="13" width="4" height="7" rx="1"/><path d="M19 20a3 3 0 0 1-3 3h-2"/></svg>
                    {%- when 'shield' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5z"/></svg>
                    {%- when 'truck' -%}
                      {%- render 'b2b-icon-truck' -%}
                    {%- when 'tag' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12 12 2h9v9L11 21z"/><circle cx="16" cy="8" r="1.5"/></svg>
                    {%- when 'wrench' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 7a4 4 0 1 1 4 4l-9 9-3-3 9-9a4 4 0 0 1 0-1z"/></svg>
                  {%- endcase -%}
                </span>
                <div class="lp-b2b-system__card-body">
                  {%- if block.settings.title != blank -%}
                    <h3 class="lp-b2b-system__card-title">{{ block.settings.title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p class="lp-b2b-system__card-text">{{ block.settings.text | newline_to_br }}</p>
                  {%- endif -%}
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {%- if section.blocks.size > 1 -%}
          <ul class="lp-b2b-system__dots" role="tablist" aria-label="Naviga le feature">
            {%- for block in section.blocks -%}
              {%- if block.type == 'feature' -%}
                <li>
                  <button
                    type="button"
                    class="lp-b2b-system__dot {%- if forloop.first %} is-active{%- endif -%}"
                    data-index="{{ forloop.index0 }}"
                    aria-label="Vai alla feature {{ forloop.index }}"
                  ></button>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('lp-b2b-system-{{ sec_id }}');
    if (!root) return;
    var track = root.querySelector('.lp-b2b-system__track');
    var dots  = root.querySelectorAll('.lp-b2b-system__dot');
    if (!track || dots.length === 0) return;

    function getCardStep() {
      var first = track.firstElementChild;
      if (!first) return 0;
      var rect = first.getBoundingClientRect();
      var cs = getComputedStyle(track);
      var gap = parseFloat(cs.columnGap);
      if (isNaN(gap)) gap = parseFloat(cs.gap);
      if (isNaN(gap)) gap = 0;
      return rect.width + gap;
    }

    function activeIndex() {
      var step = getCardStep();
      if (!step || isNaN(step)) return 0;
      var idx = Math.round(track.scrollLeft / step);
      if (idx < 0) idx = 0;
      if (idx > dots.length - 1) idx = dots.length - 1;
      return idx;
    }

    function update() {
      var idx = activeIndex();
      for (var i = 0; i < dots.length; i++) {
        if (i === idx) dots[i].classList.add('is-active');
        else dots[i].classList.remove('is-active');
      }
    }

    var raf;
    track.addEventListener('scroll', function () {
      if (raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(update);
    }, { passive: true });

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        var idx = parseInt(dot.dataset.index, 10) || 0;
        track.scrollTo({ left: idx * getCardStep(), behavior: 'smooth' });
      });
    });

    window.addEventListener('resize', function () {
      if (raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(update);
    });

    update();
  })();
</script>

{% stylesheet %}

.lp-b2b-system {
  --b2b-gold:        #E8B82E;
  --b2b-gold-light:  #FFD84D;
  --b2b-gold-dark:   #B8881A;
  --b2b-gold-faint:  rgba(232, 184, 46, 0.25);
  background: #000;
  color: #fff;
  padding: 48px 0 56px;
}

.lp-b2b-system__inner {
  max-width: 1280px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

/* ── Header ── */
.lp-b2b-system__head {
  text-align: center;
  padding: 0 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.lp-b2b-system__heading {
  font-family: 'Inter', sans-serif;
  font-size: 1.05rem;
  font-weight: 600;
  line-height: 1.25;
  color: #fff;
  margin: 0;
  letter-spacing: 0;
}

.lp-b2b-system__sub {
  font-family: 'Archivo Black', 'Inter', sans-serif;
  font-size: 1.5rem;
  font-weight: 900;
  line-height: 1.15;
  color: var(--b2b-gold);
  margin: 0;
  letter-spacing: -0.005em;
}

/* ── Carousel ── */
.lp-b2b-system__carousel {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.lp-b2b-system__track {
  list-style: none;
  margin: 0;
  padding: 4px 16px 8px;
  display: flex;
  flex-direction: row;
  gap: 12px;
  overflow-x: auto;
  overflow-y: hidden;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}
.lp-b2b-system__track::-webkit-scrollbar { display: none; }

.lp-b2b-system__card {
  flex: 0 0 calc(100% - 24px);
  min-width: 0;
  scroll-snap-align: start;
  display: flex;
  flex-direction: row;
  align-items: center;
  text-align: left;
  gap: 14px;
  padding: 6px 16px;
  background: none;
  border: none;
  border-radius: 0;
  border-right: 1px solid var(--b2b-gold-faint);
}
.lp-b2b-system__card:last-child { border-right: none; }

.lp-b2b-system__card-icon {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.lp-b2b-system__card-icon svg {
  width: 100%;
  height: 100%;
  stroke: var(--b2b-gold);
  color: var(--b2b-gold);
  stroke-width: 1.4;
}

.lp-b2b-system__card-body {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.lp-b2b-system__card-title {
  font-family: 'Archivo Black', 'Inter', sans-serif;
  font-size: 0.9rem;
  font-weight: 900;
  letter-spacing: 0.03em;
  color: #fff;
  margin: 0;
  text-transform: uppercase;
  line-height: 1.15;
}

.lp-b2b-system__card-text {
  font-family: 'Inter', sans-serif;
  font-size: 0.86rem;
  font-weight: 500;
  line-height: 1.3;
  color: #fff;
  margin: 0;
}

/* ── Dots ── */
.lp-b2b-system__dots {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  justify-content: center;
  gap: 8px;
}

.lp-b2b-system__dots li { display: inline-flex; }

.lp-b2b-system__dot {
  width: 8px;
  height: 8px;
  padding: 0;
  border: none;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  cursor: pointer;
  transition: background 0.2s, transform 0.2s;
}
.lp-b2b-system__dot.is-active {
  background: var(--b2b-gold);
  transform: scale(1.15);
}
.lp-b2b-system__dot:hover { background: rgba(232, 184, 46, 0.6); }
.lp-b2b-system__dot:focus-visible { outline: 2px solid var(--b2b-gold); outline-offset: 3px; }

/* ── Tablet ≥ 750px ── */
@media (min-width: 750px) {
  .lp-b2b-system { padding: 64px 0 80px; }
  .lp-b2b-system__inner { gap: 28px; }

  .lp-b2b-system__head { padding: 0 48px; gap: 10px; }
  .lp-b2b-system__heading { font-size: 1.2rem; }
  .lp-b2b-system__sub { font-size: 2rem; }

  .lp-b2b-system__track {
    padding: 4px 32px 12px;
    gap: 0;
  }

  .lp-b2b-system__card {
    flex: 0 0 50%;
    padding: 10px 22px;
    gap: 16px;
    border-right: 1px solid var(--b2b-gold-faint);
  }
  .lp-b2b-system__card:nth-child(2n) { border-right: none; }

  .lp-b2b-system__card-icon { width: 56px; height: 56px; }
  .lp-b2b-system__card-title { font-size: 1rem; }
  .lp-b2b-system__card-text { font-size: 0.9rem; }
}

/* ── Desktop ≥ 1100px ── */
@media (min-width: 1100px) {
  .lp-b2b-system { padding: 80px 0 96px; }
  .lp-b2b-system__inner { gap: 36px; }

  .lp-b2b-system__head { padding: 0 64px; gap: 12px; }
  .lp-b2b-system__heading { font-size: 1.3rem; }
  .lp-b2b-system__sub { font-size: 2.4rem; }

  .lp-b2b-system__track {
    padding: 4px 48px 14px;
    gap: 0;
  }

  .lp-b2b-system__card {
    flex: 0 0 33.333%;
    padding: 12px 28px;
    gap: 18px;
    border-right: 1px solid var(--b2b-gold-faint);
  }
  .lp-b2b-system__card:nth-child(2n) { border-right: 1px solid var(--b2b-gold-faint); }
  .lp-b2b-system__card:nth-child(3n) { border-right: none; }

  .lp-b2b-system__card-icon { width: 60px; height: 60px; }
  .lp-b2b-system__card-title { font-size: 1.08rem; letter-spacing: 0.03em; }
  .lp-b2b-system__card-text { font-size: 0.96rem; }
}

{% endstylesheet %}

{% schema %}
{
  "name": "LP B2B — Sistema",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Titolo (piccolo, sopra)",
      "default": "Non una semplice scarpa."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sottotitolo (grande, oro)",
      "default": "Un segno distintivo per la tua flotta."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icona",
          "options": [
            { "value": "palette",   "label": "Tavolozza" },
            { "value": "tag",       "label": "Etichetta" },
            { "value": "bolt",      "label": "Fulmine" },
            { "value": "ruler",     "label": "Righello" },
            { "value": "recycle",   "label": "Riciclo" },
            { "value": "user-card", "label": "Scheda utente" },
            { "value": "headset",   "label": "Cuffie" },
            { "value": "shield",    "label": "Scudo" },
            { "value": "truck",     "label": "Camion" },
            { "value": "wrench",    "label": "Chiave inglese" }
          ],
          "default": "palette"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titolo"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Descrizione"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP B2B — Sistema",
      "blocks": [
        { "type": "feature", "settings": { "icon": "palette",   "title": "Personalizzazione aziendale", "text": "Colori e logo per rendere riconoscibili i tuoi autisti." }},
        { "type": "feature", "settings": { "icon": "bolt",      "title": "Fast Wear System",            "text": "Più praticità quando l'autista scende dal camion." }},
        { "type": "feature", "settings": { "icon": "ruler",     "title": "Gestione taglie",             "text": "Sviluppiamo la base taglie aziendale, gestiamo lo storico ordini e il cambio taglia rapido." }},
        { "type": "feature", "settings": { "icon": "recycle",   "title": "Cambio gomme gratuito",       "text": "Sostituzione suole consumate gratuita previa verifica dell'integrità della tomaia." }},
        { "type": "feature", "settings": { "icon": "user-card", "title": "Scheda autista",              "text": "Taglie, cambi, sostituzioni, riparazioni e perdite tracciate per ogni autista." }},
        { "type": "feature", "settings": { "icon": "headset",   "title": "Supporto diretto",            "text": "Un referente chiaro per ordini, riordini e assistenza." }}
      ]
    }
  ]
}
{% endschema %}
