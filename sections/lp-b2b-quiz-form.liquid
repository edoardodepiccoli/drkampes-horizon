  }

  .lp-b2b-quiz-form__close { top: 18px; right: 18px; width: 44px; height: 44px; }
  .lp-b2b-quiz-form__close svg { width: 20px; height: 20px; }

  .lp-b2b-quiz-form__progress { padding: 22px 72px 0 22px; }

  .lp-b2b-quiz-form__step { padding: 18px 28px 28px; }
