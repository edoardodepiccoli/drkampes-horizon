<style>
  #shopify-section-{{ section.id }} .instagram-feed__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    justify-items: center;
  }

  #shopify-section-{{ section.id }} .instagram-feed__item {
    width: 100%;
    max-width: 540px;
  }

  #shopify-section-{{ section.id }} .instagram-feed__item .instagram-media {
    margin: 0 auto !important;
    max-width: 100% !important;
    width: 100% !important;
  }

  #shopify-section-{{ section.id }} .instagram-feed__footer {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  #shopify-section-{{ section.id }} .instagram-feed__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .instagram-feed__cta svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .instagram-feed__grid {
      grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
      justify-items: stretch;
    }

    #shopify-section-{{ section.id }} .instagram-feed__item {
      max-width: 100%;
    }
  }
</style>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- if section.blocks.size > 0 -%}
    <div class="instagram-feed__grid">
      {%- for block in section.blocks -%}
        {%- assign reel_url = block.settings.url -%}
        {%- if reel_url != blank -%}
          <div class="instagram-feed__item" {{ block.shopify_attributes }}>
            <blockquote
              class="instagram-media"
              data-instgrm-permalink="{{ reel_url }}"
              data-instgrm-version="14"
              style="background:#FFF; border:0; border-radius:3px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); margin:0; max-width:100%; min-width:326px; padding:0; width:100%;"
            ></blockquote>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <script async defer src="//www.instagram.com/embed.js"></script>
  {%- endif -%}

  {%- if section.settings.instagram_url != blank -%}
    <div class="instagram-feed__footer">
      <a
        href="{{ section.settings.instagram_url }}"
        class="button button--secondary instagram-feed__cta"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <circle cx="12" cy="12" r="4"/>
          <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
        </svg>
        Seguici su Instagram
      </a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Instagram Reels",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 9,
  "settings": [
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram profile URL"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        {
          "type": "url",
          "id": "url",
          "label": "Reel URL",
          "info": "Paste the full Instagram reel URL (e.g. https://www.instagram.com/reel/ABC123/)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Reels",
      "category": "Social",
      "blocks": [
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" }
      ]
    }
  ]
}
{% endschema %}
