<section class="lp-navbar" style="--lp-navbar-logo-h: {{ section.settings.logo_max_height | default: 56 }}px;">
  <div class="lp-navbar__inner">
    <div class="lp-navbar__logo-wrap">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo
           | image_url: width: 600
           | image_tag:
               class: 'lp-navbar__logo',
               loading: 'eager',
               fetchpriority: 'high',
               widths: '180,240,320,480,600',
               sizes: '(min-width:750px) 260px, 200px',
               alt: section.settings.logo.alt | default: shop.name
        }}
      {%- else -%}
        <span class="lp-navbar__logo-fallback">{{ shop.name }}</span>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      {%- capture items_html -%}
        {%- for block in section.blocks -%}
          <li class="lp-navbar__item{% if block.settings.hide_on_mobile %} lp-navbar__item--desktop-only{% endif %}" {{ block.shopify_attributes }}>
            <span class="lp-navbar__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'truck' -%}
                  <svg viewBox="0 0 32 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 4h18v13H1z"/><path d="M19 9h6l5 4v4h-11z"/><circle cx="8" cy="20" r="2.5"/><circle cx="24" cy="20" r="2.5"/></svg>
                {%- when 'swap' -%}
                  <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a10 10 0 0 1 17-7l2 2"/><path d="M23 3v6h-6"/><path d="M24 14a10 10 0 0 1-17 7l-2-2"/><path d="M5 25v-6h6"/></svg>
                {%- when 'shield' -%}
                  <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2 4 6v8c0 6 4 10 10 12 6-2 10-6 10-12V6z"/><path d="M9.5 14l3 3 6-6"/></svg>
                {%- when 'medal' -%}
                  <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="14" cy="17" r="7"/><path d="M9 12 6 2h6l3 7"/><path d="M19 12l3-10h-6l-3 7"/></svg>
                {%- when 'lock' -%}
                  <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="12" width="16" height="12" rx="1.5"/><path d="M9 12V8a5 5 0 0 1 10 0v4"/></svg>
                {%- when 'star' -%}
                  <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="m14 3 3.5 7 7.5 1-5.5 5.3 1.3 7.7L14 20.5 7.2 24l1.3-7.7L3 11l7.5-1z"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              {%- endcase -%}
            </span>
            <span class="lp-navbar__text">
              <span class="lp-navbar__line1">{{ block.settings.line1 }}</span>
              {%- if block.settings.line2 != blank -%}
                <span class="lp-navbar__line2">{{ block.settings.line2 }}</span>
              {%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      {%- endcapture -%}

      <div class="lp-navbar__marquee" aria-label="Vantaggi">
        <ul class="lp-navbar__track" role="list">
          {{ items_html }}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}

.lp-navbar {
  width: 100%;
  background: #000;
  color: #fff;
  box-sizing: border-box;
}

.lp-navbar__inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 14px;
  box-sizing: border-box;
}

.lp-navbar__logo-wrap {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  flex-shrink: 0;
}

.lp-navbar__logo {
  display: block;
  max-height: calc(var(--lp-navbar-logo-h, 56px) * 0.7);
  width: auto;
  height: auto;
  object-fit: contain;
}

.lp-navbar__logo-fallback {
  font-family: 'Archivo Black', sans-serif;
  color: #fff;
  font-size: 1.4rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.lp-navbar__marquee {
  overflow: hidden;
  flex: 0 1 auto;
  min-width: 0;
}

.lp-navbar__track {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: nowrap;
  gap: 10px;
}

.lp-navbar__item {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #fff;
  flex-shrink: 0;
}

/* Mobile: hide items flagged desktop-only */
.lp-navbar__item--desktop-only {
  display: none;
}

.lp-navbar__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  flex-shrink: 0;
}
.lp-navbar__icon svg {
  width: 16px;
  height: 16px;
  display: block;
}

.lp-navbar__text {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
}

.lp-navbar__line1,
.lp-navbar__line2 {
  font-family: 'Inter', system-ui, sans-serif;
  font-weight: 600;
  font-size: 0.6rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: #fff;
  white-space: nowrap;
}

@media (min-width: 750px) {
  .lp-navbar__inner {
    gap: 32px;
    padding: 18px 32px;
    max-width: 1400px;
    margin: 0 auto;
  }
  .lp-navbar__logo {
    max-height: calc(var(--lp-navbar-logo-h, 56px) + 8px);
  }
  .lp-navbar__item--desktop-only {
    display: inline-flex;
  }
  .lp-navbar__track {
    gap: 40px;
  }
  .lp-navbar__item {
    gap: 12px;
  }
  .lp-navbar__icon svg {
    width: 30px;
    height: 30px;
  }
  .lp-navbar__line1,
  .lp-navbar__line2 {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    font-weight: 600;
  }
}

@media (min-width: 1100px) {
  .lp-navbar__track {
    gap: 56px;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "LP — Navbar",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (sinistra)"
    },
    {
      "type": "number",
      "id": "logo_max_height",
      "label": "Altezza max logo (px)",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icona",
          "default": "truck",
          "options": [
            { "value": "truck",  "label": "Camion (spedizione)" },
            { "value": "swap",   "label": "Frecce (cambio/reso)" },
            { "value": "shield", "label": "Scudo (garanzia)" },
            { "value": "medal",  "label": "Medaglia (qualità)" },
            { "value": "lock",   "label": "Lucchetto (sicurezza)" },
            { "value": "star",   "label": "Stella (recensioni)" },
            { "value": "check",  "label": "Check generico" }
          ]
        },
        {
          "type": "text",
          "id": "line1",
          "label": "Riga 1",
          "default": "SPEDIZIONE"
        },
        {
          "type": "text",
          "id": "line2",
          "label": "Riga 2",
          "default": "GRATUITA"
        },
        {
          "type": "checkbox",
          "id": "hide_on_mobile",
          "label": "Nascondi su mobile",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP — Navbar",
      "blocks": [
        { "type": "trust_item", "settings": { "icon": "truck",  "line1": "SPEDIZIONE",   "line2": "GRATUITA", "hide_on_mobile": false } },
        { "type": "trust_item", "settings": { "icon": "swap",   "line1": "CAMBIO TAGLIA","line2": "GRATUITO", "hide_on_mobile": true } },
        { "type": "trust_item", "settings": { "icon": "shield", "line1": "GARANZIA",     "line2": "3 ANNI",   "hide_on_mobile": false } }
      ]
    }
  ]
}
{% endschema %}
