<header class="lp-navbar" style="--lp-navbar-logo-h: {{ section.settings.logo_max_height | default: 40 }}px;">
  <div class="lp-navbar__inner">

    <a class="lp-navbar__logo-link" href="{{ section.settings.logo_url | default: '/' }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 480 | image_tag:
            class: 'lp-navbar__logo',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '180,240,320,480',
            sizes: '(min-width:750px) 220px, 160px',
            alt: section.settings.logo.alt | default: shop.name }}
      {%- else -%}
        <span class="lp-navbar__logo-fallback">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    {%- if section.blocks.size > 0 -%}
      <ul class="lp-navbar__items lp-navbar__items--{{ section.settings.mobile_layout | default: 'stack' }}">
        {%- for block in section.blocks -%}
          <li class="lp-navbar__item" {{ block.shopify_attributes }}>
            <span class="lp-navbar__item-icon" aria-hidden="true">
              {%- if block.settings.icon_image != blank -%}
                {{ block.settings.icon_image | image_url: width: 80 | image_tag:
                    class: 'lp-navbar__item-icon-img',
                    loading: 'eager',
                    widths: '40,60,80',
                    alt: '' }}
              {%- else -%}
                {%- case block.settings.icon_preset -%}
                  {%- when 'tshirt' -%}
                    <svg class="lp-navbar__item-icon-svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7l4-4h8l4 4-3 3v11H7V10L4 7z"/><path d="M9 3a3 3 0 006 0"/></svg>
                  {%- when 'delivery' -%}
                    <svg class="lp-navbar__item-icon-svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v4h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                  {%- when 'shield' -%}
                    <svg class="lp-navbar__item-icon-svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                  {%- when 'check' -%}
                    <svg class="lp-navbar__item-icon-svg" viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                {%- endcase -%}
              {%- endif -%}
            </span>
            <span class="lp-navbar__item-label">{{ block.settings.label }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

  </div>
</header>

{% stylesheet %}

.lp-navbar {
  width: 100%;
  background: var(--lp-color-black);
  box-sizing: border-box;
}

.lp-navbar__inner {
  display: flex;
  flex-direction: column;
  gap: var(--lp-space-3);
  padding: var(--lp-space-3) var(--lp-section-pad-x);
  box-sizing: border-box;
  width: 100%;
}

/* ---- Logo ---- */

.lp-navbar__logo-link {
  display: inline-flex;
  align-items: center;
  text-decoration: none;
  flex-shrink: 0;
}

.lp-navbar__logo {
  display: block;
  max-height: var(--lp-navbar-logo-h, 40px);
  max-width: 100%;
  width: auto;
  height: auto;
  object-fit: contain;
}

.lp-navbar__logo-fallback {
  font-family: var(--lp-font-display);
  color: var(--lp-color-text-on-dark);
  font-size: var(--lp-fs-lg);
  letter-spacing: var(--lp-ls-wide);
  text-transform: uppercase;
}

/* ---- Items list ---- */

.lp-navbar__items {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: row;
  gap: var(--lp-space-4);
}

/* stack modifier: 3-col grid on mobile */
.lp-navbar__items--stack {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--lp-space-3);
}

/* inline modifier: single row on mobile */
.lp-navbar__items--inline {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: var(--lp-space-3);
}

/* ---- Individual item ---- */

.lp-navbar__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--lp-space-1);
}

.lp-navbar__item-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.lp-navbar__item-icon-svg {
  width: 22px;
  height: 22px;
  stroke: var(--lp-color-gold);
  flex-shrink: 0;
}

.lp-navbar__item-icon-img {
  width: 22px;
  height: 22px;
  object-fit: contain;
}

.lp-navbar__item-label {
  font-family: var(--lp-font-display);
  font-size: var(--lp-fs-micro);
  letter-spacing: var(--lp-ls-wide);
  text-transform: uppercase;
  color: var(--lp-color-text-on-dark);
  line-height: var(--lp-lh-snug);
  text-align: center;
}

/* ---- Desktop (≥750px): single row, logo left / items right ---- */

@media (min-width: 750px) {
  .lp-navbar__inner {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--lp-space-7);
    padding: var(--lp-space-4) var(--lp-section-pad-x-md);
  }

  .lp-navbar__items,
  .lp-navbar__items--stack,
  .lp-navbar__items--inline {
    display: flex;
    flex-direction: row;
    grid-template-columns: unset;
    gap: var(--lp-space-7);
  }

  .lp-navbar__item {
    align-items: center;
  }

  .lp-navbar__item-icon-svg {
    width: 24px;
    height: 24px;
  }

  .lp-navbar__item-icon-img {
    width: 24px;
    height: 24px;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "LP — Navbar",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "number",
      "id": "logo_max_height",
      "label": "Altezza max logo (px)",
      "default": 40
    },
    {
      "type": "url",
      "id": "logo_url",
      "label": "URL logo"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Layout mobile",
      "options": [
        { "value": "stack", "label": "Griglia 3 colonne" },
        { "value": "inline", "label": "Riga orizzontale" }
      ],
      "default": "stack"
    }
  ],
  "blocks": [
    {
      "type": "nav_item",
      "name": "Elemento navbar",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icona (immagine, opzionale)"
        },
        {
          "type": "select",
          "id": "icon_preset",
          "label": "Icona (preset)",
          "options": [
            { "value": "tshirt",   "label": "T-shirt" },
            { "value": "delivery", "label": "Consegna" },
            { "value": "shield",   "label": "Scudo / Garanzia" },
            { "value": "check",    "label": "Spunta" },
            { "value": "none",     "label": "Nessuna" }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Testo",
          "default": "Vantaggio"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP — Navbar",
      "blocks": [
        { "type": "nav_item", "settings": { "icon_preset": "tshirt",   "label": "T-SHIRT GRATIS" } },
        { "type": "nav_item", "settings": { "icon_preset": "delivery", "label": "SPEDIZIONE GRATIS" } },
        { "type": "nav_item", "settings": { "icon_preset": "shield",   "label": "GARANZIA 3 ANNI" } }
      ]
    }
  ]
}
{% endschema %}
