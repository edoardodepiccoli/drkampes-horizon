<section class="lp-reviews" data-lp-reviews-id="{{ section.id }}">
  <div class="lp-reviews__inner">

    <header class="lp-reviews__head">
      <div class="lp-reviews__head-left">
        {%- if section.settings.eyebrow != blank -%}
          <div class="lp-sec__eyebrow lp-reviews__eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        <h2 class="lp-sec__h2 lp-reviews__h2">{{ section.settings.heading }}</h2>
      </div>
      <div class="lp-reviews__google">
        <span class="lp-reviews__google-logo" aria-hidden="true">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
        </span>
        <div class="lp-reviews__google-meta">
          <div class="lp-reviews__google-rating">
            <span class="lp-reviews__google-num">{{ section.settings.average_rating | default: '4.9' }}</span>
            <span class="lp-reviews__google-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          </div>
          <div class="lp-reviews__google-count">{{ section.settings.review_count_label | default: '127 recensioni Google' }}</div>
        </div>
      </div>
    </header>

    {%- assign initial_show = section.settings.initial_count | default: 6 -%}
    <ul class="lp-reviews__list" data-lp-reviews-list>
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <li class="lp-rev{% if forloop.index > initial_show %} lp-rev--hidden{% endif %}" {{ block.shopify_attributes }}>
            <header class="lp-rev__head">
              {%- if block.settings.avatar != blank -%}
                {{ block.settings.avatar | image_url: width: 96 | image_tag: class: 'lp-rev__avatar', loading: 'lazy', alt: block.settings.name }}
              {%- else -%}
                {%- assign palette = 'a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p,q,r,s,t,u,v,w,x,y,z' | split: ',' -%}
                {%- assign hue_idx = block.settings.name | size | modulo: 7 -%}
                {%- assign avatar_hue = '#2e7d32,#1565c0,#6a1b9a,#bf360c,#5d4037,#37474f,#c62828' | split: ',' -%}
                <span class="lp-rev__avatar lp-rev__avatar--initial" style="background:{{ avatar_hue[hue_idx] }};" aria-hidden="true">{{ block.settings.name | slice: 0 | upcase }}</span>
              {%- endif -%}
              <div class="lp-rev__id">
                <p class="lp-rev__name">{{ block.settings.name }}</p>
                <p class="lp-rev__meta">
                  <span class="lp-rev__stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                  <span class="lp-rev__sep" aria-hidden="true">&middot;</span>
                  <span class="lp-rev__time">{{ block.settings.time_ago | default: '2 mesi fa' }}</span>
                </p>
              </div>
              <span class="lp-rev__verified" title="Recensione verificata da Google">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                Google
              </span>
            </header>
            <p class="lp-rev__text">{{ block.settings.text }}</p>
            {%- if block.settings.photo_1 != blank or block.settings.photo_2 != blank or block.settings.photo_3 != blank -%}
              <div class="lp-rev__photos">
                {%- if block.settings.photo_1 != blank -%}
                  {{ block.settings.photo_1 | image_url: width: 240 | image_tag: class: 'lp-rev__photo', loading: 'lazy' }}
                {%- endif -%}
                {%- if block.settings.photo_2 != blank -%}
                  {{ block.settings.photo_2 | image_url: width: 240 | image_tag: class: 'lp-rev__photo', loading: 'lazy' }}
                {%- endif -%}
                {%- if block.settings.photo_3 != blank -%}
                  {{ block.settings.photo_3 | image_url: width: 240 | image_tag: class: 'lp-rev__photo', loading: 'lazy' }}
                {%- endif -%}
              </div>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- if section.blocks.size > initial_show -%}
      {%- assign remaining = section.blocks.size | minus: initial_show -%}
      <button type="button" class="lp-reviews__more" data-lp-reviews-more>
        Mostra le altre {{ remaining }} recensioni
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
    {%- endif -%}

    {%- if section.settings.google_url != blank -%}
      <a class="lp-reviews__google-link" href="{{ section.settings.google_url }}" target="_blank" rel="noopener">
        Vedi tutte le recensioni su Google
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><polyline points="7 7 17 7 17 17"/></svg>
      </a>
    {%- endif -%}

  </div>
</section>

{%- if section.settings.google_reviews_json_url != blank -%}
<script>
(function () {
  var url = {{ section.settings.google_reviews_json_url | json }};
  var sid = '{{ section.id }}';
  var root = document.querySelector('[data-lp-reviews-id="' + sid + '"]');
  if (!root || !url) return;
  var list = root.querySelector('[data-lp-reviews-list]');
  if (!list) return;

  fetch(url, { credentials: 'omit' })
    .then(function (r) { return r.ok ? r.json() : null; })
    .then(function (reviews) {
      if (!reviews || !reviews.length) return;
      var initialShow = {{ section.settings.initial_count | default: 6 }};
      list.innerHTML = reviews.map(function (r, i) {
        var hidden = i >= initialShow ? ' lp-rev--hidden' : '';
        var initial = (r.name || '?').charAt(0).toUpperCase();
        var hueArr = ['#2e7d32','#1565c0','#6a1b9a','#bf360c','#5d4037','#37474f','#c62828'];
        var hue = hueArr[(r.name || '').length % 7];
        var photos = (r.photos || []).map(function (p) {
          return '<img class="lp-rev__photo" src="' + p + '" loading="lazy">';
        }).join('');
        var photoBlock = photos ? '<div class="lp-rev__photos">' + photos + '</div>' : '';
        return '<li class="lp-rev' + hidden + '">'
          + '<header class="lp-rev__head">'
            + (r.avatar
                ? '<img class="lp-rev__avatar" src="' + r.avatar + '" loading="lazy" alt="">'
                : '<span class="lp-rev__avatar lp-rev__avatar--initial" style="background:' + hue + ';" aria-hidden="true">' + initial + '</span>')
            + '<div class="lp-rev__id">'
              + '<p class="lp-rev__name">' + (r.name || '') + '</p>'
              + '<p class="lp-rev__meta">'
                + '<span class="lp-rev__stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>'
                + '<span class="lp-rev__sep" aria-hidden="true">&middot;</span>'
                + '<span class="lp-rev__time">' + (r.time_ago || '') + '</span>'
              + '</p>'
            + '</div>'
            + '<span class="lp-rev__verified" title="Recensione verificata da Google">'
              + '<svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>'
              + ' Google'
            + '</span>'
          + '</header>'
          + '<p class="lp-rev__text">' + (r.text || '') + '</p>'
          + photoBlock
        + '</li>';
      }).join('');

      var moreBtn = root.querySelector('[data-lp-reviews-more]');
      if (moreBtn) {
        if (reviews.length > initialShow) {
          moreBtn.style.display = '';
          moreBtn.firstChild.nodeValue = ' Mostra le altre ' + (reviews.length - initialShow) + ' recensioni ';
        } else {
          moreBtn.style.display = 'none';
        }
      }
    })
    .catch(function () { /* silent fallback to liquid blocks */ });
})();
</script>
{%- endif -%}

<script>
(function () {
  var sid = '{{ section.id }}';
  var root = document.querySelector('[data-lp-reviews-id="' + sid + '"]');
  if (!root) return;
  var moreBtn = root.querySelector('[data-lp-reviews-more]');
  if (!moreBtn) return;
  moreBtn.addEventListener('click', function () {
    root.querySelectorAll('.lp-rev--hidden').forEach(function (el) {
      el.classList.remove('lp-rev--hidden');
    });
    moreBtn.style.display = 'none';
  });
})();
</script>

{% stylesheet %}

.lp-reviews {
  padding: 36px 16px 40px;
  background: #fff;
  color: #111;
}

.lp-reviews__inner {
  max-width: 580px;
  margin: 0 auto;
}

.lp-reviews__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 14px;
}

.lp-reviews__head-left { flex: 1; min-width: 0; }

.lp-reviews .lp-sec__eyebrow {
  color: #2e7d32;
  margin-bottom: 4px;
}

.lp-reviews .lp-sec__h2 {
  color: #111;
  font-size: 1.25rem;
  margin: 0;
  line-height: 1.2;
}

.lp-reviews__google {
  display: flex;
  align-items: center;
  gap: 8px;
  background: #f7f7f7;
  padding: 8px 10px;
  flex-shrink: 0;
}

.lp-reviews__google-logo svg {
  width: 22px;
  height: 22px;
  display: block;
}

.lp-reviews__google-meta {
  display: flex;
  flex-direction: column;
  gap: 1px;
}

.lp-reviews__google-rating {
  display: flex;
  align-items: center;
  gap: 5px;
  line-height: 1;
}

.lp-reviews__google-num {
  font-family: 'Archivo Black', sans-serif;
  font-size: 0.95rem;
  color: #111;
}

.lp-reviews__google-stars {
  color: #fbbc05;
  font-size: 0.78rem;
  letter-spacing: 1px;
  line-height: 1;
}

.lp-reviews__google-count {
  font-size: 0.66rem;
  color: #555;
  white-space: nowrap;
}

.lp-reviews__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.lp-rev {
  background: #fafafa;
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  border-left: 3px solid #fbbc05;
}

.lp-rev--hidden { display: none; }

.lp-rev__head {
  display: flex;
  align-items: center;
  gap: 10px;
}

.lp-rev__avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  flex-shrink: 0;
  object-fit: cover;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Archivo Black', sans-serif;
  font-size: 1rem;
  color: #fff;
  background: #999;
}

.lp-rev__id {
  flex: 1;
  min-width: 0;
}

.lp-rev__name {
  font-size: 0.88rem;
  font-weight: 700;
  color: #111;
  margin: 0;
  line-height: 1.2;
}

.lp-rev__meta {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 0.72rem;
  color: #888;
  margin: 2px 0 0;
}

.lp-rev__stars {
  color: #fbbc05;
  letter-spacing: 1px;
  font-size: 0.8rem;
  line-height: 1;
}

.lp-rev__sep { color: #ccc; }

.lp-rev__verified {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  font-size: 0.66rem;
  color: #1565c0;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  flex-shrink: 0;
}

.lp-rev__verified svg {
  width: 11px;
  height: 11px;
  stroke: #1565c0;
}

.lp-rev__text {
  font-size: 0.88rem;
  color: #222;
  line-height: 1.55;
  margin: 0;
}

.lp-rev__photos {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

.lp-rev__photo {
  width: 64px;
  height: 64px;
  object-fit: cover;
}

.lp-reviews__more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  width: 100%;
  margin-top: 14px;
  padding: 12px 16px;
  background: #fff;
  border: 1.5px solid #111;
  font-family: var(--font-heading--family, inherit);
  font-size: 0.82rem;
  font-weight: 800;
  color: #111;
  cursor: pointer;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  border-radius: 0;
  transition: background 0.15s, color 0.15s;
}
.lp-reviews__more:hover { background: #111; color: #fff; }
.lp-reviews__more svg { width: 14px; height: 14px; stroke: currentColor; }

.lp-reviews__google-link {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  margin-top: 12px;
  font-size: 0.78rem;
  color: #1565c0;
  font-weight: 600;
  text-decoration: none;
}
.lp-reviews__google-link:hover { text-decoration: underline; color: #1565c0; }
.lp-reviews__google-link svg { width: 12px; height: 12px; stroke: #1565c0; }

@media (min-width: 750px) {
  .lp-reviews { padding: 56px 40px 64px; }
  .lp-reviews__inner { max-width: 1100px; }
  .lp-reviews .lp-sec__h2 { font-size: 1.6rem; }
  .lp-reviews__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "LP — Recensioni",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Recensioni Google"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo sezione",
      "default": "Cosa dicono i clienti"
    },
    {
      "type": "text",
      "id": "average_rating",
      "label": "Rating medio",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "review_count_label",
      "label": "Etichetta numero recensioni",
      "default": "68 recensioni Google"
    },
    {
      "type": "url",
      "id": "google_url",
      "label": "Link Google reviews (apre in nuova tab)"
    },
    {
      "type": "number",
      "id": "initial_count",
      "label": "Recensioni visibili inizialmente",
      "default": 6
    },
    {
      "type": "header",
      "content": "Auto-fetch (opzionale)"
    },
    {
      "type": "url",
      "id": "google_reviews_json_url",
      "label": "URL JSON recensioni (sovrascrive i blocchi)",
      "info": "Endpoint che restituisce array JSON con campi: name, time_ago, text, avatar (URL), photos (array URL). Se vuoto, usa i blocchi sotto."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Recensione",
      "settings": [
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar (opzionale, fallback iniziale colorata)"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nome cliente"
        },
        {
          "type": "text",
          "id": "time_ago",
          "label": "Quando (es. 3 mesi fa)",
          "default": "2 mesi fa"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Testo recensione"
        },
        {
          "type": "image_picker",
          "id": "photo_1",
          "label": "Foto 1 (opzionale)"
        },
        {
          "type": "image_picker",
          "id": "photo_2",
          "label": "Foto 2 (opzionale)"
        },
        {
          "type": "image_picker",
          "id": "photo_3",
          "label": "Foto 3 (opzionale)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP — Recensioni",
      "blocks": [
        { "type": "review", "settings": { "name": "Marco P.",        "time_ago": "1 settimana fa",  "text": "5 stelle non bastano, ce ne vorrebbero 10! La qualità del prodotto ma SOPRATTUTTO la cortesia e l'assistenza nel post vendita." } },
        { "type": "review", "settings": { "name": "Giorgio B.",      "time_ago": "2 settimane fa", "text": "Indosso tutti i giorni con orgoglio una scarpa che rende ad ogni passo una sensazione di benessere. Gioielli d'artigianato ITALIANO!" } },
        { "type": "review", "settings": { "name": "Vincenzo D. M.",  "time_ago": "3 settimane fa", "text": "Claudio è un genio: scarpe non solo comode ma anche eleganti, sicure, antinfortunistiche, idrorepellenti e fastwear. Le uso nel fango e nell'acqua ovunque." } },
        { "type": "review", "settings": { "name": "Igor R.",         "time_ago": "1 mese fa",      "text": "Per quanto riguarda le scarpe credo di aver fatto la scelta della vita. Calzano in maniera perfetta, non puzzano, son morbide nella camminata ma allo stesso tempo resistenti." } },
        { "type": "review", "settings": { "name": "Marco O.",        "time_ago": "1 mese fa",      "text": "Ottima qualità, resistenti, antiscivolo e la cosa più bella, senza lacci con il tallone che si piega per salire e scendere dalla scaletta." } },
        { "type": "review", "settings": { "name": "Natalia G.",      "time_ago": "2 mesi fa",      "text": "Migliore scarpa antinfortunistica! Darei più di 5 stelle. Comode, facili da indossare. Io sono una donna camionista. Dr Kampes hanno creato una vera scarpa." } },
        { "type": "review", "settings": { "name": "Danilo L. F.",    "time_ago": "2 mesi fa",      "text": "Scarpe di altissimo livello sulla comodità e prestazioni, provate sulla neve, fango, pioggia. Piede sempre asciutto." } },
        { "type": "review", "settings": { "name": "Maikol M.",       "time_ago": "3 mesi fa",      "text": "Sono scarpe di qualità fatte su misura per noi camionisti ma non solo. L'eccellenza di un prodotto made in Italy per la sicurezza sul lavoro." } },
        { "type": "review", "settings": { "name": "Ivano D.",        "time_ago": "3 mesi fa",      "text": "Scarpe bellissime, comode e pratiche per il nostro lavoro da autista. Mi hanno contattato dopo l'ordine per sapere se mi fossi trovato bene." } },
        { "type": "review", "settings": { "name": "Damiano M.",      "time_ago": "4 mesi fa",      "text": "Prima ogni 6 mesi cambiavo scarpe, ora sono 6 mesi che le uso e sono ancora perfette. Made in Italy, comode e fatte bene." } },
