        { "type": "review", "settings": { "name": "Thierry N.",      "time_ago": "10 mesi fa",     "text": "Scarpe di altissima qualità! Consiglio vivamente! Sono dei professionisti!" } },
        { "type": "review", "settings": { "name": "Maria del Carmen S.", "time_ago": "1 anno fa",  "text": "Ho provato altri prodotti e la verità è che il vostro è migliore per comodità, materiale, ecc. Ve li consiglio al 100%, sono fantastici e il venditore è imbattibile." } }
      ]
    }
  ]
}
{% endschema %}
