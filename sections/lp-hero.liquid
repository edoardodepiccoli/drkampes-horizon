{%- assign img           = section.settings.image -%}
{%- assign sec_img       = section.settings.secondary_image -%}
{%- assign headline      = section.settings.headline | default: 'SCENDI DAL CAMION IN 2 SECONDI.' -%}
{%- assign highlight     = section.settings.headline_highlight | default: 'IN 2 SECONDI.' -%}
{%- assign cta_url       = section.settings.cta_url | default: '#acquista' -%}

{%- comment -%} Split headline around the highlight phrase {%- endcomment -%}
{%- assign hl_index = headline | split: highlight | first -%}
{%- assign before_hl = hl_index -%}
{%- if highlight != blank and headline contains highlight -%}
  {%- assign before_hl = headline | split: highlight | first -%}
  {%- assign hl_found = true -%}
{%- else -%}
  {%- assign hl_found = false -%}
{%- endif -%}

<section class="lp-hero lp-sec lp-sec--dark">
  <div class="lp-hero__inner">

    <!-- ── EYEBROW ── -->
    {%- if section.settings.eyebrow_text != blank -%}
      <p class="lp-hero__eyebrow">{{ section.settings.eyebrow_text }}</p>
    {%- endif -%}

    <!-- ── H1 ── -->
    <h1 class="lp-hero__title">
      {%- if hl_found -%}
        {{- before_hl -}}<em class="lp-hero__title--highlight">{{- highlight -}}</em>
      {%- else -%}
        {{- headline }} <em class="lp-hero__title--highlight">{{- highlight -}}</em>
      {%- endif -%}
    </h1>

    <!-- ── TAGLINE ── -->
    {%- if section.settings.tagline_1 != blank or section.settings.tagline_2 != blank -%}
      <p class="lp-hero__tagline">
        {%- if section.settings.tagline_1 != blank -%}{{- section.settings.tagline_1 -}}{%- endif -%}
        {%- if section.settings.tagline_1 != blank and section.settings.tagline_2 != blank -%}<br>{%- endif -%}
        {%- if section.settings.tagline_2 != blank -%}{{- section.settings.tagline_2 -}}{%- endif -%}
      </p>
    {%- endif -%}

    <!-- ── MAIN HERO IMAGE ── -->
    <div class="lp-hero__media">
      {%- if img != blank -%}
        {{ img | image_url: width: 1200 | image_tag:
           class: 'lp-hero__media-img',
           loading: 'eager',
           fetchpriority: 'high',
           widths: '400,600,800,1200',
           sizes: '(min-width:750px) 580px, 100vw',
           alt: img.alt }}
      {%- else -%}
        <div class="lp-hero__media-placeholder">Carica immagine prodotto</div>
      {%- endif -%}
    </div>

    <!-- ── FEATURE BLOCKS ── -->
    <div class="lp-hero__features">

      <!-- Feature 1: FASTWEAR -->
      <div class="lp-hero__feature">
        <div class="lp-hero__feature-media">
          {%- if sec_img != blank -%}
            {{ sec_img | image_url: width: 400 | image_tag:
               class: 'lp-hero__feature-img',
               loading: 'lazy',
               widths: '200,400',
               sizes: '(min-width:750px) 200px, 50vw',
               alt: sec_img.alt }}
          {%- else -%}
            <div class="lp-hero__media-placeholder lp-hero__media-placeholder--sm">Carica immagine feature</div>
          {%- endif -%}
        </div>
        <div class="lp-hero__feature-body">
          {%- if section.settings.secondary_badge_text != blank -%}
            <span class="lp-hero__feature-badge">{{ section.settings.secondary_badge_text }}</span>
          {%- endif -%}
          {%- if section.settings.feature_1_text != blank -%}
            <div class="lp-hero__feature-text">{{ section.settings.feature_1_text }}</div>
          {%- endif -%}
        </div>
      </div>

      <!-- Feature 2: anti-vibrazione (no secondary image — shares layout with alt modifier) -->
      <div class="lp-hero__feature lp-hero__feature--alt">
        <div class="lp-hero__feature-body lp-hero__feature-body--solo">
          {%- if section.settings.feature_2_text != blank -%}
            <div class="lp-hero__feature-text">{{ section.settings.feature_2_text }}</div>
          {%- endif -%}
        </div>
      </div>

    </div>

    <!-- ── OFFER BADGE ── -->
    {%- if section.settings.offer_badge != blank -%}
      <div class="lp-hero__offer-badge">{{ section.settings.offer_badge }}</div>
    {%- endif -%}

    <!-- ── COUPON BANNER ── -->
    <div class="lp-hero__coupon">

      <!-- Row 1: shoe + t-shirt = price + savings -->
      <div class="lp-hero__coupon-row">

        <!-- Shoe image -->
        <div class="lp-hero__coupon-item">
          {%- if section.settings.coupon_shoe_image != blank -%}
            {{ section.settings.coupon_shoe_image | image_url: width: 120 | image_tag:
               class: 'lp-hero__coupon-img',
               loading: 'lazy',
               widths: '80,120',
               sizes: '80px',
               alt: 'Scarpe Dr Kampes' }}
          {%- else -%}
            <div class="lp-hero__media-placeholder lp-hero__media-placeholder--coupon">Scarpa</div>
          {%- endif -%}
        </div>

        <span class="lp-hero__coupon-op" aria-hidden="true">+</span>

        <!-- T-shirt image -->
        <div class="lp-hero__coupon-item">
          {%- if section.settings.coupon_tshirt_image != blank -%}
            {{ section.settings.coupon_tshirt_image | image_url: width: 120 | image_tag:
               class: 'lp-hero__coupon-img',
               loading: 'lazy',
               widths: '80,120',
               sizes: '80px',
               alt: 'T-shirt Dr Kampes' }}
          {%- else -%}
            <div class="lp-hero__media-placeholder lp-hero__media-placeholder--coupon">T-shirt</div>
          {%- endif -%}
          <span class="lp-hero__coupon-caption">
            {%- if section.settings.coupon_free_label != blank -%}
              {{ section.settings.coupon_free_label }}
            {%- else -%}GRATIS{%- endif -%}
          </span>
        </div>

        <span class="lp-hero__coupon-op" aria-hidden="true">=</span>

        <!-- Price + savings -->
        <div class="lp-hero__coupon-item lp-hero__coupon-item--price">
          <span class="lp-hero__coupon-price">
            {%- if section.settings.coupon_price != blank -%}{{ section.settings.coupon_price }}{%- else -%}€ 189{%- endif -%}
          </span>
          {%- if section.settings.coupon_savings_label != blank -%}
            <span class="lp-hero__coupon-savings">{{ section.settings.coupon_savings_label }}</span>
          {%- endif -%}
        </div>

      </div>

      <!-- Row 2: shipping + installments -->
      <div class="lp-hero__coupon-row lp-hero__coupon-row--shipping">

        <div class="lp-hero__coupon-item lp-hero__coupon-item--shipping">
          {%- if section.settings.coupon_shipping_icon_image != blank -%}
            {{ section.settings.coupon_shipping_icon_image | image_url: width: 80 | image_tag:
               class: 'lp-hero__coupon-img lp-hero__coupon-img--icon',
               loading: 'lazy',
               widths: '48,80',
               sizes: '48px',
               alt: 'Spedizione' }}
          {%- else -%}
            <span class="lp-hero__coupon-truck" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v4h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </span>
          {%- endif -%}
          <span class="lp-hero__coupon-caption lp-hero__coupon-caption--shipping">
            {%- if section.settings.coupon_shipping_label != blank -%}
              {{ section.settings.coupon_shipping_label }}
            {%- else -%}SPEDIZIONE GRATIS{%- endif -%}
          </span>
        </div>

        {%- if section.settings.installments_note != blank -%}
          <div class="lp-hero__coupon-meta">{{ section.settings.installments_note }}</div>
        {%- endif -%}

      </div>

    </div>

    <!-- ── CTA ── -->
    <a href="{{ cta_url }}" class="lp-cta lp-hero__cta">
      {{ section.settings.cta_label | default: 'PRENOTA ORA LA TUA TAGLIA' }}
    </a>

    <!-- ── TRUST STRIP ── -->
    {%- if section.blocks.size > 0 -%}
      <ul class="lp-hero__trust" role="list">
        {%- for block in section.blocks -%}
          <li class="lp-hero__trust-item" {{ block.shopify_attributes }}>
            {%- case block.settings.icon -%}
              {%- when 'payment' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="0"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
              {%- when 'delivery' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="0"/><path d="M16 8h4l3 5v4h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
              {%- when 'check' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            {%- endcase -%}
            <span>{{ block.settings.text }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <!-- ── FOOTER TRUST TEXT ── -->
    {%- if section.settings.footer_trust_text != blank -%}
      <p class="lp-hero__footer-trust">{{ section.settings.footer_trust_text }}</p>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}

/* ============================================================
   LP HERO — scoped styles (tokens only, no raw hex)
   ============================================================ */

.lp-hero {
  padding: 0;
}

.lp-hero__inner {
  display: flex;
  flex-direction: column;
  max-width: var(--lp-section-max-width);
  margin: 0 auto;
  padding: var(--lp-section-pad-y) var(--lp-section-pad-x);
  gap: var(--lp-space-5);
}

/* ── Eyebrow ── */
.lp-hero__eyebrow {
  display: inline-block;
  align-self: flex-start;
  background: var(--lp-color-gold);
  color: var(--lp-color-text-on-dark);
  font-family: var(--lp-font-display);
  font-size: var(--lp-fs-eyebrow);
  font-weight: var(--lp-fw-black);
  letter-spacing: var(--lp-ls-widest);
  text-transform: uppercase;
  line-height: var(--lp-lh-snug);
  padding: var(--lp-space-2) var(--lp-space-3);
  margin: 0;
}

/* ── H1 ── */
.lp-hero__title {
  font-family: var(--lp-font-display);
  font-size: var(--lp-fs-h1);
  font-weight: var(--lp-fw-black);
  line-height: var(--lp-lh-tight);
  letter-spacing: var(--lp-ls-tight);
  color: var(--lp-color-text-on-dark);
  text-transform: uppercase;
  margin: 0;
}

.lp-hero__title--highlight {
  color: var(--lp-color-gold);
  font-style: normal;
}

/* ── Tagline ── */
.lp-hero__tagline {
  font-family: var(--lp-font-display);
  font-size: var(--lp-fs-h3);
  font-weight: var(--lp-fw-black);
  line-height: var(--lp-lh-snug);
  color: var(--lp-color-gold);
  text-transform: uppercase;
  margin: 0;
}

/* ── Main media ── */
.lp-hero__media {
  width: 100%;
  background: var(--lp-color-surface-dark);
}

.lp-hero__media-img {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 1 / 1;
  object-fit: cover;
}

.lp-hero__media-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  aspect-ratio: 1 / 1;
  background: var(--lp-color-surface-elev);
  color: var(--lp-color-text-on-dark-faint);
  font-family: var(--lp-font-display);
  font-size: var(--lp-fs-sm);
  text-transform: uppercase;
  letter-spacing: var(--lp-ls-wide);
}

.lp-hero__media-placeholder--sm {
  aspect-ratio: 4 / 3;
}

.lp-hero__media-placeholder--coupon {
  aspect-ratio: 1 / 1;
  width: 72px;
  height: 72px;
  font-size: var(--lp-fs-micro);
}

/* ── Feature blocks ── */
.lp-hero__features {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--lp-space-4);
}

.lp-hero__feature {
  display: flex;
  flex-direction: column;
  gap: var(--lp-space-3);
  background: var(--lp-color-surface-dark);
  padding: var(--lp-space-4);
}

.lp-hero__feature--alt {
  justify-content: flex-start;
}

.lp-hero__feature-img {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 4 / 3;
  object-fit: cover;
}

.lp-hero__feature-badge {
  display: inline-block;
  background: var(--lp-color-gold);
  color: var(--lp-color-text-on-dark);
  font-family: var(--lp-font-display);
  font-size: var(--lp-fs-micro);
  font-weight: var(--lp-fw-black);
  letter-spacing: var(--lp-ls-wider);
  text-transform: uppercase;
  padding: var(--lp-space-1) var(--lp-space-2);
  line-height: var(--lp-lh-snug);
}

.lp-hero__feature-text {
  font-family: var(--lp-font-body);
  font-size: var(--lp-fs-xs);
  color: var(--lp-color-text-on-dark-mute);
  line-height: var(--lp-lh-relaxed);
}

.lp-hero__feature-text p {
  margin: 0;
}

.lp-hero__feature-body--solo {
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 100%;
}

/* ── Offer badge ── */
.lp-hero__offer-badge {
  display: block;
  width: 100%;
  background: var(--lp-color-gold);
  color: var(--lp-color-text-on-dark);
  font-family: var(--lp-font-display);
  font-size: var(--lp-fs-eyebrow);
  font-weight: var(--lp-fw-black);
  letter-spacing: var(--lp-ls-wider);
  text-transform: uppercase;
  text-align: center;
  padding: var(--lp-space-3) var(--lp-space-4);
  line-height: var(--lp-lh-snug);
}

/* ── Coupon banner ── */
.lp-hero__coupon {
  background: var(--lp-color-surface-dark);
  border: 1px solid var(--lp-color-divider-dark-strong);
  display: flex;
  flex-direction: column;
  gap: 0;
}

.lp-hero__coupon-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: var(--lp-space-2) var(--lp-space-3);
  padding: var(--lp-space-4) var(--lp-space-4);
}

.lp-hero__coupon-row--shipping {
  border-top: 1px solid var(--lp-color-divider-dark);
  padding: var(--lp-space-3) var(--lp-space-4);
  gap: var(--lp-space-3) var(--lp-space-5);
}

.lp-hero__coupon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--lp-space-1);
}

.lp-hero__coupon-item--price {
  flex-direction: row;
  align-items: center;
  gap: var(--lp-space-3);
  flex-wrap: wrap;
}

.lp-hero__coupon-item--shipping {
  flex-direction: row;
  align-items: center;
  gap: var(--lp-space-2);
}

.lp-hero__coupon-img {
  display: block;
  width: 72px;
  height: auto;
  object-fit: contain;
}

.lp-hero__coupon-img--icon {
  width: 40px;
}

.lp-hero__coupon-op {
  font-family: var(--lp-font-display);
  font-size: var(--lp-fs-xl);
  font-weight: var(--lp-fw-black);
  color: var(--lp-color-text-on-dark-mute);
  line-height: 1;
}

.lp-hero__coupon-price {
  font-family: var(--lp-font-display);
  font-size: var(--lp-fs-price);
  font-weight: var(--lp-fw-black);
  color: var(--lp-color-gold);
  line-height: 1;
}

.lp-hero__coupon-savings {
  display: inline-block;
  background: var(--lp-color-danger);
  color: var(--lp-color-text-on-dark);
  font-family: var(--lp-font-display);
  font-size: var(--lp-fs-micro);
  font-weight: var(--lp-fw-black);
  letter-spacing: var(--lp-ls-wide);
  text-transform: uppercase;
  padding: var(--lp-space-1) var(--lp-space-2);
  line-height: var(--lp-lh-snug);
}

.lp-hero__coupon-caption {
  font-family: var(--lp-font-display);
  font-size: var(--lp-fs-micro);
  font-weight: var(--lp-fw-black);
  color: var(--lp-color-gold);
  letter-spacing: var(--lp-ls-wide);
  text-transform: uppercase;
  text-align: center;
}

.lp-hero__coupon-caption--shipping {
  font-size: var(--lp-fs-xs);
  color: var(--lp-color-text-on-dark-mute);
}

.lp-hero__coupon-meta {
  font-family: var(--lp-font-display);
  font-size: var(--lp-fs-xs);
  font-weight: var(--lp-fw-black);
  color: var(--lp-color-text-on-dark-mute);
  letter-spacing: var(--lp-ls-wide);
  text-transform: uppercase;
  text-align: center;
}

.lp-hero__coupon-meta p {
  margin: 0;
}

.lp-hero__coupon-truck svg {
  width: 32px;
  height: 32px;
  stroke: var(--lp-color-gold);
  display: block;
}

/* ── CTA layout tweak (base styles from .lp-cta) ── */
.lp-hero__cta {
  margin-top: var(--lp-space-5);
}

/* ── Trust strip ── */
.lp-hero__trust {
  list-style: none;
  margin: 0;
  padding: var(--lp-space-4) 0 0;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: var(--lp-space-2) var(--lp-space-4);
  border-top: 1px solid var(--lp-color-divider-dark);
}

.lp-hero__trust-item {
  display: inline-flex;
  align-items: center;
  gap: var(--lp-space-2);
  font-family: var(--lp-font-body);
  font-size: var(--lp-fs-micro);
  color: var(--lp-color-text-on-dark-faint);
  line-height: var(--lp-lh-snug);
}

.lp-hero__trust-item svg {
  width: 13px;
  height: 13px;
  flex-shrink: 0;
  stroke: var(--lp-color-gold);
}

/* ── Footer trust ── */
.lp-hero__footer-trust {
  font-family: var(--lp-font-display);
  font-size: var(--lp-fs-micro);
  font-weight: var(--lp-fw-black);
  color: var(--lp-color-gold);
  letter-spacing: var(--lp-ls-wider);
  text-transform: uppercase;
  text-align: center;
  margin: 0;
}

/* ============================================================
   DESKTOP ≥ 750px
   ============================================================ */
@media (min-width: 750px) {
  .lp-hero__inner {
    max-width: var(--lp-section-max-width);
    gap: var(--lp-space-6);
  }

  .lp-hero__coupon-img {
    width: 88px;
  }

  .lp-hero__features {
    gap: var(--lp-space-5);
  }
}

{% endstylesheet %}

{% schema %}
