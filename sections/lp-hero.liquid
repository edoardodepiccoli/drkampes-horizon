{%- assign bg = section.settings.bg_image -%}
{%- assign fw_img = section.settings.fastwear_image -%}
{%- assign banner = section.settings.banner_image -%}

<section class="lp-hero">

  <div class="lp-hero__visual">
    {%- if bg != blank -%}
      {{ bg | image_url: width: 1600 | image_tag:
         class: 'lp-hero__bg',
         loading: 'eager',
         fetchpriority: 'high',
         widths: '600,800,1100,1400,1800',
         sizes: '100vw',
         alt: bg.alt | default: section.settings.headline_white }}
    {%- endif -%}
    <div class="lp-hero__overlay">
      {%- if section.settings.eyebrow != blank -%}
        <div class="lp-hero__eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      {%- if section.settings.headline_white != blank or section.settings.headline_gold != blank -%}
        <h1 class="lp-hero__h1">
          {%- if section.settings.headline_white != blank -%}
            <span class="lp-hero__h1-line">{{ section.settings.headline_white | newline_to_br }}</span>
          {%- endif -%}
          {%- if section.settings.headline_gold != blank -%}
            <span class="lp-hero__h1-line lp-hero__h1-line--gold">{{ section.settings.headline_gold | newline_to_br }}</span>
          {%- endif -%}
        </h1>
      {%- endif -%}
      {%- if section.settings.headline_sub != blank -%}
        <p class="lp-hero__h2">{{ section.settings.headline_sub | newline_to_br }}</p>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="lp-hero__sub">{{ section.settings.subheading }}</div>
      {%- endif -%}

      {%- if fw_img != blank or section.settings.fastwear_text != blank -%}
        <div class="lp-hero__fastwear">
          {%- if fw_img != blank -%}
            <div class="lp-hero__fastwear-circle">
              {{ fw_img | image_url: width: 320 | image_tag:
                 widths: '160,240,320',
                 sizes: '160px',
                 loading: 'lazy',
                 alt: fw_img.alt | default: 'Sistema FASTWEAR Dr Kampes' }}
            </div>
          {%- endif -%}
          <div class="lp-hero__fastwear-info">
            {%- if section.settings.fastwear_label != blank -%}
              <span class="lp-hero__fastwear-label">{{ section.settings.fastwear_label }}</span>
            {%- endif -%}
            {%- if section.settings.fastwear_text != blank -%}
              <div class="lp-hero__fastwear-text">{{ section.settings.fastwear_text }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="lp-hero__content">

    {%- if section.blocks.size > 0 -%}
      <ul class="lp-hero__benefits">
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}
            <li class="lp-hero__benefit" {{ block.shopify_attributes }}>
              <span class="lp-hero__benefit-icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'timer' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5"/><path d="M9 2h6"/><path d="M12 2v3"/></svg>
                  {%- when 'feather' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/><path d="M16 8 2 22"/><path d="M17.5 15H9"/></svg>
                  {%- when 'slipper' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 17v-1.4c0-.9.7-1.6 1.6-1.6h2.7L9 11l3.4.5c1.5.2 2.8 1 3.6 2.3l.9 1.4h2.9c.9 0 1.6.7 1.6 1.6V17"/><path d="M2 17h20"/><path d="M9 11.5v2.5"/><path d="M12 12.5v2"/></svg>
                {%- endcase -%}
              </span>
              <div class="lp-hero__benefit-text">
                {%- if block.settings.title != blank -%}{{ block.settings.title }}{%- endif -%}
                {%- if block.settings.text != blank %} {{ block.settings.text }}{%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="lp-hero__purchase">

      {%- if section.settings.offer_badge != blank or section.settings.offer_badge_sub != blank -%}
        <div class="lp-hero__offer-badge">
          {%- if section.settings.offer_badge != blank -%}
            <span class="lp-hero__offer-badge-main">{{ section.settings.offer_badge }}</span>
          {%- endif -%}
          {%- if section.settings.offer_badge_sub != blank -%}
            <span class="lp-hero__offer-badge-sub">{{ section.settings.offer_badge_sub }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="lp-hero__card">

        {%- if banner != blank -%}
          <a href="{{ section.settings.cta_url | default: '#acquista' }}" class="lp-hero__card-banner">
            {{ banner | image_url: width: 1200 | image_tag:
               widths: '500,700,900,1200',
               sizes: '(min-width:750px) 600px, 100vw',
               loading: 'lazy',
               alt: banner.alt | default: 'Scarpe Dr Kampes + T-shirt omaggio + spedizione gratis a 189 euro' }}
            {%- if section.settings.risparmi_badge != blank -%}
              <span class="lp-hero__risparmi">{{ section.settings.risparmi_badge }}</span>
            {%- endif -%}
          </a>
        {%- endif -%}

        <div class="lp-hero__card-info">
          <div class="lp-hero__info-cell">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="20" height="13" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/><line x1="6" y1="15" x2="9" y2="15"/></svg>
            <div>
              {%- if section.settings.pay_title != blank -%}
                <strong>{{ section.settings.pay_title }}</strong>
              {%- endif -%}
              {%- if section.settings.pay_text != blank -%}
                <span>{{ section.settings.pay_text }}</span>
              {%- endif -%}
            </div>
          </div>
          <div class="lp-hero__info-cell">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1.5" y="6" width="13" height="11" rx="1.5"/><path d="M14.5 10h4l3 4v3h-7z"/><circle cx="5" cy="18.5" r="2"/><circle cx="17.5" cy="18.5" r="2"/></svg>
            <div>
              {%- if section.settings.ship_title != blank -%}
                <strong>{{ section.settings.ship_title }}</strong>
              {%- endif -%}
              {%- if section.settings.ship_text != blank -%}
                <span>{{ section.settings.ship_text }}</span>
              {%- endif -%}
            </div>
          </div>
        </div>

        <a href="{{ section.settings.cta_url | default: '#acquista' }}" class="lp-hero__cta">
          <svg class="lp-hero__cta-lock" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="1"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
          <span class="lp-hero__cta-text">{{ section.settings.cta_label | default: "PRENOTA ORA LA TUA TAGLIA" }}</span>
          <svg class="lp-hero__cta-arrow" viewBox="0 0 24 24" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
        </a>

      </div>

      {%- if section.settings.secure_text != blank -%}
        <div class="lp-hero__secure">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="1"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
          <span>{{ section.settings.secure_text }}</span>
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

{% stylesheet %}

.lp-hero {
  --lp-gold: #D4A017;
  --lp-gold-soft: rgba(212, 160, 23, 0.5);
  background: #000;
  color: #fff;
  padding: 0 0 24px;
}

/* ── Visual top ── */
.lp-hero__visual {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #0a0a0a;
  min-height: 440px;
}

.lp-hero__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 60% 75%;
  display: block;
}

.lp-hero__overlay {
  position: relative;
  z-index: 1;
  padding: 14px 18px 8px;
  display: flex;
  flex-direction: column;
  min-height: 440px;
  background:
    linear-gradient(to top, #000 0%, rgba(0,0,0,0.85) 8%, rgba(0,0,0,0) 28%),
    linear-gradient(90deg, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.75) 45%, rgba(0,0,0,0.25) 75%, rgba(0,0,0,0.05) 100%);
}

.lp-hero__eyebrow {
  font-family: 'Archivo Black', 'Inter', sans-serif;
  color: var(--lp-gold);
  font-size: 0.74rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  line-height: 1.2;
  margin: 0 0 10px;
}

.lp-hero__h1 {
  font-family: 'Archivo Black', 'Inter', sans-serif;
  font-size: 2.1rem;
  line-height: 0.98;
  letter-spacing: -0.005em;
  color: #fff;
  margin: 0 0 12px;
  text-transform: uppercase;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.lp-hero__h1-line { display: block; max-width: 11ch; }
.lp-hero__h1-line--gold { color: var(--lp-gold); }

.lp-hero__h2 {
  font-family: 'Archivo Black', 'Inter', sans-serif;
  font-size: 1.2rem;
  line-height: 1.05;
  color: #fff;
  margin: 0 0 18px;
  text-transform: uppercase;
  max-width: 13ch;
}

/* ── FASTWEAR card (inside visual hero) ── */
.lp-hero__fastwear {
  margin-top: auto;
  display: grid;
  grid-template-columns: 96px 1fr;
  gap: 12px;
  padding: 12px;
  border: 1px solid var(--lp-gold-soft);
  border-radius: 14px;
  background: rgba(0,0,0,0.55);
  backdrop-filter: blur(6px);
  align-items: center;
  max-width: 480px;
}

.lp-hero__fastwear-circle {
  width: 96px;
  height: 96px;
  border-radius: 50%;
  overflow: hidden;
  background: #111;
  border: 1.5px solid var(--lp-gold-soft);
  flex-shrink: 0;
}

.lp-hero__fastwear-circle img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.lp-hero__fastwear-info {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.lp-hero__fastwear-label {
  display: inline-block;
  background: #000;
  color: #fff;
  font-family: 'Archivo Black', 'Inter', sans-serif;
  font-size: 0.72rem;
  padding: 4px 7px;
  letter-spacing: 0.04em;
  align-self: flex-start;
  line-height: 1.1;
  text-transform: uppercase;
  border-radius: 4px;
}

.lp-hero__fastwear-text {
  font-size: 0.78rem;
  line-height: 1.35;
  color: rgba(255,255,255,0.88);
  margin: 0;
}
.lp-hero__fastwear-text p { margin: 0 0 4px; }
.lp-hero__fastwear-text p:last-child { margin: 0; }

/* ── Content ── */
.lp-hero__content {
  display: flex;
  flex-direction: column;
  padding: 6px 18px 0;
  gap: 16px;
  max-width: 600px;
  margin: 0 auto;
  width: 100%;
}

.lp-hero__sub {
  font-size: 0.9rem;
  line-height: 1.4;
  color: rgba(255,255,255,0.88);
  margin: 0 0 10px;
  max-width: 32ch;
}
.lp-hero__sub p { margin: 0; }
.lp-hero__sub strong { color: #fff; font-weight: 700; }

/* ── Benefits ── */
.lp-hero__benefits {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
  border: none;
}

.lp-hero__benefit {
  display: flex;
  gap: 12px;
  align-items: center;
  padding: 10px 0;
}

.lp-hero__benefit + .lp-hero__benefit {
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.lp-hero__benefit-icon {
  width: 36px;
  height: 36px;
  background: #0a0a0a;
  border: 1.5px solid var(--lp-gold);
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.lp-hero__benefit-icon svg {
  width: 18px;
  height: 18px;
  stroke: var(--lp-gold);
  stroke-width: 1.8;
}

.lp-hero__benefit-text {
  flex: 1;
  min-width: 0;
  color: rgba(255,255,255,0.92);
  font-size: 0.98rem;
  line-height: 1.3;
}

/* ── Purchase block ── */
.lp-hero__purchase {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  margin-top: 4px;
}

.lp-hero__offer-badge {
  align-self: center;
  background: var(--lp-gold);
  border: none;
  border-radius: 14px 14px 0 0;
  padding: 10px 22px 16px;
  text-align: center;
  position: relative;
  z-index: 1;
  margin-bottom: -10px;
  box-shadow: inset 0 0 0 1px rgba(0,0,0,0.12);
  max-width: calc(100% - 32px);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  line-height: 1.15;
}

.lp-hero__offer-badge-main {
  font-family: 'Archivo Black', 'Inter', sans-serif;
  color: #1a1a1a;
  font-size: 0.92rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  line-height: 1.15;
}

.lp-hero__offer-badge-sub {
  font-family: 'Archivo Black', 'Inter', sans-serif;
  color: #1a1a1a;
  font-size: 0.66rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  opacity: 0.85;
  line-height: 1.15;
}

.lp-hero__card {
  background: #fff;
  border-radius: 14px;
  padding: 10px 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  position: relative;
  z-index: 2;
}

.lp-hero__card-banner {
  position: relative;
  display: block;
  background: #000;
  border-radius: 10px;
  overflow: hidden;
  text-decoration: none;
  line-height: 0;
  aspect-ratio: 16 / 8;
}

.lp-hero__card-banner img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 35%;
}

.lp-hero__risparmi {
  position: absolute;
  top: 12px;
  right: 12px;
  background: #d11f2a;
  color: #fff;
  font-family: 'Archivo Black', 'Inter', sans-serif;
  font-size: 0.74rem;
  letter-spacing: 0.04em;
  padding: 6px 9px;
  text-transform: uppercase;
  line-height: 1.1;
  z-index: 2;
  white-space: nowrap;
}

.lp-hero__card-info {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  padding: 2px 2px;
}

.lp-hero__info-cell {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.lp-hero__info-cell svg {
  width: 26px;
  height: 26px;
  stroke: #111;
  stroke-width: 1.4;
  flex-shrink: 0;
}

.lp-hero__info-cell > div { min-width: 0; flex: 1; }

.lp-hero__info-cell strong,
.lp-hero__info-cell span {
  display: block;
  font-family: 'Archivo Black', 'Inter', sans-serif;
  font-size: 0.68rem;
  letter-spacing: 0.01em;
  line-height: 1.2;
  text-transform: uppercase;
}

.lp-hero__info-cell strong { color: #111; }
.lp-hero__info-cell span { color: #2a2a2a; }

/* ── CTA ── */
.lp-hero__cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  width: 100%;
  padding: 16px 14px;
  background: var(--lp-gold);
  color: #1a1a1a;
  font-family: 'Archivo Black', 'Inter', sans-serif;
  font-size: 0.85rem;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  text-align: center;
  text-decoration: none;
  border-radius: 10px;
  transition: background 0.15s, transform 0.1s;
}
.lp-hero__cta:hover { background: #a4823b; text-decoration: none; }
.lp-hero__cta:active { transform: scale(0.99); }

.lp-hero__cta-text {
  flex: 1;
  text-align: center;
  line-height: 1.15;
  white-space: nowrap;
}

.lp-hero__cta-lock,
.lp-hero__cta-arrow {
  width: 18px;
  height: 18px;
  stroke: #1a1a1a;
  flex-shrink: 0;
}

/* ── Secure (outside card, on dark bg) ── */
.lp-hero__secure {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  font-size: 0.78rem;
  color: rgba(255,255,255,0.6);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  font-weight: 600;
  padding: 14px 0 0;
}

.lp-hero__secure svg {
  width: 13px;
  height: 13px;
  stroke: rgba(255,255,255,0.6);
}

/* ── Shared LP base styles (loaded first via hero) ── */
.lp-sec__eyebrow {
  font-size: 0.67rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #2e7d32;
  margin-bottom: 10px;
}

.lp-sec__h2 {
  font-family: var(--font-heading--family, inherit);
  font-size: 1.5rem;
  font-weight: 900;
  line-height: 1.2;
  color: #111;
  margin: 0 0 18px;
}

/* ── Tablet ≥ 750px ── */
@media (min-width: 750px) {
  .lp-hero { padding: 0 0 40px; }

  .lp-hero__visual { min-height: 600px; }

  .lp-hero__bg { object-position: 75% center; }

  .lp-hero__overlay {
    padding: 28px 48px 36px;
    background: linear-gradient(90deg, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.7) 35%, rgba(0,0,0,0.1) 65%, rgba(0,0,0,0) 100%);
    max-width: 1200px;
    margin: 0 auto;
    min-height: 600px;
  }

  .lp-hero__eyebrow { font-size: 0.92rem; margin-bottom: 18px; }
  .lp-hero__h1 { font-size: 3.2rem; margin-bottom: 18px; }
  .lp-hero__h2 { font-size: 1.55rem; margin-bottom: 28px; }

  .lp-hero__fastwear {
    grid-template-columns: 130px 1fr;
    padding: 16px;
    gap: 18px;
    max-width: 520px;
  }

  .lp-hero__fastwear-circle { width: 130px; height: 130px; }
  .lp-hero__fastwear-text { font-size: 0.9rem; }
  .lp-hero__fastwear-label { font-size: 0.78rem; }

  .lp-hero__content {
    padding: 32px 48px 0;
    max-width: 1100px;
    gap: 28px;
  }

  .lp-hero__sub { font-size: 1.02rem; max-width: 50ch; margin-bottom: 24px; }

  .lp-hero__benefits {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 22px;
    padding: 0;
    border: none;
  }

  .lp-hero__benefit {
    flex: 1 1 240px;
    padding: 0;
  }
  .lp-hero__benefit + .lp-hero__benefit {
    border-top: none;
  }

  .lp-hero__purchase { max-width: 720px; align-self: center; width: 100%; }

  .lp-hero__offer-badge {
    padding: 12px 30px 18px;
    border-radius: 16px 16px 0 0;
    margin-bottom: -12px;
  }
  .lp-hero__offer-badge-main { font-size: 1.05rem; }
  .lp-hero__offer-badge-sub { font-size: 0.78rem; }

  .lp-hero__card { padding: 14px; gap: 10px; border-radius: 16px; }
  .lp-hero__card-banner { border-radius: 12px; }
  .lp-hero__card-info { padding: 4px 8px; gap: 16px; }
  .lp-hero__info-cell { gap: 14px; }
  .lp-hero__info-cell svg { width: 38px; height: 38px; }
  .lp-hero__info-cell strong,
  .lp-hero__info-cell span { font-size: 0.95rem; letter-spacing: 0.03em; }

  .lp-hero__risparmi { top: 18px; right: 18px; font-size: 0.95rem; padding: 8px 12px; }

  .lp-hero__cta { padding: 22px 26px; font-size: 1.15rem; border-radius: 12px; }
  .lp-hero__cta-text { white-space: normal; }
  .lp-hero__cta-lock,
  .lp-hero__cta-arrow { width: 24px; height: 24px; }
}

/* ── Desktop ≥ 1100px ── */
@media (min-width: 1100px) {
  .lp-hero__visual { min-height: 640px; }
  .lp-hero__overlay { min-height: 640px; }

  .lp-hero__h1 { font-size: 3.8rem; }
  .lp-hero__h2 { font-size: 1.75rem; }
  .lp-hero__eyebrow { font-size: 1rem; }
}

{% endstylesheet %}

{% schema %}
{
  "name": "LP — Hero",
  "settings": [
    {
      "type": "header",
      "content": "Visual hero"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Immagine di sfondo (tallone scarpa)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (sopra titolo, color oro)",
      "default": "LE SCARPE N°1 PER CAMIONISTI"
    },
    {
      "type": "textarea",
      "id": "headline_white",
      "label": "Titolo bianco (H1, prima parte)",
      "default": "SCENDI DAL CAMION"
    },
    {
      "type": "textarea",
      "id": "headline_gold",
      "label": "Titolo oro (H1, seconda parte)",
