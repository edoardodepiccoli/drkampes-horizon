{%- assign img = section.settings.image -%}

<section class="lp-hero">
  <div class="lp-hero__inner">

    <div class="lp-hero__media">
      {%- if img != blank -%}
        {{ img | image_url: width: 1200 | image_tag:
           class: 'lp-hero__img',
           loading: 'eager',
           fetchpriority: 'high',
           widths: '600,800,1000,1200',
           sizes: '(min-width:750px) 560px, 100vw',
           alt: img.alt }}
      {%- endif -%}
      {%- if section.settings.image_badge != blank -%}
        <span class="lp-hero__img-badge">{{ section.settings.image_badge }}</span>
      {%- endif -%}
    </div>

    <div class="lp-hero__info">

      {%- if section.settings.offer_badge != blank -%}
        <div class="lp-hero__badge">
          <span>{{ section.settings.offer_badge }}</span>
        </div>
      {%- endif -%}

      <h1 class="lp-hero__h1">{{ section.settings.headline }}</h1>

      {%- if section.settings.rating_value != blank or section.settings.rating_count != blank -%}
        <div class="lp-hero__rating">
          {%- if section.settings.rating_value != blank -%}
            <span class="lp-hero__stars" aria-hidden="true">★★★★★</span>
            <span class="lp-hero__rating-val">{{ section.settings.rating_value }}</span>
          {%- endif -%}
          {%- if section.settings.rating_count != blank -%}
            <span class="lp-hero__rating-sep" aria-hidden="true">·</span>
            <span class="lp-hero__rating-count">{{ section.settings.rating_count }}</span>
          {%- endif -%}
          {%- if section.settings.verified_label != blank -%}
            <span class="lp-hero__rating-sep" aria-hidden="true">·</span>
            <span class="lp-hero__verified">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              {{ section.settings.verified_label }}
            </span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="lp-hero__sub">{{ section.settings.subheading }}</div>
      {%- endif -%}

      <div class="lp-hero__price-block">
        <div class="lp-hero__price-row">
          {%- if section.settings.price != blank -%}
            <span class="lp-hero__price">{{ section.settings.price }}</span>
          {%- endif -%}
          {%- if section.settings.savings_label != blank -%}
            <span class="lp-hero__savings">{{ section.settings.savings_label }}</span>
          {%- endif -%}
        </div>
        <div class="lp-hero__price-meta">
          {%- if section.settings.compare_price != blank -%}
            <span class="lp-hero__compare">{{ section.settings.compare_price }}</span>
          {%- endif -%}
          {%- if section.settings.tax_note != blank -%}
            <span class="lp-hero__price-sep" aria-hidden="true">·</span>
            <span class="lp-hero__tax">{{ section.settings.tax_note }}</span>
          {%- endif -%}
        </div>
        {%- if section.settings.installments_note != blank -%}
          <div class="lp-hero__installments">{{ section.settings.installments_note }}</div>
        {%- endif -%}
      </div>

      {%- if section.settings.coupon_text != blank -%}
        <div class="lp-hero__coupon">
          <span class="lp-hero__coupon-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12V8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v4a2 2 0 0 1 0 4v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4a2 2 0 0 1 0-4Z"/><path d="M9 9h.01M15 15h.01M9 15l6-6"/></svg>
          </span>
          <span>{{ section.settings.coupon_text }}</span>
        </div>
      {%- endif -%}

      <a href="{{ section.settings.cta_url | default: '#acquista' }}" class="lp-hero__cta">
        {{ section.settings.cta_label | default: "SCOPRI L'OFFERTA SUBITO" }}
      </a>

      {%- if section.blocks.size > 0 -%}
        <ul class="lp-hero__trust">
          {%- for block in section.blocks -%}
            <li class="lp-hero__trust-item" {{ block.shopify_attributes }}>
              {%- case block.settings.icon -%}
                {%- when 'payment' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                {%- when 'delivery' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v4h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
              {%- endcase -%}
              <span>{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

    </div>
  </div>
</section>

{% stylesheet %}

.lp-hero {
  background: #000;
  color: #fff;
  padding: 0 0 24px;
}

.lp-hero__inner {
  display: flex;
  flex-direction: column;
  max-width: 580px;
  margin: 0 auto;
}

.lp-hero__media {
  position: relative;
  width: 100%;
  background: #0a0a0a;
}

.lp-hero__img {
  width: 100%;
  height: auto;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  display: block;
}

.lp-hero__img-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  background: #e3252b;
  color: #fff;
  font-family: 'Archivo Black', sans-serif;
  font-size: 0.7rem;
  letter-spacing: 0.05em;
  padding: 6px 10px;
  text-transform: uppercase;
  line-height: 1.2;
  z-index: 2;
}

.lp-hero__info {
  display: flex;
  flex-direction: column;
  padding: 16px 16px 0;
  gap: 12px;
}

.lp-hero__badge {
  background: #F5C200;
  color: #111;
  font-family: 'Archivo Black', sans-serif;
  font-size: 0.72rem;
  font-weight: 900;
  padding: 8px 12px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  align-self: flex-start;
  line-height: 1.2;
  margin: 0;
}

.lp-hero__h1 {
  font-family: var(--font-heading--family, inherit);
  font-size: 1.45rem;
  font-weight: 900;
  color: #fff;
  line-height: 1.18;
  letter-spacing: -0.01em;
  margin: 0;
  text-transform: uppercase;
}

.lp-hero__h1 em {
  color: #F5C200;
  font-style: normal;
}

.lp-hero__rating {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  font-size: 0.82rem;
  color: rgba(255,255,255,0.78);
  margin: 0;
}

.lp-hero__stars {
  color: #F5C200;
  letter-spacing: 0.05em;
  font-size: 0.95rem;
  line-height: 1;
}

.lp-hero__rating-val {
  font-family: 'Archivo Black', sans-serif;
  color: #fff;
  font-size: 0.85rem;
}

.lp-hero__rating-sep {
  color: rgba(255,255,255,0.3);
}

.lp-hero__rating-count {
  color: rgba(255,255,255,0.78);
}

.lp-hero__verified {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  color: #4ade80;
  font-weight: 700;
  font-size: 0.78rem;
}

.lp-hero__verified svg {
  width: 12px;
  height: 12px;
  stroke: #4ade80;
}

.lp-hero__sub {
  font-size: 0.85rem;
  color: rgba(255,255,255,0.7);
  line-height: 1.45;
  margin: 0;
}
.lp-hero__sub p { margin: 0; }
.lp-hero__sub strong { color: #fff; }

.lp-hero__price-block {
  display: flex;
  flex-direction: column;
  gap: 4px;
  background: #0d0d0d;
  border-left: 3px solid #F5C200;
  padding: 12px 14px;
  margin: 4px 0 0;
}

.lp-hero__price-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
  line-height: 1;
}

.lp-hero__price {
  font-family: 'Archivo Black', sans-serif;
  font-size: 2.4rem;
  color: #F5C200;
  line-height: 1;
}

.lp-hero__savings {
  background: #e3252b;
  color: #fff;
  font-family: 'Archivo Black', sans-serif;
  font-size: 0.78rem;
  letter-spacing: 0.04em;
  padding: 6px 9px;
  line-height: 1.1;
  text-transform: uppercase;
}

.lp-hero__price-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  font-size: 0.8rem;
  color: rgba(255,255,255,0.6);
}

.lp-hero__compare {
  color: rgba(255,255,255,0.55);
  text-decoration: line-through;
  font-weight: 700;
  font-size: 0.95rem;
}

.lp-hero__price-sep {
  color: rgba(255,255,255,0.25);
}

.lp-hero__tax {
  font-size: 0.78rem;
  color: rgba(255,255,255,0.55);
}

.lp-hero__installments {
  font-size: 0.8rem;
  color: #fff;
  font-weight: 600;
  margin-top: 6px;
}

.lp-hero__installments strong {
  color: #F5C200;
  font-family: 'Archivo Black', sans-serif;
  letter-spacing: 0.02em;
}

.lp-hero__coupon {
  display: flex;
  align-items: center;
  gap: 10px;
  background: #14361a;
  border: 1px dashed #2e7d32;
  color: #d4ffd9;
  padding: 10px 12px;
  font-size: 0.82rem;
  font-weight: 600;
  line-height: 1.3;
  margin: 0;
}

.lp-hero__coupon-icon {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
}

.lp-hero__coupon-icon svg {
  width: 16px;
  height: 16px;
  stroke: #4ade80;
}

.lp-hero__cta {
  display: block;
  width: 100%;
  padding: 17px 20px;
  background: #F5C200;
  color: #0d0d0d;
  font-size: 1rem;
  font-weight: 900;
  font-family: 'Archivo Black', sans-serif;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  text-align: center;
  border-radius: 0;
  text-decoration: none;
  transition: background 0.15s, transform 0.1s;
  margin: 4px 0 0;
  box-shadow: 0 0 0 0 rgba(245,194,0,0.55);
  animation: lp-hero-cta-pulse 2.4s ease-in-out infinite;
}
.lp-hero__cta:hover {
  background: #d9ac00;
  text-decoration: none;
}
.lp-hero__cta:active {
  transform: scale(0.99);
}

@keyframes lp-hero-cta-pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(245,194,0,0.55); }
  50% { box-shadow: 0 0 0 12px rgba(245,194,0,0); }
}

.lp-hero__trust {
  list-style: none;
  margin: 4px 0 0;
  padding: 12px 0 0;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8px 14px;
  border-top: 1px solid rgba(255,255,255,0.08);
}

.lp-hero__trust-item {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.72rem;
  color: rgba(255,255,255,0.62);
  line-height: 1.2;
}

.lp-hero__trust-item svg {
  width: 13px;
  height: 13px;
  flex-shrink: 0;
  stroke: #F5C200;
}

/* ── Shared LP base styles (loaded first via hero) ── */
.lp-sec__eyebrow {
  font-size: 0.67rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #2e7d32;
  margin-bottom: 10px;
}

.lp-sec__h2 {
  font-family: var(--font-heading--family, inherit);
  font-size: 1.5rem;
  font-weight: 900;
  line-height: 1.2;
  color: #111;
  margin: 0 0 18px;
}

@media (min-width: 750px) {
  .lp-hero {
    padding: 32px 40px 48px;
  }

  .lp-hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    max-width: 1100px;
    align-items: start;
  }

  .lp-hero__media {
    position: sticky;
    top: 24px;
  }

  .lp-hero__info {
    padding: 0;
    gap: 14px;
  }

  .lp-hero__h1 {
    font-size: 2rem;
  }

  .lp-hero__price {
    font-size: 2.9rem;
  }

  .lp-hero__cta {
    padding: 20px 24px;
    font-size: 1.05rem;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "LP — Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto prodotto"
    },
    {
      "type": "text",
      "id": "image_badge",
      "label": "Badge sopra immagine (es. -17%)",
      "info": "Lasciare vuoto per nascondere"
    },
    {
      "type": "header",
      "content": "Offerta"
    },
    {
      "type": "text",
      "id": "offer_badge",
      "label": "Badge offerta",
      "default": "OFFERTA PRIMAVERA — fino al 30 giugno"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline (H1)",
      "default": "Le migliori scarpe per camionisti al mondo"
    },
    {
      "type": "header",
      "content": "Rating"
    },
    {
      "type": "text",
      "id": "rating_value",
      "label": "Valutazione (es. 4.9)",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "rating_count",
      "label": "Numero recensioni / clienti",
      "default": "68 clienti soddisfatti"
    },
    {
      "type": "text",
      "id": "verified_label",
      "label": "Etichetta verificate (opzionale)",
      "default": "Recensioni verificate"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Sottotitolo (opzionale)",
      "default": "<p>Antinfortunistiche S3S <strong>100% Made in Italy</strong>. Sistema FASTWEAR® on/off in 1 secondo. Garanzia scritta 3 anni.</p>"
    },
    {
      "type": "header",
      "content": "Prezzo"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Prezzo",
      "default": "€189"
    },
    {
      "type": "text",
      "id": "savings_label",
      "label": "Badge risparmi (rosso)",
      "default": "-14% · RISPARMI €30"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Prezzo barrato",
      "default": "€219"
    },
    {
      "type": "text",
      "id": "tax_note",
      "label": "Nota IVA",
      "default": "IVA inclusa"
    },
    {
      "type": "richtext",
      "id": "installments_note",
      "label": "Nota rate / pagamento",
      "default": "<p>oppure <strong>3 rate da €63</strong> con Klarna o PayPal</p>"
    },
    {
      "type": "header",
      "content": "Coupon banner"
    },
    {
      "type": "text",
      "id": "coupon_text",
      "label": "Testo coupon",
      "default": "Spedizione GRATIS + T-shirt OMAGGIO inclusi"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Testo bottone CTA",
      "default": "SCOPRI L'OFFERTA SUBITO"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "URL CTA (default: #acquista)"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icona",
          "options": [
            { "value": "payment", "label": "Pagamento" },
            { "value": "delivery", "label": "Spedizione" },
            { "value": "shield", "label": "Garanzia" }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Testo"
        }
      ]
    }
  ],
  "presets": [{ "name": "LP — Hero" }]
}
{% endschema %}
