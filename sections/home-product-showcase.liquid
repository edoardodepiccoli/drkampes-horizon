{% assign product = section.settings.product %}
{% assign first_variant = product.selected_or_first_available_variant %}
{% if product == blank %}
  <div style="padding:2rem;text-align:center;color:#888;">Nessun prodotto selezionato</div>
{% else %}

<div class="hps" id="acquista" data-hps-id="{{ section.id }}">

  <script type="application/json" id="hps-variants-{{ section.id }}">
    {{ product.variants | json }}
  </script>

  <script type="application/json" id="hps-vg-{{ section.id }}">
    {
      {%- for variant in product.variants -%}
        {%- unless forloop.first -%},{%- endunless -%}
        "{{ variant.id }}": [
          {%- assign vg_files = variant.metafields.custom.variant_gallery.value -%}
          {%- if vg_files != blank -%}
            {%- assign first_hit = true -%}
            {%- for vg_file in vg_files -%}
              {%- for media in product.media -%}
                {%- if vg_file.image.src == media.src -%}
                  {%- unless first_hit -%},{%- endunless -%}
                  {{ media.id }}
                  {%- assign first_hit = false -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          {%- endif -%}
        ]
      {%- endfor -%}
    }
  </script>

  <div class="hps__gallery">
    <div class="hps__main">
      {%- for media in product.media -%}
        <div
          class="hps__slide{% if forloop.first %} hps__slide--active{% endif %}"
          data-media-id="{{ media.id }}"
        >
          {%- if forloop.first -%}
            {{ media | image_url: width: 800 | image_tag: class: 'hps__img', loading: 'eager', widths: '400,600,800', sizes: '(max-width:749px) 100vw, 50vw' }}
          {%- else -%}
            {{ media | image_url: width: 800 | image_tag: class: 'hps__img', loading: 'lazy', widths: '400,600,800', sizes: '(max-width:749px) 100vw, 50vw' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="hps__thumbs">
      {%- for media in product.media -%}
        <button
          type="button"
          class="hps__thumb{% if forloop.first %} hps__thumb--active{% endif %}"
          data-index="{{ forloop.index0 }}"
          data-media-id="{{ media.id }}"
          aria-label="Immagine {{ forloop.index }}"
        >{{ media | image_url: width: 120 | image_tag: class: 'hps__thumb-img', loading: 'lazy' }}</button>
      {%- endfor -%}
    </div>
  </div>

  <div class="hps__details">

    <div class="hps__head">
      <h2 class="hps__title">{{ product.title }}</h2>
      <p class="hps__sub">Antinfortunistiche S3S</p>
    </div>

    <p class="hps__price">
      <span class="hps__price-main">&euro; {{ product.price | money_without_currency }}</span>
      <span class="hps__price-tax">IVA INCLUSA</span>
    </p>

    <div class="hps__usp">
      <button type="button" class="hps__usp-item" id="hps-usp-gar-{{ section.id }}">
        <svg class="hps__usp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span class="hps__usp-main">3 Anni</span>
        <span class="hps__usp-sub">Garanzia estesa</span>
      </button>
      <button type="button" class="hps__usp-item" id="hps-usp-ret-{{ section.id }}">
        <svg class="hps__usp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 14 4 9 9 4"/><path d="M20 20v-7a4 4 0 0 0-4-4H4"/></svg>
        <span class="hps__usp-main">Reso Gratis</span>
        <span class="hps__usp-sub">14gg · cambio taglia</span>
      </button>
      <button type="button" class="hps__usp-item" id="hps-usp-ship-{{ section.id }}">
        <svg class="hps__usp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        <span class="hps__usp-main">48–72 Ore</span>
        <span class="hps__usp-sub">Spedizione rapida</span>
      </button>
      <button type="button" class="hps__usp-item" id="hps-usp-pay-{{ section.id }}">
        <svg class="hps__usp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
        <span class="hps__usp-main">Paga a Rate</span>
        <span class="hps__usp-sub">Klarna · PayPal</span>
      </button>
    </div>

    {%- assign form_id = 'hps-form-' | append: section.id -%}
    {% form 'product', product, id: form_id, class: 'hps__form' %}
      <input type="hidden" name="id" id="hps-vid-{{ section.id }}" value="{{ first_variant.id }}">

      {%- assign color_option = nil -%}
      {%- assign color_pos = 0 -%}
      {%- for option in product.options_with_values -%}
        {%- assign n = option.name | downcase -%}
        {%- if n == 'colore' or n == 'color' or n == 'colour' -%}
          {%- assign color_option = option -%}
          {%- assign color_pos = option.position | minus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if color_option != nil -%}
        <div class="hps__opt">
          <p class="hps__opt-lbl">Colore: <span id="hps-cval-{{ section.id }}">{{ color_option.selected_value }}</span></p>
          <div class="hps__swatches">
            {%- for value in color_option.values -%}
              <button
                type="button"
                class="hps__swatch{% if color_option.selected_value == value %} hps__swatch--on{% endif %}"
                data-color="{{ value }}"
                data-pos="{{ color_pos }}"
                title="{{ value }}"
                aria-label="{{ value }}"
                {%- assign sw = value.swatch -%}
                {%- assign val_h = value | handleize -%}
                style="{% if sw.color %}background:rgb({{ sw.color.rgb }});{% elsif sw.image %}background:url('{{ sw.image | image_url: width: 80 }}') center/cover no-repeat;{% elsif val_h == 'nero' %}background:#1a1a1a;{% elsif val_h == 'testa-di-moro' or val_h == 'testa-moro' %}background:#3d1a0a;{% elsif val_h == 'marrone' or val_h == 'brown' %}background:#5c3317;{% else %}background:#888;{% endif %}"
              ></button>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- assign size_option = nil -%}
      {%- assign size_pos = 1 -%}
      {%- for option in product.options_with_values -%}
        {%- assign n = option.name | downcase -%}
        {%- if n == 'taglia' or n == 'size' or n == 'misura' -%}
          {%- assign size_option = option -%}
          {%- assign size_pos = option.position | minus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if size_option == nil -%}
        {%- for option in product.options_with_values -%}
          {%- if option.position != color_option.position -%}
            {%- assign size_option = option -%}
            {%- assign size_pos = option.position | minus: 1 -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- if size_option != nil -%}
        <div class="hps__opt">
          <div class="hps__size-row">
            <p class="hps__opt-lbl">Taglia: <span id="hps-sval-{{ section.id }}">{{ size_option.selected_value }}</span></p>
            <div class="hps__info-btns">
              <button type="button" class="hps__info-btn" id="hps-tech-{{ section.id }}">Schede tecniche</button>
              <button type="button" class="hps__info-btn" id="hps-size-{{ section.id }}">Trova la tua Taglia</button>
            </div>
          </div>
          <select class="hps__select" id="hps-ssel-{{ section.id }}" data-pos="{{ size_pos }}" aria-label="Taglia">
            {%- for value in size_option.values -%}
              <option value="{{ value }}"{% if size_option.selected_value == value %} selected{% endif %}>{{ value }}</option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}

      <div class="hps__buy-row">
        <div class="hps__qty">
          <button type="button" class="hps__qty-btn" data-d="-1">&#8722;</button>
          <input type="number" name="quantity" value="1" min="1" id="hps-qty-{{ section.id }}" class="hps__qty-n" aria-label="Quantità">
          <button type="button" class="hps__qty-btn" data-d="1">&#43;</button>
        </div>
        <button type="submit" name="add" class="hps__atc">AGGIUNGI AL CARRELLO</button>
      </div>

      <button type="button" class="hps__bn" id="hps-bn-{{ section.id }}">ACQUISTA ORA</button>

    {% endform %}

  </div>
</div>

<div class="hps-pop" id="hps-pop-tech-{{ section.id }}" role="dialog" aria-modal="true" hidden>
  <div class="hps-pop__bg" data-pop-close></div>
  <div class="hps-pop__box">
    <button type="button" class="hps-pop__x" data-pop-close aria-label="Chiudi">&times;</button>
    <h3 class="hps-pop__title">Documentazione Tecnica</h3>
    <div class="hps-pop__body">
      <div class="hps-doc-section">
        <p class="hps-doc-section__label">Documenti comuni</p>
        <a class="hps-doc-row" href="https://cdn.shopify.com/s/files/1/0960/9527/3303/files/DPI-DRKAMPES-CERTIFICAZIONE-S3S.pdf?v=1776677825" target="_blank" rel="noopener">
          <span class="hps-doc-row__icon">&#8595;</span>
          <span class="hps-doc-row__name">Certificazione DPI S3S</span>
          <span class="hps-doc-row__type">PDF</span>
        </a>
        <a class="hps-doc-row" href="https://cdn.shopify.com/s/files/1/0960/9527/3303/files/NOTA-INFORMATIVA-DRKAMPES.pdf?v=1776677825" target="_blank" rel="noopener">
          <span class="hps-doc-row__icon">&#8595;</span>
          <span class="hps-doc-row__name">Nota informativa</span>
          <span class="hps-doc-row__type">PDF</span>
        </a>
      </div>
      <div class="hps-doc-section">
        <p class="hps-doc-section__label">Schede tecniche per modello</p>
        <a class="hps-doc-row" href="https://cdn.shopify.com/s/files/1/0960/9527/3303/files/DR_KAMPES_-_SCHEDA_TECNICA-20260420-BLACK.pdf?v=1776677825" target="_blank" rel="noopener">
          <span class="hps-doc-row__icon">&#8595;</span>
          <span class="hps-doc-row__name">Dr Kampes Nere</span>
          <span class="hps-doc-row__type">PDF</span>
        </a>
        <a class="hps-doc-row" href="https://cdn.shopify.com/s/files/1/0960/9527/3303/files/DR_KAMPES_-_SCHEDA_TECNICA-20260420-BLACK.pdf?v=1776677825" target="_blank" rel="noopener">
          <span class="hps-doc-row__icon">&#8595;</span>
          <span class="hps-doc-row__name">Dr Kampes Testa di Moro</span>
          <span class="hps-doc-row__type">PDF</span>
        </a>
      </div>
    </div>
  </div>
</div>

<div class="hps-pop" id="hps-pop-size-{{ section.id }}" role="dialog" aria-modal="true" hidden>
  <div class="hps-pop__bg" data-pop-close></div>
  <div class="hps-pop__box">
    <button type="button" class="hps-pop__x" data-pop-close aria-label="Chiudi">&times;</button>
    <h3 class="hps-pop__title">Guida alla Taglia</h3>
    <div class="hps-pop__body">
      <p>Misura la lunghezza interna della soletta e confronta con la tabella.</p>
      <table class="hps-stbl">
        <thead><tr><th>IT</th><th>Cm Soletta Interna</th></tr></thead>
        <tbody>
          <tr><td>37</td><td>24,5 cm</td></tr>
          <tr><td>38</td><td>25 cm</td></tr>
          <tr><td>39</td><td>25,5 cm</td></tr>
          <tr><td>40</td><td>26,5 cm</td></tr>
          <tr><td>41</td><td>27,5 cm</td></tr>
          <tr><td>42</td><td>28 cm</td></tr>
          <tr><td>43</td><td>28,5 cm</td></tr>
          <tr><td>44</td><td>29 cm</td></tr>
          <tr><td>45</td><td>30 cm</td></tr>
          <tr><td>46</td><td>30,5 cm</td></tr>
          <tr><td>47</td><td>31 cm</td></tr>
          <tr><td>48</td><td>32 cm</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="hps-pop" id="hps-pop-usp-gar-{{ section.id }}" role="dialog" aria-modal="true" hidden>
  <div class="hps-pop__bg" data-pop-close></div>
  <div class="hps-pop__box">
    <button type="button" class="hps-pop__x" data-pop-close aria-label="Chiudi">&times;</button>
    <h3 class="hps-pop__title">Garanzia 3 Anni</h3>
    <div class="hps-pop__body">
      <p>Le Dr Kampes sono coperte da <strong>3 anni di garanzia totale</strong>: 2 anni di garanzia legale prevista dal Codice del Consumo, più 1 anno aggiuntivo di Garanzia Commerciale estesa offerta da Dr Kampes.</p>
      <p>Incluso gratis il servizio <strong>"Cambio Gomme"</strong> (risuolatura straordinaria): la scarpa viene risuolata e riesamina con emissione della <strong>Certificazione di Conformità DPI post-riparazione</strong>, garantendo che mantenga intatti i requisiti di sicurezza S3S originali.</p>
    </div>
  </div>
</div>

<div class="hps-pop" id="hps-pop-usp-ret-{{ section.id }}" role="dialog" aria-modal="true" hidden>
  <div class="hps-pop__bg" data-pop-close></div>
  <div class="hps-pop__box">
    <button type="button" class="hps-pop__x" data-pop-close aria-label="Chiudi">&times;</button>
    <h3 class="hps-pop__title">Reso e Cambio Taglia</h3>
    <div class="hps-pop__body">
      <p><strong>14 giorni soddisfatti o rimborsati</strong> dalla data di ricezione. Se il prodotto non ti convince, restituiscilo nelle stesse condizioni e rimborsiamo il 100% dell'importo pagato.</p>
      <p><strong>Cambio taglia gratuito</strong>: spedizione di ritorno e nuova spedizione a carico nostro, senza costi aggiuntivi. Acquista online senza la barriera della taglia.</p>
    </div>
  </div>
</div>

<div class="hps-pop" id="hps-pop-usp-ship-{{ section.id }}" role="dialog" aria-modal="true" hidden>
  <div class="hps-pop__bg" data-pop-close></div>
  <div class="hps-pop__box">
    <button type="button" class="hps-pop__x" data-pop-close aria-label="Chiudi">&times;</button>
    <h3 class="hps-pop__title">Spedizioni Rapide</h3>
    <div class="hps-pop__body">
      <p>Consegna in <strong>48-72 ore lavorative</strong> dalla conferma d'ordine, in tutta Italia. Tracking incluso: ricevi un link per seguire la spedizione in tempo reale.</p>
    </div>
  </div>
</div>

<div class="hps-pop" id="hps-pop-usp-pay-{{ section.id }}" role="dialog" aria-modal="true" hidden>
  <div class="hps-pop__bg" data-pop-close></div>
  <div class="hps-pop__box">
    <button type="button" class="hps-pop__x" data-pop-close aria-label="Chiudi">&times;</button>
    <h3 class="hps-pop__title">Pagamento Rateale</h3>
    <div class="hps-pop__body">
      <p>Paga in comode rate con <strong>Klarna</strong> o <strong>PayPal</strong>. Nessun interesse aggiuntivo. Selezionabile direttamente al checkout, senza burocrazia.</p>
    </div>
  </div>
</div>

<div class="hps-cta-bar" id="hps-cta-bar-{{ section.id }}">
  <a class="hps-cta" href="#acquista" aria-label="SÌ, LE VOGLIO.">SÌ, LE VOGLIO.</a>
</div>

<script>
(function () {
  var sid = '{{ section.id }}';
  var root = document.querySelector('[data-hps-id="' + sid + '"]');
  if (!root) return;

  var allVariants = JSON.parse(document.getElementById('hps-variants-' + sid).textContent);
  var vgMap       = JSON.parse(document.getElementById('hps-vg-' + sid).textContent);

  var slides = Array.from(root.querySelectorAll('.hps__slide'));
  var thumbs = Array.from(root.querySelectorAll('.hps__thumb'));
  var vidInput = document.getElementById('hps-vid-' + sid);

  /* Active options, initialised from first available variant */
  var initV = allVariants.find(function (v) { return v.available; }) || allVariants[0];
  var selOpts = initV ? initV.options.slice() : [];

  var mainEl   = root.querySelector('.hps__main');
  var thumbsEl = root.querySelector('.hps__thumbs');

  /* ── Gallery helpers ─────────────────────────────────────── */
  function showByMediaId(mediaId) {
    slides.forEach(function (s) { s.classList.toggle('hps__slide--active', s.dataset.mediaId === mediaId); });
    thumbs.forEach(function (t) { t.classList.toggle('hps__thumb--active', t.dataset.mediaId === mediaId); });
  }

  function filterGallery(variantId) {
    var ids = vgMap[String(variantId)];

    if (!ids || ids.length === 0) {
      slides.forEach(function (s) { s.style.display = ''; });
      thumbs.forEach(function (t) { t.style.display = ''; });
      slides = Array.from(mainEl.querySelectorAll('.hps__slide'));
      thumbs = Array.from(thumbsEl.querySelectorAll('.hps__thumb'));
      if (slides.length) showByMediaId(slides[0].dataset.mediaId);
      return;
    }

    /* Hide everything first */
    slides.forEach(function (s) { s.style.display = 'none'; });
    thumbs.forEach(function (t) { t.style.display = 'none'; });

    /* Reorder DOM nodes + show, in vgMap order */
    ids.forEach(function (id) {
      var strId = String(id);
      var slide = mainEl.querySelector('.hps__slide[data-media-id="' + strId + '"]');
      var thumb = thumbsEl.querySelector('.hps__thumb[data-media-id="' + strId + '"]');
      if (slide) { slide.style.display = ''; mainEl.appendChild(slide); }
      if (thumb) { thumb.style.display = ''; thumbsEl.appendChild(thumb); }
    });

    /* Refresh arrays after DOM reorder */
    slides = Array.from(mainEl.querySelectorAll('.hps__slide'));
    thumbs = Array.from(thumbsEl.querySelectorAll('.hps__thumb'));

    if (ids.length) showByMediaId(String(ids[0]));
  }

  /* Thumbnail clicks — use mediaId, survives DOM reorder */
  thumbs.forEach(function (btn) {
    btn.addEventListener('click', function () { showByMediaId(btn.dataset.mediaId); });
  });

  /* ── Variant sync ────────────────────────────────────────── */
  function syncVariant() {
    var match = allVariants.find(function (v) {
      return v.options.every(function (o, i) { return o === selOpts[i]; });
    }) || allVariants.find(function (v) { return v.options[0] === selOpts[0]; });
    if (!match) return;
    vidInput.value = match.id;
    filterGallery(match.id);
  }

  /* ── Color swatches ──────────────────────────────────────── */
  var swatches  = root.querySelectorAll('.hps__swatch');
  var cValEl    = document.getElementById('hps-cval-' + sid);

  swatches.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var pos = parseInt(btn.dataset.pos, 10);
      selOpts[pos] = btn.dataset.color;
      swatches.forEach(function (s) { s.classList.remove('hps__swatch--on'); });
      btn.classList.add('hps__swatch--on');
      if (cValEl) cValEl.textContent = btn.dataset.color;
      syncVariant();
    });
  });

  /* ── Size select ─────────────────────────────────────────── */
  var sSel  = document.getElementById('hps-ssel-' + sid);
  var sValEl = document.getElementById('hps-sval-' + sid);

  if (sSel) {
    sSel.addEventListener('change', function () {
      var pos = parseInt(sSel.dataset.pos, 10);
      selOpts[pos] = sSel.value;
      if (sValEl) sValEl.textContent = sSel.value;
      syncVariant();
    });
  }

  /* ── Qty stepper ─────────────────────────────────────────── */
  var qtyEl = document.getElementById('hps-qty-' + sid);
  root.querySelectorAll('.hps__qty-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      qtyEl.value = Math.max(1, (parseInt(qtyEl.value, 10) || 1) + parseInt(btn.dataset.d, 10));
    });
  });

  /* ── Add to cart (AJAX, no redirect) ────────────────────── */
  var form = document.getElementById('hps-form-' + sid);
  if (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var fd = new FormData(form);
      /* Collect section IDs so the theme can re-render cart HTML */
      var cartSectionIds = [];
      document.querySelectorAll('cart-items-component[data-section-id]').forEach(function (el) {
        cartSectionIds.push(el.dataset.sectionId);
      });
      if (cartSectionIds.length) fd.append('sections', cartSectionIds.join(','));
      fetch('/cart/add.js', { method: 'POST', body: fd })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.status) return; /* error */
          /* Fire the event the cart drawer listens for — detail.data.sections is the required path */
          document.dispatchEvent(new CustomEvent('cart:update', {
            bubbles: true,
            detail: { source: 'hps', data: { sections: data.sections } }
          }));
        })
        .catch(function () {});
    });
  }

  /* ── Buy Now ─────────────────────────────────────────────── */
  var bnBtn = document.getElementById('hps-bn-' + sid);
  if (bnBtn) {
    bnBtn.addEventListener('click', function () {
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: parseInt(vidInput.value, 10), quantity: parseInt(qtyEl ? qtyEl.value : '1', 10) || 1 })
      }).then(function () { window.location.href = '/checkout'; })
        .catch(function () { window.location.href = '/checkout'; });
    });
  }

  /* ── Popups ──────────────────────────────────────────────── */
  function openPop(id) {
    var el = document.getElementById(id);
    if (el) { el.hidden = false; document.body.style.overflow = 'hidden'; }
  }
  function closePops() {
    document.querySelectorAll('.hps-pop:not([hidden])').forEach(function (p) { p.hidden = true; });
    document.body.style.overflow = '';
  }

  var techBtn = document.getElementById('hps-tech-' + sid);
  var sizeBtn = document.getElementById('hps-size-' + sid);
  if (techBtn) techBtn.addEventListener('click', function () { openPop('hps-pop-tech-' + sid); });
  if (sizeBtn) sizeBtn.addEventListener('click', function () { openPop('hps-pop-size-' + sid); });

  ['gar', 'ret', 'ship', 'pay'].forEach(function (key) {
    var btn = document.getElementById('hps-usp-' + key + '-' + sid);
    if (btn) btn.addEventListener('click', function () { openPop('hps-pop-usp-' + key + '-' + sid); });
  });

  document.querySelectorAll('[data-pop-close]').forEach(function (el) {
    el.addEventListener('click', closePops);
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closePops(); });

  /* ── Sticky CTA ──────────────────────────────────────────── */
  var ctaBar = document.getElementById('hps-cta-bar-{{ section.id }}');
  var stickyCta = ctaBar ? ctaBar.querySelector('.hps-cta') : null;

  if (ctaBar) {
    var sectionVisible = true;

    function updateCta() {
      var scrolled = window.scrollY > 80;
      if (scrolled && !sectionVisible) {
        ctaBar.classList.add('hps-cta-bar--visible');
      } else {
        ctaBar.classList.remove('hps-cta-bar--visible');
      }
    }

    window.addEventListener('scroll', updateCta, { passive: true });

    new IntersectionObserver(function (entries) {
      sectionVisible = entries[0].isIntersecting;
      updateCta();
    }, { threshold: 0.1 }).observe(root);

    if (stickyCta) {
      stickyCta.addEventListener('click', function (e) {
        e.preventDefault();
        root.scrollIntoView({ behavior: 'smooth' });
      });
    }
  }

  /* Init gallery for default variant */
  if (initV) filterGallery(initV.id);
})();
</script>

{% endif %}

{% stylesheet %}

.hps {
  display: flex;
  flex-direction: column;
  height: 100svh;
  overflow: hidden;
  background: #fff;
}

/* Gallery */
.hps__gallery {
  flex: 0 0 50svh;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.hps__main {
  flex: 1 1 auto;
  min-height: 0;
  overflow: hidden;
  background: #fff;
}

.hps__slide {
  display: none;
  width: 100%;
  height: 100%;
}
.hps__slide--active { display: block; }

.hps__img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

.hps__thumbs {
  flex: 0 0 auto;
  display: flex;
  gap: 6px;
  overflow-x: auto;
  padding: 8px 16px;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}
.hps__thumbs::-webkit-scrollbar { display: none; }

.hps__thumb {
  flex: 0 0 56px;
  height: 56px;
  padding: 0;
  border: 2px solid #e0e0e0;
  border-radius: 4px;
  overflow: hidden;
  background: #fff;
  cursor: pointer;
  transition: border-color 0.15s;
}
.hps__thumb--active { border-color: #111; }

.hps__thumb-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Details */
.hps__details {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 14px 16px 20px;
}

.hps__head { display: flex; flex-direction: column; gap: 2px; }

.hps__title {
  font-size: 1.05rem;
  font-weight: 700;
  margin: 0;
  line-height: 1.3;
  color: #111;
}

.hps__sub {
  font-size: 0.8rem;
  color: #888;
  margin: 0;
}

.hps__price {
  margin: 0;
  display: flex;
  align-items: baseline;
  gap: 8px;
}
.hps__price-main {
  font-size: 1.65rem;
  font-weight: 700;
  color: #111;
  line-height: 1;
}
.hps__price-tax {
  font-size: 0.68rem;
  color: #888;
  text-transform: uppercase;
  letter-spacing: 0.07em;
}

.hps__form { display: flex; flex-direction: column; gap: 10px; }

.hps__opt { display: flex; flex-direction: column; gap: 6px; }

.hps__opt-lbl {
  font-size: 0.82rem;
  font-weight: 500;
  color: #111;
  margin: 0;
}

.hps__swatches { display: flex; gap: 10px; }

.hps__swatch {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 2px solid transparent;
  padding: 0;
  cursor: pointer;
  outline: 2px solid transparent;
  outline-offset: 2px;
  transition: outline-color 0.15s;
}
.hps__swatch--on { outline-color: #111; }

.hps__size-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  flex-wrap: nowrap;
}

.hps__info-btns { display: flex; gap: 6px; flex-shrink: 0; }

.hps__info-btn {
  font-size: 0.68rem;
  padding: 5px 8px;
  border-radius: 4px;
  border: 1px solid #ccc;
  background: #f2f2f2;
  color: #333;
  cursor: pointer;
  white-space: nowrap;
  font-family: inherit;
  line-height: 1.3;
}
.hps__info-btn:active { background: #e0e0e0; }

.hps__select {
  width: 100%;
  padding: 9px 12px;
  font-size: 0.9rem;
  border: 1px solid #ccc;
  border-radius: 4px;
  background: #fff;
  cursor: pointer;
  font-family: inherit;
  color: #111;
  appearance: auto;
}

.hps__buy-row {
  display: flex;
  align-items: stretch;
  gap: 8px;
}

.hps__qty {
  display: flex;
  align-items: center;
  border: 1px solid #ccc;
  border-radius: 4px;
  overflow: hidden;
  flex-shrink: 0;
}

.hps__qty-btn {
  width: 34px;
  min-height: 42px;
  background: none;
  border: none;
  font-size: 1.1rem;
  cursor: pointer;
  padding: 0;
  font-family: inherit;
  color: #111;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hps__qty-btn:active { background: #f0f0f0; }

.hps__qty-n {
  width: 38px;
  text-align: center;
  border: none;
  border-left: 1px solid #ccc;
  border-right: 1px solid #ccc;
  font-size: 0.9rem;
  padding: 0;
  height: 42px;
  -moz-appearance: textfield;
  font-family: inherit;
  color: #111;
}
.hps__qty-n::-webkit-inner-spin-button,
.hps__qty-n::-webkit-outer-spin-button { -webkit-appearance: none; }

.hps__atc {
  flex: 1;
  height: 42px;
  padding: 0 10px;
  background: #4caf50;
  color: #fff;
  border: none;
  border-radius: 4px;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  cursor: pointer;
  text-transform: uppercase;
  font-family: inherit;
  line-height: 1.2;
}
.hps__atc:active { background: #43a047; }

.hps__bn {
  width: 100%;
  height: 42px;
  background: #f5c518;
  color: #111;
  border: none;
  border-radius: 4px;
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  cursor: pointer;
  text-transform: uppercase;
  font-family: inherit;
}
.hps__bn:active { background: #e6b800; }

/* USP strip */
.hps__usp {
  display: flex;
  background: #111;
  border-radius: 10px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.06);
}
.hps__usp-item {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  padding: 12px 4px 10px;
  background: none;
  border: none;
  border-right: 1px solid rgba(255,255,255,0.08);
  cursor: pointer;
  font-family: inherit;
  text-align: center;
  transition: background 0.15s;
}
.hps__usp-item:last-child { border-right: none; }
.hps__usp-item:active { background: rgba(255,255,255,0.07); }
.hps__usp-item::after {
  content: '›';
  position: absolute;
  top: 5px;
  right: 7px;
  font-size: 0.7rem;
  font-weight: 700;
  color: #FB6E06;
  line-height: 1;
}
.hps__usp-icon {
  display: block;
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  color: #FB6E06;
  margin-bottom: 1px;
}
.hps__usp-main {
  font-size: 0.62rem;
  font-weight: 800;
  color: #fff;
  line-height: 1.2;
  text-transform: uppercase;
  letter-spacing: 0.02em;
}
.hps__usp-sub {
  font-size: 0.5rem;
  font-weight: 400;
  color: rgba(255,255,255,0.45);
  line-height: 1.2;
}

/* Popups */
.hps-pop {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.hps-pop[hidden] { display: none; }

.hps-pop__bg {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.45);
  cursor: pointer;
}

.hps-pop__box {
  position: relative;
  background: #fff;
  border-radius: 14px 14px 0 0;
  width: 100%;
  max-height: 74svh;
  overflow-y: auto;
  padding: 22px 20px 36px;
}

.hps-pop__x {
  position: absolute;
  top: 14px;
  right: 16px;
  background: none;
  border: none;
  font-size: 1.5rem;
  cursor: pointer;
  color: #555;
  padding: 0 4px;
  line-height: 1;
  font-family: inherit;
}

.hps-pop__title {
  font-size: 1rem;
  font-weight: 700;
  margin: 0 0 16px;
  padding-right: 28px;
  color: #111;
}

.hps-pop__body p { font-size: 0.85rem; margin: 0 0 12px; color: #444; }

.hps-doc-section { display: flex; flex-direction: column; gap: 6px; margin-bottom: 20px; }
.hps-doc-section:last-child { margin-bottom: 0; }

.hps-doc-section__label {
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #999;
  margin: 0 0 2px;
}

.hps-doc-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  background: #f7f7f7;
  border-radius: 8px;
  text-decoration: none;
  color: #111;
  transition: background 0.15s;
}
.hps-doc-row:hover { background: #eee; color: #111; text-decoration: none; }

.hps-doc-row__icon {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #111;
  color: #fff;
  border-radius: 50%;
  font-size: 0.85rem;
  flex-shrink: 0;
}

.hps-doc-row__name {
  flex: 1;
  font-size: 0.875rem;
  font-weight: 500;
}

.hps-doc-row__type {
  font-size: 0.68rem;
  font-weight: 700;
  color: #999;
  letter-spacing: 0.05em;
}

.hps-stbl { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
.hps-stbl th, .hps-stbl td { border-bottom: 1px solid #eee; padding: 8px 6px; text-align: left; }
.hps-stbl th { font-weight: 700; color: #111; padding-top: 2px; }

/* Desktop */
@media screen and (min-width: 750px) {
  .hps {
    flex-direction: row;
    height: auto;
    overflow: visible;
    padding: 40px max(24px, calc((100% - 1200px) / 2));
    gap: 48px;
    align-items: flex-start;
  }
  .hps__gallery {
    flex: 1 1 auto;
    flex-direction: row;
    height: auto;
    position: sticky;
    top: var(--sticky-header-offset, 0px);
    align-self: flex-start;
  }
  .hps__main {
    flex: 1 1 auto;
    height: 520px;
  }
  .hps__thumbs {
    flex-direction: column;
    overflow-x: visible;
    overflow-y: auto;
    max-height: 520px;
    padding: 0 0 0 8px;
  }
  .hps__details {
    flex: 0 0 380px;
    overflow-y: visible;
    padding: 0;
    gap: 14px;
    min-height: unset;
  }
  .hps__title { font-size: 1.2rem; }
  .hps__price-main { font-size: 2rem; }
  .hps-pop { align-items: center; }
  .hps-pop__box { border-radius: 12px; width: 480px; max-height: 80vh; }
}

.hps-cta-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 9000;
  display: flex;
  align-items: stretch;
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px));
  background: #111;
  opacity: 0;
  transform: translateY(100%);
  pointer-events: none;
  transition: opacity 0.25s, transform 0.25s;
}
.hps-cta-bar--visible {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.hps-cta-bar .hps-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 50px;
  background: #FB6E06;
  color: #fff !important;
  font-size: 1rem;
  font-weight: 900 !important;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  text-decoration: none;
  font-family: inherit;
  border-radius: 0;
  border: none;
  transition: background 0.15s;
}
.hps-cta-bar .hps-cta:hover { background: #e06005; color: #fff !important; text-decoration: none; }
.hps-cta-bar .hps-cta:active { background: #c95504; }

{% endstylesheet %}

