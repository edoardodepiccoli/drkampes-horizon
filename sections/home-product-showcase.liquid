  "name": "Home Product Showcase",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Prodotto"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [{ "name": "Home Product Showcase" }]
}
{% endschema %}
