{%- assign img = section.settings.image -%}

<section class="lp-problem">
  <div class="lp-problem__inner">

    <div class="lp-problem__text-col">
      {%- if section.settings.eyebrow != blank -%}
        <div class="lp-sec__eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}

      <h2 class="lp-sec__h2">{{ section.settings.heading }}</h2>

      {%- if section.settings.copy_1 != blank -%}
        <div class="lp-problem__copy">{{ section.settings.copy_1 }}</div>
      {%- endif -%}

      {%- if section.settings.copy_2 != blank -%}
        <div class="lp-problem__copy">{{ section.settings.copy_2 }}</div>
      {%- endif -%}

      {%- if section.settings.copy_3 != blank -%}
        <div class="lp-problem__copy">{{ section.settings.copy_3 }}</div>
      {%- endif -%}

      {%- if section.settings.lead != blank -%}
        <p class="lp-problem__lead">{{ section.settings.lead }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="lp-pains">
          {%- for block in section.blocks -%}
            <div class="lp-pain" {{ block.shopify_attributes }}>
              <div class="lp-pain__title">{{ block.settings.title }}</div>
              <div class="lp-pain__text">{{ block.settings.text }}</div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- if img != blank -%}
      <div class="lp-problem__img-col">
        {{ img | image_url: width: 800 | image_tag: class: 'lp-problem__img', loading: 'lazy', widths: '400,600,800', sizes: '(min-width:750px) 45vw, 90vw', alt: img.alt }}
      </div>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}

.lp-problem {
  padding: 56px 22px;
  background: #fff;
}

.lp-problem__inner {
  display: flex;
  flex-direction: column;
  gap: 32px;
}

.lp-sec__eyebrow {
  font-size: 0.67rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #2e7d32;
  margin-bottom: 10px;
}

.lp-sec__h2 {
  font-family: var(--font-heading--family, inherit);
  font-size: 1.5rem;
  font-weight: 900;
  line-height: 1.2;
  color: #111;
  margin: 0 0 18px;
}

.lp-problem__copy {
  font-size: 0.97rem;
  color: #444;
  line-height: 1.85;
  margin-bottom: 14px;
}

.lp-problem__copy p { margin: 0 0 14px; }
.lp-problem__copy p:last-child { margin-bottom: 0; }
.lp-problem__copy strong { color: #111; }

.lp-problem__lead {
  font-size: 1.05rem;
  font-weight: 700;
  color: #111;
  margin: 0 0 24px;
  line-height: 1.6;
}

.lp-pains {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.lp-pain {
  background: #fff5f5;
  border-left: 4px solid #b71c1c;
  border-radius: 0;
  padding: 13px 15px;
}

.lp-pain__title {
  font-size: 0.82rem;
  font-weight: 800;
  color: #b71c1c;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin-bottom: 3px;
}

.lp-pain__text {
  font-size: 0.82rem;
  color: #555;
  line-height: 1.5;
}

.lp-problem__img-col {
  border-radius: 0;
  overflow: hidden;
}

.lp-problem__img {
  width: 100%;
  height: auto;
  display: block;
  aspect-ratio: 4/5;
  object-fit: cover;
}

@media (min-width: 750px) {
  .lp-problem {
    padding: 80px 60px;
  }

  .lp-problem__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }

  .lp-problem__img {
    aspect-ratio: 4/5;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "LP — Problema",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "La verità che nessuno ti dice"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo sezione",
      "default": "So esattamente come funziona la tua giornata."
    },
    {
      "type": "richtext",
      "id": "copy_1",
      "label": "Paragrafo 1",
      "default": "<p>Sveglia nel cuore della notte, un caffè amaro mandato giù in fretta, e via sul camion. Poi inizia la partita: guidi per ore, scendi, agganci il rimorchio, sganci, controlli il carico sotto l'acqua o sotto il sole cocente e poi saldi di nuovo.</p>"
    },
    {
      "type": "richtext",
      "id": "copy_2",
      "label": "Paragrafo 2",
      "default": "<p>E ogni singola volta che metti il piede a terra, ti ritrovi con i piedi incastrati in blocchi di cemento che il tuo capo ha il coraggio di chiamare \"scarpe antinfortunistiche\".</p>"
    },
    {
      "type": "richtext",
      "id": "copy_3",
      "label": "Paragrafo 3",
      "default": "<p>Ti hanno abituato a credere che è un <strong>\"male necessario\"</strong>.</p>"
    },
    {
      "type": "text",
      "id": "lead",
      "label": "Testo lead (grassetto, prima dei pain points)",
      "default": "Ma se il tuo capo e l'intera industria delle scarpe ti stessero prendendo in giro? Pensaci."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Immagine (colonna destra)"
    }
  ],
  "blocks": [
    {
      "type": "pain",
      "name": "Pain point",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titolo"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Testo"
        }
      ]
    }
  ],
  "presets": [{ "name": "LP — Problema" }]
}
{% endschema %}
